                        <td>98.8%</td>\n                        </tr>\n                        <tr>\n                            <td>設定3</td>\n                            <td>100.9%</td>\n                        </tr>\n                        <tr>\n                            <td>設定4</td>\n                            <td>104.9%</td>\n                        </tr>\n                        <tr>\n                            <td>設定5</td>\n                            <td>109.2%</td>\n                        </tr>\n                        <tr>\n                            <td>設定6</td>\n                            <td>114.9%</td>\n                        </tr>\n                    </tbody>\n                </table>\n            </div>\n\n            <button class=\"close\">ー閉じる</button>\n        </div>\n\n        <p class=\"js-menu\">基本情報</p>\n        <div class=\"contents\">\n            <div class=\"left\">\n                <h3>天井・打ち方・詳細情報</h3>\n                <table border=\"1\">\n                    <tbody>\n                        <tr>\n                            <th style=\"width: 50%;\">項目</th>\n                            <th>記載</th>\n                        </tr><tr>\n                            <td><img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2022/12/下向きの矢印のアイコン素材.png\" class=\"icon-small\" alt=\"arrow\" loading=\"lazy\">天井情報\n                            </td>\n                            <td>ボーナス間天井<br>ボーナススルー回数天井</td>\n                        </tr>\n                        <tr>\n                            <td><img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2022/12/下向きの矢印のアイコン素材.png\" class=\"icon-small\" alt=\"arrow\" loading=\"lazy\">打ち方\n                            </td>\n                            <td>通常時の打ち方<br>ボーナス・AT中<br>の打ち方</td>\n                        </tr>\n                        <tr>\n                            <td><img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/upload