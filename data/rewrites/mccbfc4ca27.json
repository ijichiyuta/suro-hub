aru__56.jpg\" loading=\"lazy\">\n                            <p>黄</p></td>\n                        </tr>\n                        <tr>\n                            <td><img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2024/05/aoharu__57.jpg\" loading=\"lazy\">\n                            <p>赤</p></td>\n                            <td>設定2以上濃厚</td>\n                        </tr>\n                        <tr>\n                            <td><img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2024/05/aoharu__58.jpg\" loading=\"lazy\">\n                            <p>銀</p></td>\n                            <td style=\"color:#0071C1;\">設定4以上濃厚</td>\n                        </tr>\n                        <tr>\n                            <td><img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2024/05/aoharu__59.jpg\" loading=\"lazy\">\n                            <p>金</p></td>\n                            <td style=\"color:#FE0101;\">設定5以上濃厚</td>\n                        </tr>\n                        <tr>\n                            <td><img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2024/05/aoharu__60.jpg\" loading=\"lazy\">\n                            <p>虹</p></td>\n                            <td style=\"color:#FE67FF;\">設定6濃厚</td>\n                        </tr>\n                    </tbody>\n                </table>\n                <h4>楽曲紹介の組み合わせ</h4>\n                <table border=\"1\">\n                    <tbody>\n                        <tr>\n                            <th style=\"width: 25%;\">1曲目</th>\n                            <th style=\"width: 25%;\">2曲目</th>\n                            <th style=\"width: 50%;\">示唆内容</th>\n                        </tr>\n                        <tr>\n                            <td style=\" background-color:#87cefa;\">青</td>\n                            <td style=\" background-color:#87cefa;\">青</td>\n                  