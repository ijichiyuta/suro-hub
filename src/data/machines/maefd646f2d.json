/th>\n                        </tr>\n                        <tr>\n                            <td>設定1</td>\n                            <td>ー</td>\n                            <td rowspan=\"2\">ー</td>\n                            <td rowspan=\"3\">ー</td>\n                            <td rowspan=\"4\">ー</td>\n                            <td rowspan=\"5\">ー</td>\n                        </tr>\n                        <tr>\n                            <td>設定2</td>\n                            <td>9.00％</td>\n                        </tr>\n                        <tr>\n                            <td>設定3</td>\n                            <td rowspan=\"4\">6.00％</td>\n                            <td>9.00％</td>\n                        </tr>\n                        <tr>\n                            <td>設定4</td>\n                            <td rowspan=\"3\">5.00％</td>\n                            <td>15.00％</td>\n                        </tr>\n                        <tr>\n                            <td>設定5</td>\n                            <td rowspan=\"2\">8.00％</td>\n                            <td>15.00％</td>\n                        </tr>\n                        <tr>\n                            <td>設定6</td>\n                            <td>8.00％</td>\n                            <td>15.00％</td>\n                        </tr>\n                    </tbody>\n                </table>\n                <table border=\"1\">\n                    <caption>8001G～消化時のトロフィー出現期待度</caption>\n                    <tbody>\n                        <tr>\n                            <th>設定</th>\n                            <th>銅</th>\n                            <th>銀</th>\n                            <th>金</th>\n                            <th>キリン</th>\n                            <th>虹</th>\n                        </tr>\n                        <tr>\n                            <td>設定1</td>\n                            <td>ー</td>\n                            <td rowspan=\"2\">ー</td>\n                            <td rowspan=\"3\">ー</td>\n                            <td rowspan=\"4\">ー</td>\n                            <td rowspan=\"5\">ー</td>\n                        </tr>\n                        <tr>\n                            <td>設定2</td>\n                            <td rowspan=\"5\">2.70％</td>\n                        </tr>\n                        <tr>\n                            <td>設定3</td>\n                            <td rowspan=\"4\">0.90％</td>\n                        </tr>\n                        <tr>\n                            <td>設定4</td>\n                            <td rowspan=\"3\">0.90％</td>\n                        </tr>\n                        <tr>\n                            <td>設定5</td>\n                            <td rowspan=\"2\">0.90％</td>\n                        </tr>\n                        <tr>\n                            <td>設定6</td>\n                            <td>0.90％</td>\n                        </tr>\n                    </tbody>\n                </table>\n            </div>\n\n            <div class=\"left\">\n                <h3 id=\"destination4\">モードD移行率</h3>\n                <p>通常時のモード移行率には設定差が存在しており、特にモードDの移行率は高設定ほど優遇されている模様。</p>\n                <p>モードD滞在が濃厚となる挙動は以下の通りです。</p>\n                <p>詳しくはこちら。\n                </p>\n                <table border=\"1\">\n                    <tbody>\n                        <tr>\n                            <th>No.</th>\n                            <th>モードD判別パターン</th>\n                        </tr>\n                        <tr>\n                            <td style=\"width: 10%;\">1</td>\n                            <td>150G付近から前兆が発生し<br>ガセアリアスモード突入<br>その後200G付近から前兆が発生し<br>アリアスモード経由でATに当選</td>\n                        </tr>\n                        <tr>\n                            <td>2</td>\n                            <td>200G付近から前兆が発生し<br>ガセアリアスモード突入<br>その後300G付近から前兆が発生し<br>アリアスモード経由でATに当選</td>\n                        </tr>\n                    </tbody>\n                </table>\n                <table border=\"1\">\n                    <tbody>\n                        <tr>\n                            <th>設定</th>\n                            <th>モードD移行率(※)</th>\n                        </tr>\n                        <tr>\n                            <td>設定1</td>\n                            <td>1/98387</td>\n                        </tr>\n                        <tr>\n                            <td>設定2</td>\n                            <td>1/67348</td>\n                        </tr>\n                        <tr>\n                            <td>設定3</td>\n                            <td>1/43580</td>\n                        </tr>\n                        <tr>\n                            <td>設定4</td>\n                            <td>1/11694</td>\n                        </tr>\n                        <tr>\n                            <td>設定5</td>\n                            <td>1/9867</td>\n                        </tr>\n                        <tr>\n                            <td>設定6</td>\n                            <td>1/8310</td>\n                        </tr>\n                    </tbody>\n                </table>\n                <figcaption class=\"left\">(※)小役から当選など、モードDなのかを判別できなかったゲーム数は除外してカウント</figcaption>\n            </div>\n\n            <div class=\"left\">\n                <h3 id=\"destination5\">サイレントモード移行率、突破率</h3>\n                <p>サイレントモードの移行率(ガゼ・本前兆問わず)に設定差が存在しており、高設定ほど優遇されています。</p>\n                <p>また、高確滞在時の弱チェリーやスイカからのサイレントモード移行率は特に設定差が大きいので、複数回確認できれば高設定に期待できます。</p>\n                <p>設定1.2と設定3以上でAT当選率に差があります。</p>\n                <table border=\"1\">\n                    <tbody>\n                        <tr>\n                            <th>設定</th>\n                            <th style=\"width: 33.3%;\">移行率</th>\n                            <th style=\"width: 33.3%;\">AT期待度</th>\n                        </tr>\n                        <tr>\n                            <td>設定1</td>\n                            <td>1/349.5</td>\n                            <td>28.2%</td>\n                        </tr>\n                        <tr>\n                            <td>設定2</td>\n                            <td>1/317.3</td>\n                            <td>28.5%</td>\n                        </tr>\n                        <tr>\n                            <td>設定3</td>\n                            <td>1/296.7</td>\n                            <td>37.0%</td>\n                        </tr>\n                        <tr>\n                            <td>設定4</td>\n                            <td>1/249.1</td>\n                            <td>39.2%</td>\n                        </tr>\n                        <tr>\n                            <td>設定5</td>\n                            <td>1/239.4</td>\n                            <td>39.5%</td>\n                        </tr>\n                        <tr>\n                            <td>設定6</td>\n                            <td>1/226.7</td>\n                            <td>39.7%</td>\n                        </tr>\n                    </tbody>\n                </table>\n\n                <h4>成立役別のサイレントモード移行率</h4>\n                <table border=\"1\">\n                    <caption>通常滞在時</caption>\n                    <tbody>\n                        <tr>\n                            <th>設定</th>\n                            <th style=\"width: 33.3%;\">スイカ</th>\n                            <th style=\"width: 33.3%;\">弱チェリー</th>\n                        </tr>\n                        <tr>\n                            <td>設定1</td>\n                            <td>0.2%</td>\n                            <td>0.2%</td>\n                        </tr>\n                        <tr>\n                            <td>設定2</td>\n                            <td rowspan=\"2\">0.4%</td>\n                            <td rowspan=\"2\">0.4%</td>\n                        </tr>\n                        <tr>\n                            <td>設定3</td>\n                        </tr>\n                        <tr>\n                            <td>設定4</td>\n                            <td rowspan=\"2\">1.2%</td>\n                            <td rowspan=\"2\">1.2%</td>\n                        </tr>\n                        <tr>\n                            <td>設定5</td>\n                        </tr>\n                        <tr>\n                            <td>設定6</td>\n                            <td>1.6%</td>\n                            <td>1.6%</td>\n                        </tr>\n                    </tbody>\n                </table>\n\n                <table border=\"1\">\n                    <caption>高確滞在時</caption>\n                    <tbody>\n                        <tr>\n                            <th>設定</th>\n                            <th style=\"width: 33.3%;\">スイカ</th>\n                            <th style=\"width: 33.3%;\">弱チェリー</th>\n                        </tr>\n                        <tr>\n                            <td>設定1</td>\n                            <td>2.7%</td>\n                            <td>10.2%</td>\n                        </tr>\n                        <tr>\n                            <td>設定2</td>\n                            <td>3.1%</td>\n                            <td>10.5%</td>\n                        </tr>\n                        <tr>\n                            <td>設定3</td>\n                            <td>3.5%</td>\n                            <td>15.2%</td>\n                        </tr>\n                        <tr>\n                            <td>設定4</td>\n                            <td>6.3%</td>\n                            <td>19.5%</td>\n                        </tr>\n                        <tr>\n                            <td>設定5</td>\n                            <td>8.2%</td>\n                            <td>19.9%</td>\n                        </tr>\n                        <tr>\n                            <td>設定6</td>\n                            <td>10.2%</td>\n                            <td>20.3%</td>\n                        </tr>\n                    </tbody>\n                </table>\n            </div>\n\n            <div class=\"left\">\n                <h3 id=\"destination6\">小役確率</h3>\n                <p>弱チェリーとスイカの出現率に設定差があります。</p>\n                <table border=\"1\">\n                    <tbody>\n                        <tr>\n                            <th>設定</th>\n                            <th style=\"width: 26.6%;\">弱チェリー</th>\n                            <th style=\"width: 26.6%;\">スイカ</th>\n                            <th style=\"width: 26.6%;\">合算</th>\n                        </tr>\n                        <tr>\n                            <td>設定1</td>\n                            <td>1/99.9</td>\n                            <td>1/99.9</td>\n                            <td>1/49.9</td>\n                        </tr>\n                        <tr>\n                            <td>設定2</td>\n                            <td>1/98.4</td>\n                            <td>1/98.4</td>\n                            <td>1/49.2</td>\n                        </tr>\n                        <tr>\n                            <td>設定3</td>\n                            <td>1/96.9</td>\n                            <td>1/96.9</td>\n                            <td>1/48.5</td>\n                        </tr>\n                        <tr>\n                            <td>設定4</td>\n                            <td>1/94.2</td>\n                            <td>1/94.2</td>\n                            <td>1/47.1</td>\n                        </tr>\n                        <tr>\n                            <td>設定5</td>\n                            <td>1/91.5</td>\n                            <td>1/91.5</td>\n                            <td>1/45.8</td>\n                        </tr>\n                        <tr>\n                            <td>設定6</td>\n                            <td>1/89.0</td>\n                            <td>1/89.0</td>\n                            <td>1/44.5</td>\n                        </tr>\n                    </tbody>\n                </table>\n            </div>\n\n            <div class=\"left\">\n                <h3 id=\"destination7\">レア役成立時の高確移行率</h3>\n                <p>弱チェリー、スイカからの高確移行率に低設定と高設定で設定差があります。</p>\n                <table border=\"1\">\n                    <tbody>\n                        <tr>\n                            <th>設定</th>\n                            <th style=\"width: 33.3%;\">弱チェリー</th>\n                            <th style=\"width: 33.3%;\">スイカ</th>\n                        </tr>\n                        <tr>\n                            <td>設定1</td>\n                            <td rowspan=\"3\">25%</td>\n                            <td rowspan=\"3\">50%</td>\n                        </tr>\n                        <tr>\n                            <td>設定2</td>\n                        </tr>\n                        <tr>\n                            <td>設定3</td>\n                        </tr>\n                        <tr>\n                            <td>設定4</td>\n                            <td rowspan=\"3\">33.3%</td>\n                            <td rowspan=\"3\">66.7%</td>\n                        </tr>\n                        <tr>\n                            <td>設定5</td>\n                        </tr>\n                        <tr>\n                            <td>設定6</td>\n                        </tr>\n                    </tbody>\n                </table>\n\n\n            </div>\n\n            <div class=\"left\">\n                <h3 id=\"destination8\">超天国時のPVM当選率</h3>\n                <p>超天国時のプレミアムヴェンデッタモード(PVM)当選率は、設定1でも50%オーバー。</p>\n                <p>なお、高設定ほど突入率が高い模様。</p>\n            </div>\n            <button class=\"close\">ー閉じる</button>\n        </div>\n\n        <p class=\"js-menu\" style=\"display: none;\">高設定狙いに必要な演出法則</p>\n        <div class=\"contents\" style=\"display: none;\">\n            <div class=\"left\">\n                <img decoding=\"async\" src=\"https://media.slolaboratory.com/wp-content/uploads/2026/04/24005602/noimage1.jpg\" loading=\"lazy\">\n            </div>\n            <button class=\"close\">ー閉じる</button>\n        </div>\n    </div>\n</div>","shukeiHtml":"","columns":[{"id":38219,"title":"スマスロ バイオハザード:ヴェンデッタ 基本情報","date":"2023-11-28","cats":[54,57]},{"id":19043,"title":"スマスロ バイオハザード:ヴェンデッタ ハイエナ：詳細情報","date":"2023-07-19","cats":[56,54,142]}]},"ev":null}