                <td>\n                            -\n                        </td>\n                    </tr>\n                    <tr>\n                        <td>\n                            2\n                        </td>\n                        <td>\n                            -\n                        </td>\n                        <td>\n                            -\n                        </td>\n                        <td>\n                            -\n                        </td>\n                    </tr>\n                    <tr>\n                        <td>\n                            4\n                        </td>\n                        <td>\n                            1.05%\n                        </td>\n                        <td>\n                            -\n                        </td>\n                        <td>\n                            -\n                        </td>\n                    </tr>\n                    <tr>\n                        <td>\n                            5\n                        </td>\n                        <td>\n                            1.15%\n                        </td>\n                        <td>\n                            1.05%\n                        </td>\n                        <td>\n                            -\n                        </td>\n                    </tr>\n                    <tr>\n                        <td>\n                            6\n                        </td>\n                        <td>\n                            1.05%\n                        </td>\n                        <td>\n                            1.25%\n                        </td>\n                        <td>\n                            1.24%\n                        </td>\n                    </tr>\n                </tbody>\n            </table>\n        </div>\n        <div class=\"left\">\n            <h3 id=\"destination3\">サザンカスロット</h3>\n            <img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2023/04/shinonimusha2__13-2.png\" loading=\"lazy\">\n            <table border=\"1\">\n                <tbody>\n                    <tr>\n                        <th style=\"width: 50%;\">パターン</th>\n                        <th>示唆内容</th>\n                    </tr>\n                    <tr>\n                        <td>246</td>\n                        <td>偶数設定濃厚</td>\n                    </tr>\n                    <tr>\n                        <td>222</td>\n                        <td>設定2以上濃厚</td>\n                    </tr>\n                    <tr>\n                        <td>444</td>\n                        <td style=\"color:#0071C1;\">設定4以上濃厚</td>\n                    </tr>\n                    <tr>\n                        <td>456</td>\n                        <td style=\"color:#0071C1;\">設定4以上濃厚</td>\n                    </tr>\n                    <tr>\n                        <td>555</td>\n                        <td style=\"color:#FE0101;\">設定5以上濃厚</td>\n                    </tr>\n                    <tr>\n                        <td>111</td>\n                        <td style=\"color:#FE67FF;\">設定6濃厚</td>\n                    </tr>\n                    <tr>\n                        <td>666</td>\n                        <td style=\"color:#FE67FF;\">設定6濃厚</td>\n                    </tr>\n                </tbody>\n            </table>\n            <p>メニュー画面のサザンカスロットは99G消化毎に回す事が可能で、出現する数字の組み合わせで設定を示唆。</p>\n            <p>AT中でも有効なのでこまめに回した方が良いです。</p>\n            <h4>サザンカスロット出現率</h4>\n            <table border=\"1\">\n                <tbody>\n                    <tr>\n                        <th>設定</th>\n                        <th>その他</th>\n                        <th>246</th>\n                        <th>222</th>\n                        <th>444</th>\n                    </tr>\n                    <tr>\n                        <td>設定1</td>\n                        <td>100%</td>\n                        <td>−</td>\n                        <td>−</td>\n                        <td>−</td>\n                    </tr>\n                    <tr>\n                        <td>設定2</td>\n                        <td>99.35%</td>\n                        <td>0.25%</td>\n                        <td>0.64%</td>\n                        <td>−</td>\n                    </tr>\n                    <tr>\n                        <td>設定4</td>\n                        <td>98.95%</td>\n                        <td>0.25%</td>\n                        <td>0.64%</td>\n                        <td>0.25%</td>\n                    </tr>\n                    <tr>\n                        <td>設定5</td>\n                        <td>98.70%</td>\n                        <td>−</td>\n                        <td>0.64%</td>\n                        <td>0.25%</td>\n                    </tr>\n                    <tr>\n                        <td>設定6</td>\n                        <td>98.45%</td>\n                        <td>0.25%</td>\n                        <td>0.64%</td>\n                        <td>0.25%</td>\n                    </tr>\n                    <tr>\n                        <th>設定</th>\n                        <th>456</th>\n                        <th>555</th>\n                        <th>111</th>\n                        <th>666</th>\n                    </tr>\n                    <tr>\n                        <td>設定1</td>\n                        <td>−</td>\n                        <td>−</td>\n                        <td>−</td>\n                        <td>−</td>\n                    </tr>\n                    <tr>\n                        <td>設定2</td>\n                        <td>−</td>\n                        <td>−</td>\n                        <td>−</td>\n                        <td>−</td>\n                    </tr>\n                    <tr>\n                        <td>設定4</td>\n                        <td>0.17%</td>\n                        <td>−</td>\n                        <td>−</td>\n                        <td>−</td>\n                    </tr>\n                    <tr>\n                        <td>設定5</td>\n                        <td>0.17%</td>\n                        <td>0.25%</td>\n                        <td>−</td>\n                        <td>−</td>\n                    </tr>\n                    <tr>\n                        <td>設定6</td>\n                        <td>0.17%</td>\n                        <td>0.25%</td>\n                        <td>0.13%</td>\n                        <td>0.13%</td>\n                    </tr>\n                </tbody>\n            </table>\n        </div>\n        <div class=\"left\">\n            <h3 id=\"destination4\">テーブル選択率</h3>\n            <p>数値等は判明していないですが高設定ほど上位テーブルが選択されやすい模様。</p>\n            <p>テーブルは100G毎のCZ・AT抽選に影響。</p>\n            <p>上位テーブルは上位CZ「アポロニアスモード」の割合が高いので、早いG数での当選や上位CZの割合等に注目。</p>\n            <p>詳細はこちら</p>\n        </div>\n        <div class=\"left\">\n            <h3 id=\"destination5\">CZの継続ゲーム数</h3>\n            <table border=\"1\">\n                <tbody>\n                    <tr>\n                        <th>設定</th>\n                        <th>10G</th>\n                        <th>20G</th>\n                        <th>30G</th>\n                    </tr>\n                    <tr>\n                        <td>設定1</td>\n                        <td>98%</td>\n                        <td>1%</td>\n                        <td>1%</td>\n                    </tr>\n                    <tr>\n                        <td>設定2</td>\n                        <td>96%</td>\n                        <td>3%</td>\n                        <td>1%</td>\n                    </tr>\n                    <tr>\n                        <td>設定4</td>\n                        <td>93%</td>\n                        <td>5%</td>\n                        <td>2%</td>\n                    </tr>\n                    <tr>\n                        <td>設定5</td>\n                        <td>91%</td>\n                        <td>6%</td>\n                        <td>3%</td>\n                    </tr>\n                    <tr>\n                        <td>設定6</td>\n                        <td>90%</td>\n                        <td>6%</td>\n                        <td>4%</td>\n                    </tr>\n                </tbody>\n            </table>\n            <p>CZの継続G数は高設定ほど20G以上が選択されやすいです。30Gは∞表記となり選択された時点でAT確定。</p>\n        </div>\n        <div class=\"left\">\n            <h3 id=\"destination6\">2択の赤7狙い</h3>\n            <img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2023/04/s_aguarionakanana.jpg\" loading=\"lazy\">\n            <p>通常時 or CZ中に発生する可能性があります。高設定ほど発生しやすく、成功時はAT直撃。</p>\n        </div>\n        <div class=\"left\">\n            <h3 id=\"destination7\">ロングフリーズ</h3>\n            <img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2023/04/long.jpg\" loading=\"lazy\">\n            <table border=\"1\">\n                <tbody>\n                    <tr>\n                        <th>出現率</th>\n                        <td>不明(設定差あり)</td>\n                    </tr>\n                    <tr>\n                        <th>契機</th>\n                        <td>通常時のみ<br> 発生抽選アリ</td>\n                    </tr>\n                    <tr>\n                        <th>恩恵</th>\n                        <td>AT＋10セット</td>\n                    </tr>\n                    <tr>\n                        <th>期待枚数</th>\n                        <td>–</td>\n                    </tr>\n                </tbody>\n            </table>\n        </div>\n        <button class=\"close\">ー閉じる</button>\n    </div>\n    <p class=\"js-menu\">設定判別に必要な要素</p>\n    <div class=\"contents\">\n        <div class=\"left\">\n            <div>\n                <h3 id=\"destination10\">通常時のモードについて</h3>\n                <p>6種類のモードが存在、100G毎のCZ・AT抽選に影響しています。</p>\n                <p>400Gは全モードでチャンスになっており、基本的に上位モードほど抽選が優遇されています。</p>\n\n                <h4>モード別のCZ期待度</h4>\n                <table border=\"1\">\n                    <tbody>\n                        <tr>\n                            <th>ゲーム数</th>\n                            <th>A</th>\n                            <th>B</th>\n                            <th>C</th>\n                            <th>D</th>\n                            <th>E</th>\n                            <th>天国</th>\n                        </tr>\n                        <tr>\n                            <td>100G</td>\n                            <td class=\"bg-yellow\">◯</td>\n                            <td class=\"bg-yellow\">◯</td>\n                            <td class=\"bg-yellow\">◯</td>\n                            <td class=\"bg-yellow\">◯</td>\n                            <td class=\"bg-yellow\">◯</td>\n                            <td class=\"bg-purple\">確定<br>CZ</td>\n                        </tr>\n                        <tr>\n                            <td>200G</td>\n                            <td>△</td>\n                            <td>▲</td>\n                            <td>△</td>\n                            <td>▲</td>\n                            <td class=\"bg-purple\">確定<br>CZ</td>\n                        </tr>\n                        <tr>\n                            <td height=\"40\">300G</td>\n                            <td>▲</td>\n                            <td>△</td>\n                            <td>▲</td>\n                            <td>△</td>\n                        </tr>\n                        <tr>\n                            <td>400G</td>\n                            <td class=\"bg-yellow\">◯</td>\n                            <td class=\"bg-red\">◎</td>\n                            <td class=\"bg-yellow\">◯</td>\n                            <td class=\"bg-purple\">確定<br>CZ</td>\n                        </tr>\n                        <tr>\n                            <td height=\"40\">500G</td>\n                            <td>▲</td>\n                            <td>△</td>\n                            <td>▲</td>\n                        </tr>\n                        <tr>\n                            <td>600G</td>\n                            <td>△</td>\n                            <td>▲</td>\n                            <td class=\"bg-purple\">確定<br>CZ</td>\n                        </tr>\n                        <tr>\n                            <td>700G</td>\n                            <td class=\"bg-red\">CZ<br>当選</td>\n                            <td class=\"bg-red\">CZ<br>当選</td>\n                        </tr>\n                        <tr>\n                            <td>800G</td>\n                            <td>△</td>\n                            <td class=\"bg-purple\">確定<br>CZ</td>\n                        </tr>\n                        <tr>\n                            <td height=\"40\">900G</td>\n                            <td>▲</td>\n                        </tr>\n                        <tr>\n                            <td>1000G</td>\n                            <td class=\"bg-purple\">AT<br>当選</td>\n                        </tr>\n                    </tbody>\n                </table>\n                <figcaption class=\"left\">※▲＜△＜○＜◎の順に期待度高</figcaption>\n                <figcaption class=\"left\">※確定CZはCZを経由し、必ずATに当選</figcaption>\n\n                <div class=\"memo\">\n                    <p>\n                        MEMO\n                    </p>\n                    <ul>\n                        <li>LOVEチャージで上乗せした分のゲーム数も有効です</li>\n                        <li>高設定ほど上位モードが選択されやすいです</li>\n                        <li>上位モードは上位CZ「アポロニアスモード」の割合が高くなります</li>\n                    </ul>\n                </div>\n            </div>\n        </div>\n        <div>\n            <h3 id=\"destination11\">AT後モード示唆ボイス</h3>\n            <p>前兆終了時・CZ終了時・AT終了時にPUSHボタンを押すとモードを示唆するボイスが発生します。</p>\n            <table border=\"1\">\n                <tbody>\n                    <tr>\n                        <th>キャラ</th>\n                        <th>ボイス</th>\n                        <th>示唆内容</th>\n                    </tr>\n                    <tr>\n                        <td>ミコノ</td>\n                        <td>私だってできる</td>\n                        <td>デフォルト</td>\n                    </tr>\n                    <tr>\n                        <td rowspan=\"2\">ゼシカ</td>\n                        <td>刺激的ぃぃぃ</td>\n                        <td>A以外の<br>期待度25％</td>\n                    </tr>\n                    <tr>\n\n                        <td class=\"bg-white\">力を貸すよ！その意志、皆に見せてあげなきゃね</td>\n                        <td>B以上濃厚</td>\n                    </tr>\n                    <tr>\n                        <td rowspan=\"2\">MIX</td>\n                        <td>私の力を見せてあげる</td>\n                        <td>A以外の<br>期待度33％</td>\n                    </tr>\n                    <tr>\n                        <td class=\"bg-white\">内緒にしなさいよ</td>\n                        <td>C以上濃厚</td>\n                    </tr>\n                    <tr>\n                        <td rowspan=\"2\">ユノハ</td>\n                        <td>恥ずかしいです！</td>\n                        <td>A以外の<br>期待度50％</td>\n                    </tr>\n                    <tr>\n                        <td class=\"bg-white\">見つかっちゃいました</td>\n                        <td>D以上濃厚</td>\n                    </tr>\n                    <tr>\n                        <td rowspan=\"2\">クレア</td>\n                        <td>エスコートして頂けますか</td>\n                        <td>A以外の<br>期待度75％</td>\n                    </tr>\n                    <tr>\n                        <td class=\"bg-white\">見よ！このドーナツを</td>\n                        <td>E以上濃厚</td>\n                    </tr>\n                    <tr>\n                        <td rowspan=\"2\">不動ZEN</td>\n                        <td>時は来た</td>\n                        <td>天国期待度50％</td>\n                    </tr>\n                    <tr>\n                        <td class=\"bg-white\">その時、神話は君を受け入れる</td>\n                        <td>天国濃厚</td>\n                    </tr>\n                    <tr>\n                        <td rowspan=\"3\">サザンカ</td>\n                        <td>もう、さいこーーー！</td>\n                        <td>天井まで100G以内</td>\n                    </tr>\n                    <tr>\n                        <td class=\"bg-white\">腐っちゃうううう</td>\n                        <td>天井まで300G以内</td>\n                    </tr>\n                    <tr>\n                        <td class=\"bg-white\">ちょっとなんであたしだけスルーなの！</td>\n                        <td>天井まで500G以内</td>\n                    </tr>\n                </tbody>\n            </table>\n        </div>\n\n        <div class=\"left\">\n            <h3>ミニキャラの示唆</h3>\n            <p>通常時のハズレ成立＋ミニキャラ演出でテーブルの示唆を行っている。</p>\n            <table border=\"1\">\n                <tbody>\n                    <tr>\n                        <th>パターン</th>\n                        <th>示唆内容</th>\n                    </tr>\n                    <tr>\n                        <td>ミコノorユノハが笑う</td>\n                        <td>B以上濃厚</td>\n                    </tr>\n                    <tr>\n                        <td>ミコノorユノハが喜ぶ</td>\n                        <td>C以上濃厚</td>\n                    </tr>\n                    <tr>\n                        <td>ミコノorユノハが驚く</td>\n                        <td>D以上濃厚</td>\n                    </tr>\n                </tbody>\n            </table>\n            <figcaption class=\"left\">※全て「ハズレ時」のみ有効</figcaption>\n        </div>\n        <button class=\"close\">ー閉じる</button>\n    </div>\n</div>","shukeiHtml":"","columns":[{"id":6198,"title":"Sアクエリオン ALL STARS ハイエナ：詳細情報","date":"2023-03-17","cats":[56,54,142]}]},"ev":null}