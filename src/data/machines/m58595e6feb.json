{"id":"m58595e6feb","name":"Sバハマ30","aliases":["バハマ"],"maker":"平和・オリンピア","thumb":"https://slolaboratory.com/wp-content/uploads/2024/06/bahama-t.png","isNew":false,"sources":{"lab":true,"ev":false},"lab":{"specHtml":"<div id=\"post\" class=\"all-page\">\n    <h1 class=\"setting\">機種情報・設定判別</h1>\n    \n    \n    <p class=\"js-menu\">基本情報</p>\n    <div class=\"contents\">\n        <p class=\"js-menu2\">概要</p>\n        <div class=\"contents2\">\n            <section>\n                <h3>概要</h3>\n                <table border=\"1\">\n                    <tbody>\n                        <tr>\n                            <th style=\"width: 50%;\">機種名</th>\n                            <td>Sバハマ30</td>\n                        </tr>\n                        <tr>\n                            <th>メーカー</th>\n                            <td>アムテックス<br>平和</td>\n                        </tr>\n                        <tr>\n                            <th>タイプ</th>\n                            <td>AT機</td>\n                        </tr>\n                        <tr>\n                            <th>AT純増</th>\n                            <td>約7.4枚</td>\n                        </tr>\n                        <tr>\n                            <th>50枚ごとの回転数</th>\n                            <td>約35.5G</td>\n                        </tr>\n                        <tr>\n                            <th>コイン単価</th>\n                            <td>約2.4円(設定1)</td>\n                        </tr>\n                        <tr>\n                            <th>導入日</th>\n                            <td>2024年7月8日</td>\n                        </tr>\n                    </tbody>\n                </table>\n            </section>\n            \n        </div>\n        <p class=\"js-menu2\">スペック</p>\n        <div class=\"contents2\">\n            <section>\n                <h3>ボーナス(AT)確率</h3>\n                <table border=\"1\">\n                    <tbody>\n                        <tr>\n                            <th style=\"width:25%;\">設定</th>\n                            <th style=\"width:25%;\">BIG</th>\n                            <th style=\"width:25%;\">REG</th>\n                            <th style=\"width:25%;\">合算</th>\n                        </tr>\n                        <tr>\n                            <td>設定L</td>\n                            <td>–</td>\n                            <td>–</td>\n                            <td>–</td>\n                        </tr>\n                        <tr>\n                            <td>設定1</td>\n                            <td>1/296.5</td>\n                            <td>1/524.3</td>\n                            <td>1/189.4</td>\n                        </tr>\n                        <tr>\n                            <td>設定2</td>\n                            <td>1/288.7</td>\n                            <td>1/481.9</td>\n                            <td>1/180.5</td>\n                        </tr>\n                        <tr>\n                            <td>設定3</td>\n                            <td>1/277.7</td>\n                            <td>1/422.8</td>\n                            <td>1/167.6</td>\n                        </tr>\n                        <tr>\n                            <td>設定5</td>\n                            <td>1/262.1</td>\n                            <td>1/360.1</td>\n                            <td>1/151.7</td>\n                        </tr>\n                        <tr>\n                            <td>設定6</td>\n                            <td>1/251.1</td>\n                            <td>1/316.6</td>\n                            <td>1/140.0</td>\n                        </tr>\n                    </tbody>\n                </table>\n            </section>\n            <section>\n                <h3>出玉率</h3>\n                <table>\n                    <tbody>\n                        <tr>\n                            <th>設定</th>\n                            <th style=\"width: 75%;\">出玉率</th>\n                        </tr>\n                        <tr>\n                            <td>設定L</td>\n                            <td>－</td>\n                        </tr>\n                        <tr>\n                            <td>設定1</td>\n                            <td>97.5%</td>\n                        </tr>\n                        <tr>\n                            <td>設定2</td>\n                            <td>99.1%</td>\n                        </tr>\n                        <tr>\n                            <td>設定3</td>\n                            <td>101.5%</td>\n                        </tr>\n                        <tr>\n                            <td>設定5</td>\n                            <td>105.9%</td>\n                        </tr>\n                        <tr>\n                            <td>設定6</td>\n                            <td>109.3%</td>\n                        </tr>\n                    </tbody>\n                </table>\n\n                <div class=\"caution\">\n                    <p>\n                        注意</p>\n                    <p>設定L搭載機、判別方法は不明です。</p>\n                    <!--\n                    <p>設定Lは下パネルが常時消灯します。など</p>\n                    -->\n                </div>\n            </section>\n\n            \n        </div>\n        <p class=\"js-menu2\">打ち方</p>\n        <div class=\"contents2\">\n            <section>\n                <h3>リール配列</h3>\n                <img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2024/07/bahama__14.jpg\" loading=\"lazy\">\n            </section>\n\n            <section>\n                <div class=\"caution\">\n                    <p>\n                        注意</p>\n                    <p>通常時は左第1停止を推奨。変則押しはペナルティの可能性があります。</p>\n                </div>\n\n                <h3>通常時の打ち方(予告音非発生時)</h3>\n                <img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2024/06/bahama__2.jpg\" loading=\"lazy\">\n                <p>予告音が発生しない場合は、左リールからフリー打ち。</p>\n            </section>\n\n            <section>\n                <h3>通常時の打ち方(予告音発生時)</h3>\n                <div class=\"memo\">\n                    <p>\n                        MEMO</p>\n                    <p>予告音が発生時はレア役以上が成立しているため小役をフォロー。</p>\n                    <p>リーチ目役は15枚払い出しのため、取りこぼしに注意しましょう。</p>\n                </div>\n\n                <img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2024/06/bahama__4.jpg\" loading=\"lazy\"><!-- ←バーと赤7狙い画像-->\n                <p>左リール枠上から上段付近に<b>BAR</b>狙い。</p>\n\n                <h4>停止形A</h4>\n                <img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2024/06/bahama__6.jpg\" loading=\"lazy\">\n                <table border=\"1\">\n                    <tbody>\n                        <tr>\n                            <th style=\"width: 25%;\">成立役</th>\n                            <td bgcolor=\"#DDDDDD\">チェリー・リーチ目</td>\n                        </tr>\n                    </tbody>\n                </table>\n                <p>中・右リールはフリー打ち。</p>\n                <p>チェリーが中段に停止した場合はリーチ目となります。</p>\n\n                <h4>停止形B</h4>\n                <img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2024/06/bahama__7.jpg\" loading=\"lazy\">\n                <table border=\"1\">\n                    <tbody>\n                        <tr>\n                            <th style=\"width: 25%;\">成立役</th>\n                            <td bgcolor=\"#DDDDDD\">スイカ・リーチ目</td>\n                        </tr>\n                    </tbody>\n                </table>\n                <p>中・右リールはフリー打ち。</p>\n                <p>スイカがテンパイして外れればリーチ目となります。</p>\n\n                <h4>停止形C</h4>\n                <img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2024/06/bahama__5.jpg\" loading=\"lazy\">\n                <table border=\"1\">\n                    <tbody>\n                        <tr>\n                            <th style=\"width: 25%;\">成立役</th>\n                            <td bgcolor=\"#DDDDDD\">リーチ目役</td>\n                        </tr>\n                    </tbody>\n                </table>\n                <p>予告音が発生し、チェリーもしくはスイカを否定した場合はリーチ目となります。</p>\n            </section>\n\n            <section>\n                <h3>ボーナス中の打ち方</h3>\n                <p>押し順ナビ発生時はナビに従って消化。</p>\n                <p>ナビ非発生時は通常時同様の打ち方でレア役をフォローしましょう。</p>\n            </section>\n\n            <section>\n                <h3>チャンス役の停止形</h3>\n                <table border=\"1\">\n                    <tbody>\n                        <tr>\n                            <th style=\"width: 50%;\">チェリー</th>\n                            <th>スイカ</th>\n                        </tr>\n                        <tr>\n                            <td class=\"bg-white\"><img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2024/06/bahama__10.jpg\" loading=\"lazy\"></td>\n                            <td><img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2024/06/bahama__8.jpg\" loading=\"lazy\"></td>\n                        </tr>\n                        <tr>\n                            <th>リーチ目役</th>\n                            <th>リーチ目役</th>\n                        </tr>\n                        <tr>\n                            <td class=\"bg-white\"><img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2024/06/bahama__11.jpg\" loading=\"lazy\"></td>\n                            <td><img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2024/06/bahama__9.jpg\" loading=\"lazy\"></td>\n                        </tr>\n                        <tr>\n                            <th>リーチ目役</th>\n                            <th>リーチ目役</th>\n                        </tr>\n                        <tr>\n                            <td class=\"bg-white\"><img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2024/06/bahama__12.jpg\" loading=\"lazy\"></td>\n                            <td><img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2024/06/bahama__13.jpg\" loading=\"lazy\"></td>\n                        </tr>\n                    </tbody>\n                </table>\n            </section>\n\n            \n        </div>\n        <p class=\"js-menu2\">小役確率</p>\n        <div class=\"contents2\">\n            <section>\n                <h3>小役確率詳細</h3>\n                <h4>設定差のない小役確率</h4>\n                <table border=\"1\">\n                    <tbody>\n                        <tr>\n                            <th>小役</th>\n                            <th style=\"width:50%;\">出現率(全設定共通)</th>\n                        </tr>\n                        <tr>\n                            <td>押し順15枚ベル</td>\n                            <td>1/1.7</td>\n                        </tr>\n                        <tr>\n                            <td>リプレイ</td>\n                            <td>1/7.3</td>\n                        </tr>\n                    </tbody>\n                </table>\n\n                <h4>設定差のある小役確率</h4>\n                <table border=\"1\" style=\"font-size: 92%;\">\n                    <tbody>\n                        <tr>\n                            <th>設定</th>\n                            <th style=\"width:20%;\">押し順<br>8枚ベル</th>\n                            <th style=\"width:20%;\">共通1枚</th>\n                            <th style=\"width:20%;\">スイカ</th>\n                            <th style=\"width:20%;\">3枚<br>チェリー</th>\n                        </tr>\n                        <tr>\n                            <td>設定1</td>\n                            <td>1/7.0</td>\n                            <td>1/8.5</td>\n                            <td>1/99.9</td>\n                            <td>1/256.0</td>\n                        </tr>\n                        <tr>\n                            <td>設定2</td>\n                            <td>1/7.0</td>\n                            <td>1/8.6</td>\n                            <td>1/99.4</td>\n                            <td>1/234.1</td>\n                        </tr>\n                        <tr>\n                            <td>設定3</td>\n                            <td>1/7.0</td>\n                            <td>1/8.7</td>\n                            <td>1/95.4</td>\n                            <td>1/215.6</td>\n                        </tr>\n                        <tr>\n                            <td>設定5</td>\n                            <td>1/6.9</td>\n                            <td>1/8.9</td>\n                            <td>1/89.8</td>\n                            <td>1/199.8</td>\n                        </tr>\n                        <tr>\n                            <td>設定6</td>\n                            <td>1/6.9</td>\n                            <td>1/9.0</td>\n                            <td>1/86.0</td>\n                            <td>1/186.2</td>\n                        </tr>\n                    </tbody>\n                </table>\n            </section>\n            <section>\n                <h3>50枚ごとの回転数</h3>\n                <table border=\"1\">\n                    <tbody>\n                        <tr>\n                            <th>設定</th>\n                            <th style=\"width:50%;\">50枚ごとの回転数</th>\n                        </tr>\n                        <tr>\n                            <td>設定L</td>\n                            <td>－</td>\n                        </tr>\n                        <tr>\n                            <td>設定1</td>\n                            <td>35.5G</td>\n                        </tr>\n                        <tr>\n                            <td>設定2</td>\n                            <td>35.6G</td>\n                        </tr>\n                        <tr>\n                            <td>設定3</td>\n                            <td>35.9G</td>\n                        </tr>\n                        <tr>\n                            <td>設定5</td>\n                            <td>36.2G</td>\n                        </tr>\n                        <tr>\n                            <td>設定6</td>\n                            <td>36.5G</td>\n                        </tr>\n                    </tbody>\n                </table>\n                <figcaption class=\"left\">(※)完全攻略時の数値。</figcaption>\n            </section>\n\n            \n        </div>\n        <p class=\"js-menu2\">天井情報</p>\n        <div class=\"contents2\">\n            <section>\n                <h3>ゲーム数天井</h3>\n                <table border=\"1\">\n                    <tbody>\n                        <tr>\n                            <th style=\"width: 30%;\">天井条件</th>\n                            <td>非搭載</td>\n                        </tr>\n                        <tr>\n                            <th>恩恵</th>\n                            <td>－</td>\n                        </tr>\n                    </tbody>\n                </table>\n            </section>\n\n            \n        </div>\n        <p class=\"js-menu2\">有利区間切れ条件・恩恵</p>\n        <div class=\"contents2\">\n            <section>\n                <h3>有利区間切れタイミングについて</h3>\n                <p>本機は6.5号機なので有利区間のゲーム数上限は4000G、差枚上限は2400枚となっています。</p>\n\n                <h4>有利区間リセット条件</h4>\n                <p>有利区間リセットのタイミングは不明です。</p>\n            </section>\n\n            \n        </div>\n        <p class=\"js-menu2\">リセット判別</p>\n        <div class=\"contents2\">\n            <section>\n                <h3 id=\"destination500\">朝イチの挙動</h3>\n                <table border=\"1\">\n                    <tbody>\n                        <tr>\n                            <th>項目</th>\n                            <th style=\"width: 33.3%;\">設定変更</th>\n                            <th style=\"width: 33.3%;\">電源OFF→ON</th>\n                        </tr>\n                        <tr>\n                            <td>天井</td>\n                            <td>－</td>\n                            <td>－</td>\n                        </tr>\n                        <tr>\n                            <td>内部状態</td>\n                            <td>リセット</td>\n                            <td>引き継ぐ</td>\n                        </tr>\n                        <tr>\n                            <td>リールガックン</td>\n                            <td>無効</td>\n                            <td>－</td>\n                        </tr>\n                    </tbody>\n                </table>\n\n                <h4>設定変更時の挙動</h4>\n                <p>不明。</p>\n\n                <!--\n                <h4>リセット判別に使える要素</h4>\n                <p>不明。</p>\n                -->\n            </section>\n\n            \n        </div>\n    </div>\n    <p class=\"js-menu\">設定狙い</p>\n    <div class=\"contents\">\n        <p class=\"js-menu2\">設定判別項目</p>\n        <div class=\"contents2\">\n            <section>\n                <h3>通常時</h3>\n                <table border=\"1\">\n                    <tbody>\n                        <tr>\n                            <th style=\"width: 73%;\">項目</th>\n                            <th>重要度</th>\n                        </tr>\n                        <tr>\n                            <td><img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2022/12/下向きの矢印のアイコン素材.png\" class=\"icon-small\" alt=\"arrow\" loading=\"lazy\"><a class=\"scroll-link1\" href=\"javascript:void(0)\">ボーナス確率</a></td>\n                            <td>★★★☆☆</td>\n                        </tr>\n                        <tr>\n                            <td><img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2022/12/下向きの矢印のアイコン素材.png\" class=\"icon-small\" alt=\"arrow\" loading=\"lazy\"><a class=\"scroll-link2\" href=\"javascript:void(0)\">設定差のある小役確率</a></td>\n                            <td>★★★☆☆</td>\n                        </tr>\n                        <tr>\n                            <td><img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2022/12/下向きの矢印のアイコン素材.png\" class=\"icon-small\" alt=\"arrow\" loading=\"lazy\"><a class=\"scroll-link3\" href=\"javascript:void(0)\">ロングフリーズ発生確率</a></td>\n                            <td>★★★☆☆</td>\n                        </tr>\n                    </tbody>\n                </table>\n            </section>\n\n            \n        </div>\n        <p class=\"js-menu2\">数値詳細</p>\n        <div class=\"contents2\">\n            <section>\n                <h3 id=\"destination1\">ボーナス確率</h3>\n                <p>高設定ほどボーナス確率が高く、特にレギュラーボーナスの当選率は差が大きいようです。</p>\n                <table border=\"1\">\n                    <tbody>\n                        <tr>\n                            <th style=\"width:25%;\">設定</th>\n                            <th style=\"width:25%;\">BIG</th>\n                            <th style=\"width:25%;\">REG</th>\n                            <th style=\"width:25%;\">合算</th>\n                        </tr>\n                        <tr>\n                            <td>設定1</td>\n                            <td>1/296.5</td>\n                            <td>1/524.3</td>\n                            <td>1/189.4</td>\n                        </tr>\n                        <tr>\n                            <td>設定2</td>\n                            <td>1/288.7</td>\n                            <td>1/481.9</td>\n                            <td>1/180.5</td>\n                        </tr>\n                        <tr>\n                            <td>設定3</td>\n                            <td>1/277.7</td>\n                            <td>1/422.8</td>\n                            <td>1/167.6</td>\n                        </tr>\n                        <tr>\n                            <td>設定5</td>\n                            <td>1/262.1</td>\n                            <td>1/360.1</td>\n                            <td>1/151.7</td>\n                        </tr>\n                        <tr>\n                            <td>設定6</td>\n                            <td>1/251.1</td>\n                            <td>1/316.6</td>\n                            <td>1/140.0</td>\n                        </tr>\n                    </tbody>\n                </table>\n            </section>\n            <section>\n                <h3 id=\"destination2\">設定差のある小役確率</h3>\n                <p>押し順8枚ベル・共通1枚・3枚チェリー・スイカの出現率に設定差があります。</p>\n                <p>特に3枚チェリーとスイカの出現率には設定差があるためカウントしましょう。</p>\n                <table border=\"1\" style=\"font-size: 92%;\">\n                    <tbody>\n                        <tr>\n                            <th>設定</th>\n                            <th style=\"width:20%;\">押し順<br>8枚ベル</th>\n                            <th style=\"width:20%;\">共通1枚</th>\n                            <th style=\"width:20%;\">スイカ</th>\n                            <th style=\"width:20%;\">3枚<br>チェリー</th>\n                        </tr>\n                        <tr>\n                            <td>設定1</td>\n                            <td>1/7.0</td>\n                            <td>1/8.5</td>\n                            <td>1/99.9</td>\n                            <td>1/256.0</td>\n                        </tr>\n                        <tr>\n                            <td>設定2</td>\n                            <td>1/7.0</td>\n                            <td>1/8.6</td>\n                            <td>1/99.4</td>\n                            <td>1/234.1</td>\n                        </tr>\n                        <tr>\n                            <td>設定3</td>\n                            <td>1/7.0</td>\n                            <td>1/8.7</td>\n                            <td>1/95.4</td>\n                            <td>1/215.6</td>\n                        </tr>\n                        <tr>\n                            <td>設定5</td>\n                            <td>1/6.9</td>\n                            <td>1/8.9</td>\n                            <td>1/89.8</td>\n                            <td>1/199.8</td>\n                        </tr>\n                        <tr>\n                            <td>設定6</td>\n                            <td>1/6.9</td>\n                            <td>1/9.0</td>\n                            <td>1/86.0</td>\n                            <td>1/186.2</td>\n                        </tr>\n                    </tbody>\n                </table>\n                <div class=\"caution\">\n                    <p>\n                        注意</p>\n                    <p>チェリーは1枚払い出しと3枚払い出しの2種類あるためカウントする際は注意しましょう。</p>\n                </div>\n            </section>\n            <section>\n                <h3 id=\"destination3\">ロングフリーズ発生確率</h3>\n                <p>ロングフリーズ発生確率に特大設定差があります。</p>\n                <p>2回以上確認できれば高設定に期待できそうです。</p>\n                <table border=\"1\">\n                    <tbody>\n                        <tr>\n                            <th>設定</th>\n                            <th style=\"width:50%;\">発生確率</th>\n                        </tr>\n                        <tr>\n                            <td>設定1</td>\n                            <td>1/41943.0</td>\n                        </tr>\n                        <tr>\n                            <td>設定2</td>\n                            <td>1/34952.5</td>\n                        </tr>\n                        <tr>\n                            <td>設定3</td>\n                            <td>1/26630.5</td>\n                        </tr>\n                        <tr>\n                            <td>設定5</td>\n                            <td>1/12710.0</td>\n                        </tr>\n                        <tr>\n                            <td>設定6</td>\n                            <td>1/8015.9</td>\n                        </tr>\n                    </tbody>\n                </table>\n            </section>\n            \n        </div>\n    </div>\n\n    <p class=\"js-menu\">通常時の抽選</p>\n    <div class=\"contents\">\n        <section>\n            <h3>通常時の抽選</h3>\n            <p>通常時はノーマル機のような完全確率抽選となっており、リーチ目役などのフラグによってボーナスに当選します。</p>\n            <p>リール左右にあるフラミンゴランプが点灯すればボーナスとなります。</p>\n\n            <h4>ボーナス入賞時</h4>\n            <p>リーチ目とボーナス図柄揃いの一部は15枚の払い出しがあり、ボーナスに当選時にメダルが無くならない仕様となっています。</p>\n        </section>\n        \n    </div>\n    <p class=\"js-menu\">ボーナス関連</p>\n    <div class=\"contents\">\n        <p class=\"js-menu2\">各種ボーナス</p>\n        <div class=\"contents2\">\n            <section>\n                <h3>BIGボーナス</h3>\n                <table border=\"1\">\n                    <tbody>\n                        <tr>\n                            <th style=\"width: 50%;\">項目</th>\n                            <th>内容</th>\n                        </tr>\n                        <tr>\n                            <td>図柄</td>\n                            <td>ピンク7揃い<br>白7揃い</td>\n                        </tr>\n                        <tr>\n                            <td>純増</td>\n                            <td>約7.4枚</td>\n                        </tr>\n                        <tr>\n                            <td>継続ゲーム数</td>\n                            <td>44G+α</td>\n                        </tr>\n                        <tr>\n                            <td>平均獲得枚数</td>\n                            <td>約344枚</td>\n                        </tr>\n                    </tbody>\n                </table>\n                <p>44G消化時に獲得枚数が303枚未満であればエクストラゲームに突入します。</p>\n                <p>エクストラゲームは303枚以上獲得するまで継続します。</p>\n                <figcaption class=\"left\">※ボーナスの獲得枚数にはリーチ目役またはボーナス入賞時の15枚を含みます。</figcaption>\n\n                <h4>獲得枚数の割合</h4>\n                <table border=\"1\">\n                    <tbody>\n                        <tr>\n                            <th>獲得枚数</th>\n                            <th style=\"width:50%;\">割合</th>\n                        </tr>\n                        <tr>\n                            <td>303～349枚</td>\n                            <td>62.9%</td>\n                        </tr>\n                        <tr>\n                            <td>350～399枚</td>\n                            <td>32.6%</td>\n                        </tr>\n                        <tr>\n                            <td>400枚以上</td>\n                            <td>4.5%</td>\n                        </tr>\n                    </tbody>\n                </table>\n            </section>\n            <section>\n                <h3>REGULAR BONUS</h3>\n                <table border=\"1\">\n                    <tbody>\n                        <tr>\n                            <th style=\"width: 50%;\">項目</th>\n                            <th>内容</th>\n                        </tr>\n                        <tr>\n                            <td>図柄</td>\n                            <td>ピンク7・ピンク7・BAR<br>白7・白7・BAR</td>\n                        </tr>\n                        <tr>\n                            <td>純増</td>\n                            <td>約7.4枚</td>\n                        </tr>\n                        <tr>\n                            <td>獲得枚数</td>\n                            <td>約120枚</td>\n                        </tr>\n                    </tbody>\n                </table>\n                <p>120枚以上獲得で終了するボーナスとなっています。</p>\n            </section>\n            \n        </div>\n        <p class=\"js-menu2\">ロングフリーズ</p>\n        <div class=\"contents2\">\n            <section>\n                <h3>ロングフリーズ</h3>\n                <table border=\"1\">\n                    <tbody>\n                        <tr>\n                            <th>項目</th>\n                            <th style=\"width:50%;\">内容</th>\n                        </tr>\n                        <tr>\n                            <td>発生確率</td>\n                            <td>1/41943(設定1)</td>\n                        </tr>\n                        <tr>\n                            <td>恩恵</td>\n                            <td>BIG当選濃厚</td>\n                        </tr>\n                    </tbody>\n                </table>\n                <p>ロングフリーズが発生すればBIGボーナス当選濃厚で、高設定ほど出現しやすくなっています。</p>\n                <h4>ロングフリーズ発生確率</h4>\n                <table border=\"1\">\n                    <tbody>\n                        <tr>\n                            <th>設定</th>\n                            <th style=\"width:50%;\">発生確率</th>\n                        </tr>\n                        <tr>\n                            <td>設定1</td>\n                            <td>1/41943.0</td>\n                        </tr>\n                        <tr>\n                            <td>設定2</td>\n                            <td>1/34952.5</td>\n                        </tr>\n                        <tr>\n                            <td>設定3</td>\n                            <td>1/26630.5</td>\n                        </tr>\n                        <tr>\n                            <td>設定5</td>\n                            <td>1/12710.0</td>\n                        </tr>\n                        <tr>\n                            <td>設定6</td>\n                            <td>1/8015.9</td>\n                        </tr>\n                    </tbody>\n                </table>\n            </section>\n            \n        </div>\n\n    </div>\n    <p class=\"js-menu\">演出情報</p>\n    <div class=\"contents\">\n        <p class=\"js-menu2\">通常時の演出</p>\n        <div class=\"contents2\">\n            <section>\n                <h3>通常時の演出</h3>\n                <p>通常時はノーマル機のような完全確率抽選となっており、リーチ目役などのフラグによってボーナスに当選します。</p>\n                <p>リール左右にあるフラミンゴランプが点灯すればボーナスとなります。</p>\n\n                <h4>ボーナス入賞時</h4>\n                <p>リーチ目とボーナス図柄揃いの一部は15枚の払い出しがあり、ボーナスに当選時にメダルが無くならない仕様となっています。</p>\n            </section>\n            \n        </div>\n        <p class=\"js-menu2\">ボーナス告知演出</p>\n        <div class=\"contents2\">\n            <section>\n                <h3>BIG濃厚パターン</h3>\n                <h4>ボーナス告知</h4>\n                <table border=\"1\">\n                    <tbody>\n                        <tr>\n                            <th colspan=\"2\">演出内容</th>\n                        </tr>\n                        <tr>\n                            <td class=\"bg-white\" style=\"width:50%;\">通常点滅<br>→点灯の繰り返し</td>\n                            <td>通常点滅<br>→高速点滅</td>\n                        </tr>\n                        <tr>\n                            <td class=\"bg-white\">通常点滅<br>→ゆっくり点灯</td>\n                            <td>告知音ナシで<br>通常点滅</td>\n                        </tr>\n                        <tr>\n                            <td class=\"bg-white\">高速点滅</td>\n                            <td>じわっと点灯</td>\n                        </tr>\n                        <tr>\n                            <td class=\"bg-white\">同時点滅<br>→交互点滅</td>\n                            <td>ふわっと同時点滅</td>\n                        </tr>\n                        <tr>\n                            <td class=\"bg-white\">左右交互点滅</td>\n                            <td>左右2回交互点滅</td>\n                        </tr>\n                        <tr>\n                            <td class=\"bg-white\">瞬き<br>→通常点滅</td>\n                            <td>飛翔点灯</td>\n                        </tr>\n                        <tr>\n                            <td class=\"bg-white\">スロー同時点滅</td>\n                            <td>スロー交互点滅</td>\n                        </tr>\n                        <tr>\n                            <td class=\"bg-white\">334拍子</td>\n                            <td>左2回・右2回<br>→左1回・右1回</td>\n                        </tr>\n                        <tr>\n                            <td class=\"bg-white\">下から上へ<br>順次点灯</td>\n                            <td>下上交互<br>→下上同時</td>\n                        </tr>\n                        <tr>\n                            <td class=\"bg-white\">色変化</td>\n                            <td>下から上へ<br>レインボー</td>\n                        </tr>\n                    </tbody>\n                </table>\n\n                <h4>リール始動後</h4>\n                <table border=\"1\">\n                    <tbody>\n                        <tr>\n                            <th colspan=\"2\">演出内容</th>\n                        </tr>\n                        <tr>\n                            <td class=\"bg-white\" style=\"width: 50%;\">遅れ</td>\n                            <td>遅れ告知</td>\n                        </tr>\n                        <tr>\n                            <td class=\"bg-white\">レバーオン時に<br>告知音のみ</td>\n                            <td>第3停止時に<br>隠しランプが点灯</td>\n                        </tr>\n                        <tr>\n                            <td class=\"bg-white\">肝ランプ点灯</td>\n                            <td>白玉ランプ点灯</td>\n                        </tr>\n                        <tr>\n                            <td class=\"bg-white\">フリーズ</td>\n                        </tr>\n                    </tbody>\n                </table>\n            </section>\n            \n        </div>\n    </div>\n</div>","shukeiHtml":"","columns":[]},"ev":null}