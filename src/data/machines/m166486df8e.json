               <td><p>456枚獲得</p></td>\n                            <td>設定4以上濃厚</td>\n                        </tr>\n                        <tr>\n                            <td><p>539枚獲得</p></td>\n                            <td>高設定期待度アップ<br>+高継続期待度アップ</td>\n                        </tr>\n                        <tr>\n                            <td><p>555枚獲得</p></td>\n                            <td>設定5以上濃厚</td>\n                        </tr>\n                        <tr>\n                            <td><p>666枚獲得</p></td>\n                            <td>設定6濃厚</td>\n                        </tr>\n                        <tr>\n                            <td><p>777枚獲得</p></td>\n                            <td>設定6濃厚</td>\n                        </tr>\n                        <tr>\n                            <td><p>3456枚獲得</p></td>\n                            <td>設定4以上濃厚</td>\n                        </tr>\n                        <tr>\n                            <td><p>ありがとねっと(赤)</p></td>\n                            <td>高設定期待度アップ</td>\n                        </tr>\n                        <tr>\n                            <td><p>ありがとねっと(金)</p></td>\n                            <td>設定4以上濃厚</td>\n                        </tr>\n                    </tbody>\n                </table>\n            </div>\n\n            <div class=\"left\">\n                <h3 id=\"destination3\">ボーナス初当り確率</h3>\n                <p>会議室は連チャンの可能性があるため、分母から除外し算出。</p>\n                <table>\n                    <tbody>\n                        <tr>\n                            <th>設定</th>\n                            <th>ボーナス初当り</th>\n                        </tr>\n                        <tr>\n                            <td>設定1</td>\n                            <td>1/249</td>\n                        </tr>\n                        <tr>\n                            <td>設定2</td>\n                            <td>1/241</td>\n                        </tr>\n                        <tr>\n 