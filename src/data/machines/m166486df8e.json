\n                            <td>102.0%</td>\n                        </tr>\n                        <tr>\n                            <td>設定5</td>\n                            <td>104.7%</td>\n                        </tr>\n                        <tr>\n                            <td>設定6</td>\n                            <td>107.0%</td>\n                        </tr>\n                        <tr>\n                            <td>設定L</td>\n                            <td>ー</td>\n                        </tr>\n                    </tbody>\n                </table>\n            <div class=\"memo\">\n                <p>\n                    MEMO\n                </p>\n                \n            </div>\n            </div>\n\n            <button class=\"close\">ー閉じる</button>\n        </div>\n\n        <p class=\"js-menu\">基本情報</p>\n<div class=\"contents\">\n    <div class=\"left\">\n        <h3>天井・打ち方・詳細情報</h3>\n        <table border=\"1\">\n            <tbody>\n                <tr>\n                    <th style=\"width: 50%;\">項目</th>\n                    <th>記載</th>\n                </tr><tr>\n                    <td><img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2022/12/下向きの矢印のアイコン素材.png\" class=\"icon-small\" alt=\"arrow\" loading=\"lazy\">\n                        天井情報\n                    </td>\n                    <td>ボーナス間天井<br>チェリー回数天井</td>\n                </tr>\n                <tr>\n                    <td><img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2022/12/下向きの矢印のアイコン素材.png\" class=\"icon-small\" alt=\"arrow\" loading=\"lazy\">\n                        打ち方\n                    </td>\n                    <td>準備中</td>\n                </tr>\n                <tr>\n                    <td><img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2022/12/下向きの矢印のアイコン素材.png\" class=\"icon-small\" alt=\"arrow\" loading=\"lazy\">\n                        ハイエナ詳細情報\n                    </