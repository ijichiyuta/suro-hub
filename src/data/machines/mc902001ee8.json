\n                        </tr>\n                        <tr>\n                            <td><img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2023/06/shintenkahubu__19.png\" loading=\"lazy\"><p>三武将</p></td>\n                            <td>デフォルト</td>\n                        </tr>\n                        <tr>\n                            <td><img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2023/06/shintenkahubu__20.png\" loading=\"lazy\"><p>武具</p></td>\n                            <td>高設定示唆</td>\n                        </tr>\n                        <tr>\n                            <td><img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2023/06/shintenkahubu__21.png\" loading=\"lazy\"><p>銅トロフィー</p></td>\n                            <td>設定2以上濃厚</td>\n                        </tr>\n                        <tr>\n                            <td><img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2023/06/shintenkahubu__22.png\" loading=\"lazy\"><p>金トロフィー</p></td>\n                            <td>設定4以上濃厚</td>\n                        </tr>\n                        <tr>\n                            <td><img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2023/06/shintenkahubu__23.png\" loading=\"lazy\"><p>ケロット柄トロフィー</p></td>\n                            <td>設定5以上濃厚</td>\n                        </tr>\n                        <tr>\n                            <td><img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2023/06/shintenkahubu__24.png\" loading=\"lazy\"><p>虹トロフィー</p></td>\n                            <td>設定6濃厚</td>\n                        </tr>\n                    </tbody>\n                </table>\n                <table border=\"1\">\n                    <caption>AT終了画面振り分け</caption>\n                    <tbody>\n                        <tr>\n                            <th>設定</th>\n                            <th>三