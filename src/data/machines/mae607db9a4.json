>30.2％</td>\n                            <td>9.5％</td>\n                        </tr>\n                        <tr>\n                            <td>設定2</td>\n                            <td>6.9％</td>\n                            <td>36.4％</td>\n                            <td>2.4％</td>\n                        </tr>\n                        <tr>\n                            <td>設定3</td>\n                            <td>6.7％</td>\n                            <td>39.7％</td>\n                            <td>2.5％</td>\n                        </tr>\n                        <tr>\n                            <td>設定4</td>\n                            <td>6.6％</td>\n                            <td>40.4％</td>\n                            <td>2.2％</td>\n                        </tr>\n                        <tr>\n                            <td>設定5</td>\n                            <td>6.4％</td>\n                            <td>44.9％</td>\n                            <td>2.4％</td>\n                        </tr>\n                        <tr>\n                            <td>設定6</td>\n                            <td>5.8％</td>\n                            <td>42.5％</td>\n                            <td>3.9％</td>\n                        </tr>\n                    </tbody>\n                </table>\n            </div>\n\n            <div class=\"left\">\n                <h3 id=\"destination3\">ボーナス終了時の上部ランプ</h3>\n                <img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2023/05/javelin__9.png\" loading=\"lazy\">\n                <p>ボーナス終了時の上部パネルの点灯パターンで、設定示唆が行われています。</p>\n                <div class=\"memo\">\n                    <p> MEMO\n                    </p>\n                    <p>上部パネルの点灯は内部的に獲得できる設定示唆ポイントが多いほど発生しやすくなります。</p>\n                    <p>ポイントはボーナス当選時(0～6pt)と消化中のチェリー成立時(1pt以上)に獲得。</p>\n                    <p>なお、ボーナス当選時のポイントは総ゲーム数が影響。</p>\n                </div>\n                <table border=\"1\">\n                    <caption>ボーナス終了時のTOPランプ</caption>\n                    <tbody>\n                        <tr>\n                            <th>点灯パターン</th>\n                            <th>示唆内容</th>\n                        </tr>\n                        <tr>\n                            <td>非点灯</td>\n                            <td>デフォルト</td>\n                        </tr>\n                        <tr>\n                            <td>全体点滅</td>\n                            <td>設定2以上期待度アップ</td>\n                        </tr>\n                        <tr>\n                            <td>青点灯</td>\n                            <td>奇数設定期待度アップ</td>\n                        </tr>\n                        <tr>\n                            <td>黄点灯</td>\n                            <td>偶数設定期待度アップ</td>\n                        </tr>\n                        <tr>\n                            <td>緑点灯</td>\n                            <td>高設定期待度アップ</td>\n                        </tr>\n                        <tr>\n                            <td>赤点灯</td>\n                            <td>高設定の期待大</td>\n                        </tr>\n                        <tr>\n                            <td>虹点灯</td>\n                            <td>高設定の期待大</td>\n                        </tr>\n                        <tr>\n                            <th>フラッシュパターン</th>\n                            <th>示唆内容</th>\n                        </tr>\n                        <tr>\n                            <td>左からフラッシュ</td>\n                            <td>奇数設定期待度アップ</td>\n                        </tr>\n                        <tr>\n                            <td>右からフラッシュ</td>\n                            <td>偶数設定期待度アップ</td>\n                        </tr>\n                        <tr>\n                            <td>特定ランプフラッシュ+ボイス発生</td>\n                            <td>高設定期待度アップ</td>\n                        </tr>\n                    </tbody>\n                </table>\n            </div>\n            <button class=\"close\">ー閉じる</button>\n        </div>\n        <p class=\"js-menu\" style=\"display: none;\">高設定狙いに必要な演出法則</p>\n        <div class=\"contents\">\n            <div class=\"left\">\n                <img decoding=\"async\" src=\"https://media.slolaboratory.com/wp-content/uploads/2026/04/24005602/noimage1.jpg\" loading=\"lazy\">\n            </div>\n            <button class=\"close\">ー閉じる</button>\n        </div>\n    </div>\n</div>","shukeiHtml":"","columns":[{"id":15501,"title":"Sジャベリン ハイエナ：詳細情報","date":"2023-05-24","cats":[56,54]}]},"ev":null}