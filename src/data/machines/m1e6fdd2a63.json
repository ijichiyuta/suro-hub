%</td>\n                        </tr>\n                        <tr>\n                            <td>設定3</td>\n                            <td>101.5%</td>\n                        </tr>\n                        <tr>\n                            <td>設定4</td>\n                            <td>103.6%</td>\n                        </tr>\n                        <tr>\n                            <td>設定5</td>\n                            <td>106.5%</td>\n                        </tr>\n                        <tr>\n                            <td>設定6</td>\n                            <td>110.0%</td>\n                        </tr>\n                    </tbody>\n                </table>\n            </div>\n            \n            <button class=\"close\">ー閉じる</button>\n        </div>\n\n        <p class=\"js-menu\">基本情報</p>\n        <div class=\"contents\">\n            <div class=\"left\">\n                <h3>天井・打ち方・詳細情報</h3>\n                <table border=\"1\">\n                    <tbody>\n                        <tr>\n                            <th style=\"width: 50%;\">項目</th>\n                            <th>記載</th>\n                        </tr><tr>\n                            <td><img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2022/12/下向きの矢印のアイコン素材.png\" class=\"icon-small\" alt=\"arrow\" loading=\"lazy\">天井情報</td>\n                            <td>非搭載</td>\n                        </tr>\n                        <tr>\n                            <td><img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2022/12/下向きの矢印のアイコン素材.png\" class=\"icon-small\" alt=\"arrow\" loading=\"lazy\">打ち方</td>\n                            <td>通常時の打ち方<br>ボーナス中の打ち方<br>RT中の打ち方</td>\n                        </tr>\n                        <tr>\n                            <td><img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2022/12/下向きの矢印のアイコン素材.png\" class=\"icon-small\" alt=\"arrow\" loading=\"lazy\">ハイエナ詳細情報</td>\n                            <td>その他のハイエナ情報</td>\n                        </tr>\n                    </tbody>\n                </table>\n            </div>\n\n            <button class=\"close\">ー閉じる</button>\n        </div>\n    \n        <p class=\"js-menu\">数値詳細</p>\n        <div class=\"contents\">\n            <div class=\"left\">\n                <h3 id=\"destination1\">枚数調整時のカモメランプ</h3>\n                <img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2023/12/nshiosai__19.png\" loading=\"lazy\">\n                <p>ボーナス中に枚数調整を行った時に点灯するカモメランプの色がレインボーなら高設定に期待！？</p>\n                (ボーナス中の打ち方について)\n            </div>\n\n            <div class=\"left\">\n                <h3 id=\"destination2\">BIG中の予告音</h3>\n                <p>BIG中は高設定ほど予告音の発生回数が多くなる模様。</p>\n                <p>また、その時にハイビスカスを狙って下段に停まった回数が多いほど高設定に期待！？</p>\n                (ボーナス中の打ち方について)\n            </div>\n\n            <div class=\"left\">\n                <h3 id=\"destination3\">REG・RT終了時のパネルフラッシュ</h3>\n                <img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2023/12/nshiosai__20.png\" loading=\"lazy\">\n                <p>REG終了後とRT終了後は筐体上下のパネルがフラッシュすることがあり、高設定ほど発生率が高い模様。</p>\n            </div>\n\n            <button class=\"close\">ー閉じる</button>\n        </div>\n        \n        <p class=\"js-menu\" style=\"display: none;\">高設定狙いに必要な演出法則</p>\n        <div class=\"contents\" style=\"display: none;\">\n            <div class=\"left\">\n                <img decoding=\"async\" src=\"https://media.slolaboratory.com/wp-content/uploads/2026/04/24005602/noimage1.jpg\" loading=\"lazy\">\n            </div>\n           \n            <button class=\"close\">ー閉じる</button>\n        </div>\n        \n    </div>\n</div>","shukeiHtml":"","columns":[{"id":38456,"title":"ニューシオサイ：詳細情報","date":"2023-11-30","cats":[56,54,142]},{"id":38454,"title":"ニューシオサイ 基本情報","date":"2023-11-30","cats":[54,57]}]},"ev":null}