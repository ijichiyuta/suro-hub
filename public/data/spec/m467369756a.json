slodol__54.png\" loading=\"lazy\">\n                            <p>水着2</p>\n                        </td>\n                        <td>設定2以上濃厚</td>\n                    </tr>\n                    <tr>\n                        <td><img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2023/04/slodol__55.png\" loading=\"lazy\">\n                            <p>コスプレ</p>\n                        </td>\n                        <td>設定4以上濃厚</td>\n                    </tr>\n                    <tr>\n                        <td><img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2023/04/slodol__49.png\" loading=\"lazy\">\n                            <p>オールキャスト</p>\n                        </td>\n                        <td>カリスマモード移行<br>or<br>設定6濃厚</td>\n                    </tr>\n                </tbody>\n            </table>\n            <p>設定の示唆はAT終了画面で行われます。なかでもオールキャストはやや特殊な扱いで、「カリスマモード」または設定6濃厚を意味します。</p>\n        </div>\n        <div class=\"left\">\n            <h3 id=\"destination2\">獲得枚数表示</h3>\n            <img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2023/04/slodol__56.png\" loading=\"lazy\">\n            <table border=\"1\">\n                <tbody>\n                    <tr>\n                        <th>獲得枚数</th>\n                        <th>示唆内容</th>\n                    </tr>\n                    <tr>\n                        <td>222 over</td>\n                        <td>設定2以上濃厚</td>\n                    </tr>\n                    <tr>\n                        <td>246 over</td>\n                        <td>偶数設定濃厚</td>\n                    </tr>\n                    <tr>\n                        <td>333 over</td>\n                        <td>設定3以上濃厚</td>\n                    </tr>\n                    <tr>\n                        <td>444 over</td>\n                        <td>設定4以上濃厚</td>\n                    </tr>\n                    <tr>\n                        <td>555 over</td>\n       