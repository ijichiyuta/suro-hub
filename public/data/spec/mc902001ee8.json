                   <td class=\"history\">4回前</td>\n                    <td><input type=\"tel\" class=\"game\" name=\"game4\"></td>\n                    <td><input type=\"number\" class=\"samai\" name=\"samai4\"></td>\n                    <td>\n                        <select class=\"mode\" name=\"mode4\">\n                            <option value=\"0\">信長</option>\n                            <option value=\"1\">秀吉</option>\n                            <option value=\"2\">家康</option>\n                        </select>\n                    </td>\n                    <td class=\"result\" id=\"result4\"></td>\n                    <td><input type=\"checkbox\" name=\"fall\" value=\"4\"></td>\n                </tr>\n            </tbody></table>\n            <div class=\"button-row\">\n                <button onclick=\"shiftDown()\" id=\"shiftDown\">上に追加</button>\n                <button onclick=\"shiftUp()\" id=\"shiftUp\">上を削除</button>\n            </div>\n            <div class=\"button-row\">\n                <button onclick=\"addMenuHistory()\" id=\"addMenuHistory\">下に追加</button>\n                <button onclick=\"deleteMenuHistory()\" id=\"deleteMenuHistory\">下を削除</button>\n            </div>\n\n            <table id=\"counter_history\" class=\"history\">\n                <caption>大当たり履歴入力</caption>\n                <tbody><tr>\n                    <th>履歴</th>\n                    <th>通常G数</th>\n                    <th>獲得枚数</th>\n                    <th>有利</th>\n                    <th>転落</th>\n                </tr>\n                <tr class=\"original\">\n                    <td class=\"history\"></td>\n                    <td><input type=\"tel\" class=\"game\"></td>\n                    <td><input type=\"tel\" class=\"samai\"></td>\n                    <td class=\"result\"></td>\n                    <td><input type=\"checkbox\" name=\"fall\"></td>\n                </tr>\n                <tr>\n                    <td class=\"history\">5回前</td>\n                    <td><input type=\"tel\" class=\"game\" name=\"game5\"></td>\n                    <td><input type=\"tel\" class=\"samai\" name=\"samai5\"></td>\n                    <td class=\"result\" id=\"result5\"></td>\n                    <td><input type=\"checkbox\" name=\"fall\" value=\"5\"></td>\n                </tr>\n                <tr>\n                    <td class=\"history\">6回前</td>\n                    <td><input type=\"tel\" class=\"game\" name=\"game6\"></td>\n                    <td><input type=\"tel\" class=\"samai\" name=\"samai6\"></td>\n                    <td class=\"result\" id=\"result6\"></td>\n                    <td><input type=\"checkbox\" name=\"fall\" value=\"6\"></td>\n                </tr>\n                <tr>\n                    <td class=\"history\">7回前</td>\n                    <td><input type=\"tel\" class=\"game\" name=\"game7\"></td>\n                    <td><input type=\"tel\" class=\"samai\" name=\"samai7\"></td>\n                    <td class=\"result\" id=\"result7\"></td>\n                    <td><input type=\"checkbox\" name=\"fall\" value=\"7\"></td>\n                </tr>\n\n            </tbody></table>\n            <div class=\"button-row\">\n                <button onclick=\"addCounterHistory()\" id=\"addCounterHistory\">下に追加</button>\n                <button onclick=\"deleteCounterHistory()\" id=\"deleteCounterHistory\">下を削除</button>\n            </div>\n        </div>\n        \n    </div>\n\n    \n    \n\n    <p class=\"js-menu\">狙い目</p>\n    <div class=\"contents\">\n        <div class=\"left\">\n            <h3 id=\"destination1\">AT間天井狙い</h3>\n            <h4>狙い目</h4>\n            <table border=\"1\">\n                <caption>CZ成功回数0回</caption>\n                <tbody>\n                    <tr>\n                        <th style=\"width: 60%;\">交換率</th>\n                        <th>狙い目</th>\n                    </tr>\n                    <tr>\n                        <td>等価</td>\n                        <td>380Gから</td>\n                    </tr>\n                    <tr>\n                        <td>46貸し51枚交換</td>\n                        <td>450Gから</td>\n                    </tr>\n                    <tr>\n                        <td>50貸し56枚交換</td>\n                        <td>470Gから</td>\n                    </tr>\n                </tbody>\n            </table>\n            <table border=\"1\">\n                <caption>CZ成功回数1回</caption>\n                <tbody>\n                    <tr>\n                        <th style=\"width: 60%;\">交換率</th>\n                        <th>狙い目</th>\n                    </tr>\n                    <tr>\n                        <td>等価</td>\n                        <td>250Gから</td>\n                    </tr>\n                    <tr>\n                        <td>46貸し51枚交換</td>\n                        <td>350Gから</td>\n                    </tr>\n                    <tr>\n                        <td>50貸し56枚交換</td>\n                        <td>370Gから</td>\n                    </tr>\n                </tbody>\n            </table>\n            <table border=\"1\">\n                <caption>CZ成功回数2回</caption>\n                <tbody>\n                    <tr>\n                        <th style=\"width: 60%;\">交換率</th>\n                        <th>狙い目</th>\n                    </tr>\n                    <tr>\n                        <td>不問</td>\n                        <td>0Gから</td>\n                    </tr>\n                </tbody>\n            </table>\n            <h4>やめどき</h4>\n            <p>AT当選まで打ち、AT終了後やめ。</p>\n            <p>天下MAPをチェックし、SPモードや家康AモードであればAT当選までそのまま続行しましょう。</p>\n            <p>以下の狙い目に該当する場合は続行。</p>\n            <ul>\n                <li>モード狙い</li>\n                <li>ゾーン狙い</li>\n            </ul>\n\n            <p>(天下MAP判別について)\n            </p>\n            <p>(信長MAP,\n                秀吉MAP,\n                家康MAPについて)\n            </p>\n        </div>\n\n        <div class=\"left\">\n            <h3 id=\"destination2\">モード狙い</h3>\n            <h4>狙い目</h4>\n            <p>下記条件を一つでも満たした台を0Gから</p>\n            <ul>\n                <li>メニュー画面赤背景，虹背景表示</li>\n                <li>AT終了時ボイスお雪発生</li>\n                <li>特殊ベルフラッシュ②発生</li>\n                <p>(特殊ベルフラッシュについて)</p>\n            </ul>\n\n            <h4>やめどき</h4>\n            <p>AT当選するまで回し、他の狙い目とやめどきをあわせて確認したうえでヤメましょう。</p>\n            <ul>\n                <li>AT間天井狙い</li>\n                <li>ゾーン狙い</li>\n            </ul>\n\n            <h4>解説</h4>\n            <p>メニュー画面は規定ゲーム数を示唆し、AT終了時のボイスは有利区間の引継ぎやモードを示唆、ベル成立時の特殊フラッシュはモードを示唆しています。</p>\n            <p>上記の条件に当てはまり、規定ゲーム数が近い示唆や高モード示唆が出ている台が空いていたら、AT当選まで打ちましょう。</p>\n            <p>(モード示唆について)\n            </p>\n        </div>\n\n        <div class=\"left\">\n            <h3 id=\"destination3\">ゾーン狙い</h3>\n\n            <h4>狙い目</h4>\n            <p>下記条件を一つでも満たした台を0Gから</p>\n            <ul>\n                <li>前回モード秀吉かつメニュー画面緑背景の台</li>\n                <li>前回モード不問でAT終了時ボイス三武将発生台</li>\n                <li>特殊ベルフラッシュ①発生台</li>\n            </ul>\n\n            <div class=\"caution\">\n                <p> 注意\n                </p>\n                <p>有利区間が切れている場合、前回モードをもとにした狙い目は使えなくなります。</p>\n            </div>\n\n            <h4>やめどき</h4>\n            <p>111Gの前兆が終わるまで回し、CZ成功回数が1回以上であればAT当選まで続行します。</p>\n            <p>前兆が終わったあと、そしてAT当選後は、AT間天井の狙い目とやめどきを確認したうえでヤメましょう。</p>\n            <ul>\n                <li>AT間天井狙い</li>\n                <li>モードを考慮した天井狙い</li>\n            </ul>\n\n            <h4>解説</h4>\n            <p>メニュー画面は規定ゲーム数を示唆し、AT終了時のボイスは有利区間の引継ぎやモードを示唆、ベル成立時の特殊フラッシュはモードを示唆しています。</p>\n            <p>上記の条件に該当し、規定G数が近い示唆や高モード示唆が出ている台が空いていたら、111Gまでフォローしましょう。</p>\n            <p>途中でCZを成功させるとAT当選時の獲得枚数が増えるため、AT当選まで打ち切りましょう。</p>\n            <p>(モード示唆について)\n            </p>\n        </div>\n\n        <div class=\"left\">\n            <h3 id=\"destination4\">リセット狙い</h3>\n            <h4>狙い目</h4>\n            <table border=\"1\">\n                <caption>緑背景以上</caption>\n                <tbody>\n                    <tr>\n                        <th>交換率</th>\n                        <th>狙い目</th>\n                    </tr>\n                    <tr>\n                        <td>不問</td>\n                        <td>0Gから</td>\n                    </tr>\n                </tbody>\n            </table>\n\n            <h4>やめどき</h4>\n            <p>赤背景以上であればAT当選まで打ち、AT後は即ヤメでかまいません。</p>\n            <p>緑背景の場合は111Gの前兆が終わるまで回し、CZ成功回数が1回以上ならAT当選まで続行します。</p>\n            <p>AT後は天下MAPを確認し、SPモードや家康AモードならAT当選まで続行しましょう。</p>\n            <h4>解説</h4>\n            <p>メニュー画面による規定ゲーム数やモードの示唆は、リセット台でも有効です。</p>\n            <p>据え置きでも機能するので、朝イチの台はとりあえずチェックしておくとよいでしょう。</p>\n        </div>\n\n        \n    </div>\n</div>","spec":"<div id=\"post\">\n    <div class=\"tab\">\n        \n        <h1 class=\"setting\">設定狙い：設定判別</h1>\n        \n        <p class=\"js-menu\" style=\"display: none;\">まずはココを見ろ！</p>\n        <div class=\"contents\">\n            <div class=\"left\">\n                <img decoding=\"async\" src=\"https://media.slolaboratory.com/wp-content/uploads/2026/04/24005602/noimage1.jpg\" loading=\"lazy\">\n            </div>\n            \n        </div>\n        <p class=\"js-menu\">設定判別項目</p>\n        <div class=\"contents\">\n            <div>\n                <table border=\"1\">\n                    <caption>確定演出</caption>\n                    <tbody>\n                        <tr>\n                            <th>項目</th>\n                            <th>重要度</th>\n                        </tr>\n                        <tr>\n                            <td><img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2022/12/下向きの矢印のアイコン素材.png\" class=\"icon-small\" alt=\"arrow\" loading=\"lazy\">AT終了画面とケロットトロフィー</td>\n                            <td>★★★☆☆</td>\n                        </tr>\n                        <tr>\n                            <td><img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2022/12/下向きの矢印のアイコン素材.png\" class=\"icon-small\" alt=\"arrow\" loading=\"lazy\">エンディング中のランプ</td>\n                            <td>★★☆☆☆</td>\n                        </tr>\n                    </tbody>\n                </table>\n                <table border=\"1\">\n                    <caption>通常時</caption>\n                    <tbody>\n                        <tr>\n                            <th>項目</th>\n                            <th>重要度</th>\n                        </tr>\n                        <tr>\n                            <td><img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2022/12/下向きの矢印のアイコン素材.png\" class=\"icon-small\" alt=\"arrow\" loading=\"lazy\">AT直撃</td>\n                            <td>★★★★☆</td>\n                        </tr>\n                        <tr>\n                            <td><img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2022/12/下向きの矢印のアイコン素材.png\" class=\"icon-small\" alt=\"arrow\" loading=\"lazy\">一騎駆けの武将</td>\n                            <td>★★☆☆☆</td>\n                        </tr>\n                        <tr>\n                            <td><img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2022/12/下向きの矢印のアイコン素材.png\" class=\"icon-small\" alt=\"arrow\" loading=\"lazy\">モード移行率</td>\n                            <td>★★★☆☆</td>\n                        </tr>\n                    </tbody>\n                </table>\n            </div>\n            \n        </div>\n        <p class=\"js-menu\" style=\"display: none;\">ざっくり設定判別</p>\n        <div class=\"contents\">\n            <div class=\"left\">\n                <img decoding=\"async\" src=\"https://media.slolaboratory.com/wp-content/uploads/2026/04/24005602/noimage1.jpg\" loading=\"lazy\">\n            </div>\n            \n        </div>\n        <p class=\"js-menu\">ツモった際のやめ時</p>\n        <div class=\"contents\">\n            <div class=\"left\">\n                <h3>大まかな目安</h3>\n                <h4>やめ推奨時間</h4>\n                <p>閉店の1時間半前を過ぎたタイミングで、メニュー画面が青以下かつモードが悪い状態(有利区間転落後)なら、あるいは信長Aや信長Bを引いてしまったなら、そこでやめるのがよいでしょう。</p>\n                <h4>閉店欠損度</h4>\n                <p>★★★☆☆</p>\n            </div>\n            <div class=\"left\">\n                <h3>解説</h3>\n                <p>本機は6.5号機ということもあり、4000ゲームの有利区間を巧みに使い切っていくタイプの機種です。そのため低モードにいるあいだは出玉を伸ばしにくい仕様となっています。</p>\n                <p>設定が高いほど、有利区間へ突入した段階から秀吉モードへ移行しやすく、いわゆるミミズグラフになりやすい傾向があります。逆に閉店が近づいた場面で信長モードを引いてしまうと厳しい展開になりがちなので、早めに見切ってしまうのも一つの手です。</p>\n\n            </div>\n\n            \n        </div>\n        <p class=\"js-menu\">スペック</p>\n        <div class=\"contents\">\n            <div class=\"left\">\n                <h3>CZ・AT初当り確率</h3>\n                <table border=\"1\">\n                    <tbody>\n                        <tr>\n                            <th>設定</th>\n                            <th>CZ</th>\n                            <th>AT初当り</th>\n                        </tr>\n                        <tr>\n                            <td>設定L</td>\n                            <td>−</td>\n                            <td>−</td>\n                        </tr>\n                        <tr>\n                            <td>設定1</td>\n                            <td>1/116.7</td>\n                            <td>1/374.5</td>\n                        </tr>\n                        <tr>\n                            <td>設定2</td>\n                            <td>1/110.3</td>\n                            <td>1/337.9</td>\n                        </tr>\n                        <tr>\n                            <td>設定4</td>\n                            <td>1/97.7</td>\n                            <td>1/267.7</td>\n                        </tr>\n                        <tr>\n                            <td>設定5</td>\n                            <td>1/86.0</td>\n                            <td>1/206.2</td>\n                        </tr>\n                        <tr>\n                            <td>設定6</td>\n                            <td>1/75.9</td>\n                            <td>1/166.9</td>\n                        </tr>\n                    </tbody>\n                </table>\n\n            </div>\n            <div class=\"left\">\n                <h3>出玉率</h3>\n                <table border=\"1\">\n                    <tbody>\n                        <tr>\n                            <th>設定</th>\n                            <th>出玉率</th>\n                            <th>勝率</th>\n                        </tr>\n                        <tr>\n                            <td>設定L</td>\n                            <td>−</td>\n                            <td>−</td>\n                        </tr>\n                        <tr>\n                            <td>設定1</td>\n                            <td>97.7%</td>\n                            <td>40.2%</td>\n                        </tr>\n                        <tr>\n                            <td>設定2</td>\n                            <td>99.0%</td>\n                            <td>44.7%</td>\n                        </tr>\n                        <tr>\n                            <td>設定4</td>\n                            <td>103.0%</td>\n                            <td>60.6%</td>\n                        </tr>\n                        <tr>\n                            <td>設定5</td>\n                            <td>108.5%</td>\n                            <td>80.3%</td>\n                        </tr>\n                        <tr>\n                            <td>設定6</td>\n                            <td>112.2%</td>\n                            <td>92.8%</td>\n                        </tr>\n                    </tbody>\n                </table>\n                <figcaption class=\"left\">(※)勝率は7000G消化時点</figcaption>\n            </div>\n\n            \n        </div>\n       \n        <p class=\"js-menu\">基本情報</p>\n<div class=\"contents\">\n    <div class=\"left\">\n        <h3>天井・打ち方・詳細情報</h3>\n        <table border=\"1\">\n            <tbody>\n                <tr>\n                    <th style=\"width: 50%;\">項目</th>\n                    <th>記載</th>\n                </tr><tr>\n                    <td><img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2022/12/下向きの矢印のアイコン素材.png\" class=\"icon-small\" alt=\"arrow\" loading=\"lazy\">\n                        天井情報\n                    </td>\n                    <td>AT間天井<br>CZ間天井</td>\n                </tr>\n                <tr>\n                    <td><img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2022/12/下向きの矢印のアイコン素材.png\" class=\"icon-small\" alt=\"arrow\" loading=\"lazy\">\n                        打ち方\n                    </td>\n                    <td>準備中</td>\n                </tr>\n                <tr>\n                    <td><img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2022/12/下向きの矢印のアイコン素材.png\" class=\"icon-small\" alt=\"arrow\" loading=\"lazy\">\n                        ハイエナ詳細情報\n                    </td>\n                    <td>その他のハイエナ情報</td>\n                </tr>\n            </tbody>\n        </table>\n    </div>\n\n    \n</div>\n        <p class=\"js-menu\">数値詳細</p>\n        <div class=\"contents\">\n            <div class=\"left\">\n                <h3 id=\"destination1\">AT終了画面とケロットトロフィー</h3>\n                <p>AT終了画面はデフォルトが3武将で、ここが武具になっていれば高設定示唆となります。</p>\n                <p>また、ケロットトロフィーが出現すれば特定設定以上が濃厚。</p>\n                <table border=\"1\">\n                    <tbody>\n                        <tr>\n                            <th>種類</th>\n                            <th>示唆<br>内容</th>\n                        </tr>\n                        <tr>\n                            <td><img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2023/06/shintenkahubu__19.png\" loading=\"lazy\"><p>三武将</p></td>\n                            <td>デフォルト</td>\n                        </tr>\n                        <tr>\n                            <td><img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2023/06/shintenkahubu__20.png\" loading=\"lazy\"><p>武具</p></td>\n                            <td>高設定示唆</td>\n                        </tr>\n                        <tr>\n                            <td><img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2023/06/shintenkahubu__21.png\" loading=\"lazy\"><p>銅トロフィー</p></td>\n                            <td>設定2以上濃厚</td>\n                        </tr>\n                        <tr>\n                            <td><img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2023/06/shintenkahubu__22.png\" loading=\"lazy\"><p>金トロフィー</p></td>\n                            <td>設定4以上濃厚</td>\n                        </tr>\n                        <tr>\n                            <td><img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2023/06/shintenkahubu__23.png\" loading=\"lazy\"><p>ケロット柄トロフィー</p></td>\n                            <td>設定5以上濃厚</td>\n                        </tr>\n                        <tr>\n                            <td><img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2023/06/shintenkahubu__24.png\" loading=\"lazy\"><p>虹トロフィー</p></td>\n                            <td>設定6濃厚</td>\n                        </tr>\n                    </tbody>\n                </table>\n                <table border=\"1\">\n                    <caption>AT終了画面振り分け</caption>\n                    <tbody>\n                        <tr>\n                            <th>設定</th>\n                            <th>三武将</th>\n                            <th>武具</th>\n                            <th>銅<br>トロフィー</th>\n                        </tr>\n                        <tr>\n                            <td>設定1</td>\n                            <td>80.0％</td>\n                            <td>20.0％</td>\n                            <td>ー</td>\n                        </tr>\n           