{"spec":"<h1 class=\"setting\">機種情報・設定判別</h1>\n\n\n\n\n\n<div id=\"post\" class=\"all-page\">\n    <p class=\"js-menu\">基本情報</p>\n    <div class=\"contents\">\n        <p class=\"js-menu2\">概要</p>\n        <div class=\"contents2\">\n            <section>\n                <h3>概要</h3>\n                <table border=\"1\">\n                    <tbody>\n                        <tr>\n                            <th>機種名</th>\n                            <td>ミスタージャグラー</td>\n                        </tr>\n                        <tr>\n                            <th>メーカー</th>\n                            <td>北電子</td>\n                        </tr>\n                        <tr>\n                            <th>タイプ</th>\n                            <td>ボーナス機</td>\n                        </tr>\n                        <tr>\n                            <th>ボーナス</th>\n                            <td>BIG...約240枚<br>REG...約96枚</td>\n                        </tr>\n                        <tr>\n                            <th>50枚ごとの回転数</th>\n                            <td>約41G</td>\n                        </tr>\n                        <tr>\n                            <th>コイン単価</th>\n                            <td>約2.0円</td>\n                        </tr>\n                        <tr>\n                            <th>導入日</th>\n                            <td>2024年7月22日</td>\n                        </tr>\n                    </tbody>\n                </table>\n            </section>\n            \n        </div>\n\n        <p class=\"js-menu2\" id=\"destination1\">スペック</p>\n        <div class=\"contents2\">\n            <section>\n                <h3>ボーナス確率</h3>\n                <table>\n                    <tbody>\n                        <tr>\n                            <th>設定</th>\n                            <th style=\"width: 25%;\">BIG</th>\n                            <th style=\"width: 25%;\">REG</th>\n                            <th style=\"width: 25%;\">合算</th>\n                        </tr>\n                        <tr>\n                            <td>設定1</td>\n                            <td>1/268.6</td>\n                            <td>1/374.5</td>\n                            <td>1/156.4</td>\n                        </tr>\n                        <tr>\n                            <td>設定2</td>\n                            <td>1/267.5</td>\n                            <td>1/354.2</td>\n                            <td>1/152.4</td>\n                        </tr>\n                        <tr>\n                            <td>設定3</td>\n                            <td>1/260.1</td>\n                            <td>1/331.0</td>\n                            <td>1/145.6</td>\n                        </tr>\n                        <tr>\n                            <td>設定4</td>\n                            <td>1/249.2</td>\n                            <td>1/291.3</td>\n                            <td>1/134.3</td>\n                        </tr>\n                        <tr>\n                            <td>設定5</td>\n                            <td>1/240.9</td>\n                            <td>1/257.0</td>\n                            <td>1/124.4</td>\n                        </tr>\n                        <tr>\n                            <td>設定6</td>\n                            <td>1/237.4</td>\n                            <td>1/237.4</td>\n                            <td>1/118.7</td>\n                        </tr>\n                    </tbody>\n                </table>\n            </section>\n\n            <section>\n                <h3>出玉率</h3>\n                <table>\n                    <tbody>\n                        <tr>\n                            <th>設定</th>\n                            <th style=\"width: 75%;\">出玉率</th>\n                        </tr>\n                        <tr>\n                            <td>設定1</td>\n                            <td>97.0%</td>\n                        </tr>\n                        <tr>\n                            <td>設定2</td>\n                            <td>98.0%</td>\n                        </tr>\n                        <tr>\n                            <td>設定3</td>\n                            <td>99.8%</td>\n                        </tr>\n                        <tr>\n                            <td>設定4</td>\n                            <td>102.7%</td>\n                        </tr>\n                        <tr>\n                            <td>設定5</td>\n                            <td>105.5%</td>\n                        </tr>\n                        <tr>\n                            <td>設定6</td>\n                            <td>107.3%</td>\n                        </tr>\n                    </tbody>\n                </table>\n            </section>\n\n            \n        </div>\n\n\n        <p class=\"js-menu2\" id=\"destination2\">打ち方・リール配列</p>\n        <div class=\"contents2\">\n            <p class=\"js-menu3\">リール配列</p>\n            <div class=\"contents3\">\n                <section>\n                    <h3>リール配列</h3>\n                    <img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2024/07/mrjuggler__38.jpg\" loading=\"lazy\">\n                </section>\n                \n            </div>\n\n            <p class=\"js-menu3\" id=\"destination3\">通常時の打ち方(順押しチェリー狙い)</p>\n            <div class=\"contents3\">\n                <section>\n                    <h3>通常時の打ち方</h3>                \n                    <img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2024/07/mrjuggler__1.jpg\" loading=\"lazy\">\n                    <p>左リールは<b>BAR</b>を目安にチェリーを狙い、中・右リールはフリー打ち。</p>\n        \n                    <div class=\"memo\">\n                        <p> MEMO</p>\n                        <p>ピエロやベルを取りこぼしてしまいますが、チェリーのみをフォローすることで効率よく消化することができます。</p>\n                        <p>ピエロをフォローしたい場合は通常時の打ち方(ピエロ狙い)を参考に消化しましょう。</p>\n                    </div>   \n                </section>\n                \n            </div>\n\n            <p class=\"js-menu3\" id=\"destination4\">通常時の打ち方(順押しピエロ狙い)</p>\n            <div class=\"contents3\">\n                <section>\n                    <h3>通常時の打ち方(ピエロ狙い)</h3>  \n                    <div class=\"caution\">\n                        <p> 注意\n                        </p>\n                        <p>枠上に<b>BAR</b>を狙うとピエロを取りこぼしてしまう可能性があるため、上段に<b>BAR</b>を狙いましょう。</p>\n                    </div>    \n                    <img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2024/07/mrjuggler__39.jpg\" loading=\"lazy\">\n                    <p>左リール上段に<b>チェリーが下に付いている⑭番のBAR</b>狙い。</p>\n                    <div class=\"memo\">\n                        <p> MEMO</p>\n                        <p>特定の<b>BAR</b>を狙うことで、ピエロをフォローすることができます。</p>\n                        <p>全ての小役をフォローしたい場合は通常時の打ち方(中押し赤7狙い)を参考に消化しましょう。</p>\n                    </div>\n        \n                    <h4>停止形A</h4>\n                    <img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2024/07/mrjuggler__42.jpg\" loading=\"lazy\">\n                    <table border=\"1\">\t\t\t\n                        <tbody>\t\t\n                            <tr>\t\n                                <th style=\"width: 25%;\">成立役</th>\n                                <td bgcolor=\"#DDDDDD\">ハズレ・ブドウ・リプレイ</td>\n                            </tr>\t\n                        </tbody>\t\t\n                    </table>\n                    <p>中・右リールはフリー打ち。</p>\n        \n                    <h4>停止形B</h4>\n                    <img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2024/07/mrjuggler__41.jpg\" loading=\"lazy\">\n                    <table border=\"1\">\t\t\t\n                        <tbody>\t\t\n                            <tr>\t\n                                <th style=\"width: 25%;\">成立役</th>\n                                <td bgcolor=\"#DDDDDD\">チェリー</td>\n                            </tr>\t\n                        </tbody>\t\t\n                    </table>\n                    <p>中・右リールはフリー打ち。</p>\n        \n                    <h4>停止形C</h4>\n                    <img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2024/07/mrjuggler__43.jpg\" loading=\"lazy\">\n                    <table border=\"1\">\t\t\t\n                        <tbody>\t\t\n                            <tr>\t\n                                <th style=\"width: 25%;\">成立役</th>\n                                <td bgcolor=\"#DDDDDD\">ブドウ・リプレイ</td>\n                            </tr>\t\n                        </tbody>\t\t\n                    </table>\n                    <p>中・右リールはフリー打ち。</p>\n        \n                    <h4>停止形D</h4>\n                    <img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2024/07/mrjuggler__44.jpg\" loading=\"lazy\">\n                    <table border=\"1\">\t\t\t\n                        <tbody>\t\t\n                            <tr>\t\n                                <th style=\"width: 25%;\">成立役</th>\n                                <td bgcolor=\"#DDDDDD\">ピエロ</td>\n                            </tr>\t\n                        </tbody>\t\t\n                    </table>\n                    <p>中・右リールにピエロ狙い。</p>\n                    <div class=\"memo\">\n                        <p> MEMO</p>\n                        <p>中リールは<b class=\"red\">赤7</b>の4コマ上、右リールは<b>ボーナス図柄</b>を回避して押し、ピエロをフォローましょう。</p>\n                    </div>            \n        \n                    <h4>停止形E</h4>\n                    <img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2024/07/mrjuggler__45.jpg\" loading=\"lazy\">\n                    <table border=\"1\">\t\t\t\n                        <tbody>\t\t\n                            <tr>\t\n                                <th style=\"width: 25%;\">成立役</th>\n                                <td bgcolor=\"#DDDDDD\">ピエロ</td>\n                            </tr>\t\n                        </tbody>\t\t\n                    </table>\n                    <p>中・右リールにピエロ狙い。</p>\n                    <div class=\"memo\">\n                        <p> MEMO</p>\n                        <p>中リールは<b class=\"red\">赤7</b>の4コマ上、右リールは<b>ボーナス図柄</b>を回避して押し、ピエロをフォローましょう。</p>\n                    </div>    \n                    \n                    <h4>停止形F</h4>\n                    <img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2024/07/mrjuggler__40.jpg\" loading=\"lazy\">\n                    <table border=\"1\">\t\t\t\n                        <tbody>\t\t\n                            <tr>\t\n                                <th style=\"width: 25%;\">成立役</th>\n                                <td bgcolor=\"#DDDDDD\">中段チェリー</td>\n                            </tr>\t\n                        </tbody>\t\t\n                    </table>\n                    <p>中・右リールはフリー打ち。</p>\n                </section>\n\n                \n            </div>\n\n            <p class=\"js-menu3\" id=\"destination5\">通常時の打ち方(中押し赤7狙い)</p>\n            <div class=\"contents3\">\n                <section>\n                    <h3>通常時の打ち方(中押し赤7狙い)</h3>     \n                    <div class=\"caution\">\n                        <p> 注意\n                        </p>\n                        <p>枠上に<b class=\"red\">赤7</b>を狙うとピエロを取りこぼしてしまう可能性があるため、上段に<b class=\"red\">赤7</b>を狙いましょう。</p>\n                    </div>           \n                    <img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2024/07/mrjuggler__9.jpg\" loading=\"lazy\">\n                    <p>中リール上段に<b class=\"red\">赤7</b>狙い。</p>\n                   \n                    <h4>停止形A</h4>\n                    <img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2024/07/mrjuggler__10.jpg\" loading=\"lazy\">\n                    <table border=\"1\">\t\t\t\n                        <tbody>\t\t\n                            <tr>\t\n                                <th style=\"width: 25%;\">成立役</th>\n                                <td bgcolor=\"#DDDDDD\">ベル</td>\n                            </tr>\t\n                        </tbody>\t\t\n                    </table>\n                    <p>右リールはフリー打ち、左リールにベル狙い。</p>\n                    <div class=\"memo\">\n                        <p> MEMO</p>\n                        <p>左リールは<b>ピエロが上に付いている</b><b class=\"red\">⑩番の赤7</b>を狙いましょう。</p>\n                    </div>       \n        \n                    <h4>停止形B</h4>\n                    <img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2024/07/mrjuggler__11.jpg\" loading=\"lazy\">\n                    <table border=\"1\">\t\t\t\n                        <tbody>\t\t\n                            <tr>\t\n                                <th style=\"width: 25%;\">成立役</th>\n                                <td bgcolor=\"#DDDDDD\">チェリー・ベル</td>\n                            </tr>\t\n                        </tbody>\t\t\n                    </table>\n                    <p>右リールはフリー打ち、停止形に応じて左リールを打ち分けましょう。</p>\n        \n                    <div class=\"subtitle2\">停止形B-1</div>\n                    <img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2024/07/mrjuggler__13.jpg\" loading=\"lazy\">\n                    <table border=\"1\">\t\t\t\n                        <tbody>\t\t\n                            <tr>\t\n                                <th style=\"width: 25%;\">成立役</th>\n                                <td bgcolor=\"#DDDDDD\">チェリー</td>\n                            </tr>\t\n                        </tbody>\t\t\n                    </table>\n                    <p>左リールは<b>BAR</b>を目安にチェリー狙い。</p>\n        \n                    <div class=\"subtitle2\">停止形B-2</div>\n                    <img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2024/07/mrjuggler__12.jpg\" loading=\"lazy\">\n                    <table border=\"1\">\t\t\t\n                        <tbody>\t\t\n                            <tr>\t\n                                <th style=\"width: 25%;\">成立役</th>\n                                <td bgcolor=\"#DDDDDD\">ベル</td>\n                            </tr>\t\n                        </tbody>\t\t\n                    </table>\n                    <p>左リールはベル狙い。</p>\n                    <div class=\"memo\">\n                        <p> MEMO</p>\n                        <p>左リールは<b>ピエロが上に付いている</b><b class=\"red\">⑩番の赤7</b>を狙いましょう。</p>\n                    </div>       \n        \n                    <h4>停止形C</h4>\n                    <img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2024/07/mrjuggler__14.jpg\" loading=\"lazy\">\n                    <table border=\"1\">\t\t\t\n                        <tbody>\t\t\n                            <tr>\t\n                                <th style=\"width: 25%;\">成立役</th>\n                                <td bgcolor=\"#DDDDDD\">ハズレ・リプレイ</td>\n                            </tr>\t\n                        </tbody>\t\t\n                    </table>\n                    <p>右、左リールはフリー打ち。</p>\n        \n                    <h4>停止形D</h4>\n                    <img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2024/07/mrjuggler__15.jpg\" loading=\"lazy\">\n                    <table border=\"1\">\t\t\t\n                        <tbody>\t\t\n                            <tr>\t\n                                <th style=\"width: 25%;\">成立役</th>\n                                <td bgcolor=\"#DDDDDD\">ブドウ</td>\n                            </tr>\t\n                        </tbody>\t\t\n                    </table>\n                    <p>右、左リールはフリー打ち。</p>\n        \n                    <h4>停止形E</h4>\n                    <img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2024/07/mrjuggler__17.jpg\" loading=\"lazy\">\n                    <table border=\"1\">\t\t\t\n                        <tbody>\t\t\n                            <tr>\t\n                                <th style=\"width: 25%;\">成立役</th>\n                                <td bgcolor=\"#DDDDDD\">ピエロ</td>\n                            </tr>\t\n                        </tbody>\t\t\n                    </table>\n                    <p>右、左リールにピエロ狙い。</p>\n                    <div class=\"memo\">\n                        <p> MEMO</p>\n                        <p>右リールは<b>ボーナス図柄</b>を回避して押し、左リールは<b class=\"red\">赤7</b>を枠上に狙いピエロをフォローしましょう。</p>\n                    </div>              \n                </section>\n                \n            </div>\n\n            <p class=\"js-menu3\" id=\"destination6\">ボーナス入賞手順</p>\n            <div class=\"contents3\">\n                <section>\n                    <h3>ボーナス入賞手順</h3>                \n                    <img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2024/07/mrjuggler__31.jpg\" loading=\"lazy\">\n                    <p>1枚掛けで全リールに<b class=\"red\">赤7</b>を狙い、ボーナスを入賞させましょう。</p>\n        \n                    <div class=\"memo\">\n                        <p> MEMO</p>\n                        <p>本機は小役優先制御のため、小役揃い時は本手順をもう一度行いましょう。</p>\n                    </div>\n                </section>\n                \n            </div>\n\n            <p class=\"js-menu3\" id=\"destination7\">ボーナス中の打ち方</p>\n            <div class=\"contents3\">\n                <section>\n                    <h3>ボーナス中の打ち方</h3>\n                    <p>BIG・REGともに全リールフリー打ちで消化しましょう。</p>\n        \n                    \n                </section>\n                \n            </div>\n\n            <p class=\"js-menu3\" id=\"destination8\">小役の停止形</p>\n            <div class=\"contents3\">\n                <section>\n                    <h3 id=\"destination5\">小役の停止形</h3>\n                    <table border=\"1\">\t\t\t\n                        <tbody>\t\t\n                            <tr>\t\n                                <th style=\"width: 50%;\">チェリー</th>\n                                <th>ベル</th>\n                            </tr>\t\n                            <tr>\n                                <td class=\"bg-white\"><img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2024/07/mrjuggler__32.jpg\" loading=\"lazy\"></td>\n                                <td><img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2024/07/mrjuggler__33.jpg\" loading=\"lazy\"></td>\n                            </tr>\n                            \n                            <tr>\t\n                                <th>ピエロ</th>\n                                <th>チャンス目</th>\n                            </tr>\t\n                            <tr>\n                                <td class=\"bg-white\"><img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2024/07/mrjuggler__46.jpg\" loading=\"lazy\"></td>\n                                <td><img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2024/07/mrjuggler__37.jpg\" loading=\"lazy\"></td>\n                            </tr>\n                            <tr>\t\n                                <th>チャンス目</th>\n                                <th>チャンス目</th>\n                            </tr>\t\n                            <tr>\n                                <td class=\"bg-white\"><img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2024/07/mrjuggler__36.jpg\" loading=\"lazy\"></td>\n                                <td><img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2024/07/mrjuggler__35.jpg\" loading=\"lazy\"></td>\n                            </tr>   \n                            <tr>\t\n                                <th>チャンス目</th>\n                            </tr>\t\n                            <tr>\n                                <td class=\"bg-white\"><img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2024/07/mrjuggler__34.jpg\" loading=\"lazy\"></td>\n                            </tr>     \n                        </tbody>\t\t\n                    </table>\t\t\t        \n                </section>\n\n                \n            </div>\n        </div>\n\n\n        <p class=\"js-menu2\" id=\"destination9\">小役確率</p>\n        <div class=\"contents2\">\n            <section>\n                <h3>小役確率詳細</h3>\n                <p>不明。</p>\n\n            </section>\n\n            <section>\n                <h3>50枚ごとの回転数</h3>\n                <table border=\"1\">\n                    <tbody>\n                        <tr>\n                            <th>設定</th>\n                            <th style=\"width:50%;\">50枚ごとの回転数</th>\n                        </tr>\n                        <tr>\n                            <td>設定1</td>\n                            <td>約41G</td>\n                        </tr>\n                        <tr>\n                            <td>設定2</td>\n                            <td rowspan=\"5\">不明</td>\n                        </tr>\n                        <tr>\n                            <td>設定3</td>\n                        </tr>\n                        <tr>\n                            <td>設定4</td>\n                        </tr>\n                        <tr>\n                            <td>設定5</td>\n                        </tr>\n                        <tr>\n                            <td>設定6</td>\n                        </tr>\n                    </tbody>\n                </table>\n            </section>\n\n            \n\n            \n            \n        </div>\n\n        <p class=\"js-menu2\" id=\"destination10\">天井情報</p>\n        <div class=\"contents2\">\n            <section>\n                <h3>ゲーム数天井</h3>\n                <table border=\"1\">\n                    <tbody>\n                        <tr>\n                            <th style=\"width: 30%;\">天井条件</th>\n                            <td>非搭載</td>\n                        </tr>\n                        <tr>\n                            <th>恩恵</th>\n                            <td>－</td>\n                        </tr>\n                    </tbody>\n                </table>\n            </section>\n\n            \n        </div>\n\n        <p class=\"js-menu2\">有利区間切れ条件・恩恵</p>\n        <div class=\"contents2\">\n            <section>\n                <h3>有利区間切れタイミングについて</h3>\n                <p>本機は有利区間非搭載となります。</p>\n            </section>\n\n            \n        </div>\n        \n        <p class=\"js-menu2\" data-date2=\"2024-09-04\">リセット判別</p>\n        <div class=\"contents2\">\n            <section>\n                <h3 id=\"destination500\">朝イチの挙動</h3>\n                <table border=\"1\">\n                    <tbody>\n                        <tr>\n                            <th>項目</th>\n                            <th style=\"width: 33.3%;\">設定変更</th>\n                            <th style=\"width: 33.3%;\">電源OFF→ON</th>\n                        </tr>\n                        <tr>\n                            <td>天井</td>\n                            <td>－</td>\n                            <td>－</td>\n                        </tr>\n                        \n                        <tr>\n                            <td>リールガックン</td>\n                            <td>無効</td>\n                            <td>－</td>\n                        </tr>\n                    </tbody>\n                </table>\n    \n            </section>\n            \n            \n        </div>\n    </div>\n    \n\n    <p class=\"js-menu\">設定狙い</p>\n    <div class=\"contents\">\n        \n        <p class=\"js-menu2\">設定判別項目</p>\n        <div class=\"contents2\">\n            <section>\n                <h3>通常時</h3>\n                <table border=\"1\">\n                    <tbody>\n                        <tr>\n                            <th style=\"width: 73%;\">項目</th>\n                            <th>重要度</th>\n                        </tr>\n                        <tr>\n                            <td><img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2022/12/下向きの矢印のアイコン素材.png\" class=\"icon-small\" alt=\"arrow\" loading=\"lazy\">ボーナス確率</td>\n                            <td>★★★★☆</td>\n                        </tr>\n                    </tbody>\n                </table>\n            </section>\n            \n            \n        </div>\n\n        \n    </div>\n\n\n    <p class=\"js-menu\">通常時</p>\n    <div class=\"contents\">\n        <p class=\"js-menu2\">通常時の抽選</p>\n        <div class=\"contents2\">\n            <section>\n                <h3>概要</h3>\n                <img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2024/07/mrjuggler__47.jpg\" loading=\"lazy\">\n                <p>通常時は全役でボーナス当選を目指します。</p>\n                <p>GOGO！ランプが点灯すればボーナス当選確定となります。</p>        \n                <div class=\"memo\">\n                    <p> MEMO</p>                \n                    <p>基本的にGOGO!ランプの点灯は全リール停止後に告知されますが、プレミアムパターン発生時は先告知が発生する場合があります。</p>\n                    <p>(プレミアムパターンについて)</p>\n                </div>\n            </section>\n                \n            \n        </div>\n\n        <p class=\"js-menu2\">同時当選について</p>\n        <div class=\"contents2\">\n            <section>\n                <h3>概要</h3>\n                <p>本機では、シリーズおなじみのチェリーとの同時当選を搭載しているほか、ピエロとの同時当選を搭載しています。</p>\n                <p>チェリー成立時に単チェリーや中段チェリーが出現すれば、ボーナス濃厚となります。</p>        \n            </section>\n                \n            \n        </div>\n\n        <p class=\"js-menu2\">ボーナス告知の発生割合</p>\n        <div class=\"contents2\">\n            <section>\n                <h3>概要</h3>\n                <p>ボーナス当選告知は全リール停止後に告知されます。</p>\n                <p>なお、ボーナス成立時の1/2で告知音が発生します。</p>            \n            </section>\n                \n            \n        </div>\n    </div>\n\n    <p class=\"js-menu\">ボーナス</p>\n    <div class=\"contents\">\n        <p class=\"js-menu2\" id=\"destination11\">ビッグボーナス</p>\n        <div class=\"contents2\">\n            <section>\n                <h3>概要</h3>\n                <table border=\"1\">\n                    <tbody>\n                        <tr>\n                            <th>項目</th>\n                            <th style=\"width:50%;\">内容</th>\n                        </tr>\n                        <tr>\n                            <td>図柄</td>\n                            <td>赤7揃い</td>\n                        </tr>\n                        <tr>\n                            <td>獲得枚数</td>\n                            <td>約240枚</td>\n                        </tr>\n                    </tbody>\n                </table>\n                <p>ボーナス中はフリー打ちで消化しましょう。</p>\n            </section>\n\n            \n        </div>\n\n        <p class=\"js-menu2\" id=\"destination12\">レギュラーボーナス</p>\n        <div class=\"contents2\">\n            <section>\n                <h3>概要</h3>\n                <table border=\"1\">\n                    <tbody>\n                        <tr>\n                            <th>項目</th>\n                            <th style=\"width:50%;\">内容</th>\n                        </tr>\n                        <tr>\n                            <td>図柄</td>\n                            <td>赤7・赤7・BAR</td>\n                        </tr>\n                        <tr>\n                            <td>獲得枚数</td>\n                            <td>約96枚</td>\n                        </tr>\n                    </tbody>\n                </table>\n                <p>ボーナス中はフリー打ちで消化しましょう。</p>\n            </section>\n\n            \n        </div>\n    </div>\n\n\n    <p class=\"js-menu\">演出関連</p>\n    <div class=\"contents\">\n        <p class=\"js-menu2\" id=\"destination13\">プレミアム演出</p>\n        <div class=\"contents2\">\n            <section>\n                <h3>概要</h3>\n                <p>発生時点でBIGボーナス濃厚となります。</p>\n\n                <table border=\"1\">\n                    <tbody>\n                        <tr>\n                            <th style=\"width:40%;\">パターン</th>\n                            <th>特徴</th>\n                        </tr>\n                        <tr>\n                            <td>レバーオン消灯</td>\n                            <td>レバーオン時に<br>上下のパネルが消灯</td>\n                        </tr>\n                        <tr>\n                            <td>全消灯</td>\n                            <td>第3停止ボタンを離した直後<br>パネルが全消灯</td>\n                        </tr>\n                        <tr>\n                            <td>下パネル消灯</td>\n                            <td>第1から第3停止時のいずれかで<br>下パネルが消灯</td>\n                        </tr>\n                        <tr>\n                            <td>JUGGLERランプ消灯</td>\n                            <td>各リールを停止させるごとに<br>JUGGLERランプが消灯</td>\n                        </tr>\n                        <tr>\n                            <td>Mr.フラッシュ</td>\n                            <td>第3停止ボタンを離した直後<br>「Mr.」フラッシュが発生</td>\n                        </tr>\n                        <tr>\n                            <td>違和感テンパイ</td>\n                            <td>通常と異なる出目停止時に<br>テンパイ音が発生</td>\n                        </tr>\n                        <tr>\n                            <td>払い出し音変化</td>\n                            <td>ピエロ及びチェリーの<br>払い出し音が変化</td>\n                        </tr>\n                    </tbody>\n                </table>\n            </section>\n\n            \n        </div>\n\n\n        <p class=\"js-menu2\" id=\"destination14\">ボーナス楽曲</p>\n        <div class=\"contents2\">\n            <section>\n                <h3>概要</h3>\n                <p>発生条件を満たすと特定のボーナス楽曲が発生します。</p>\n                <table border=\"1\">\n                    <tbody>\n                        <tr>\n                            <th style=\"width:45%;\">楽曲</th>\n                            <th>条件</th>\n                        </tr>\n                        <tr>\n                            <td>軍艦マーチ</td>\n                            <td>ボーナス後1G目に<br>BIGボーナスが当選</td>\n                        </tr>\n                        <tr>\n                            <td>ラ・カンパネラ</td>\n                            <td rowspan=\"2\">ボーナス後100G以内の<br>ゾロ目ゲーム数で<br>BIGボーナスが当選</td>\n                        </tr>\n                        <tr>\n                            <td>ファランドール</td>\n                        </tr>\n                    </tbody>\n                </table>\n            </section>\n            \n        </div>\n\n        \n    </div>\n</div>","shukei":""}