{"nerai":"","spec":"<div id=\"post\">\n    <div class=\"tab\">\n        \n        <h1 class=\"setting\">設定狙い：設定判別</h1>\n       \n        <p class=\"js-menu\" style=\"display: none;\">まずはココを見ろ！</p>\n        <div class=\"contents\">\n            <div class=\"left\">\n                <h5>①</h5>\n                \n            </div>\n\n            \n        </div>\n\n        <p class=\"js-menu\">設定判別項目</p>\n        <div class=\"contents\">\n            <div>\n                \n                \n                <div class=\"tbl-scroll\"><table border=\"1\">\n                    <caption>ボーナス中</caption>\n                    <tbody>\n                        <tr>\n                            <th style=\"width: 73%;\">項目</th>\n                            <th>重要度</th>\n                        </tr>\n                        <tr>\n                            <td><img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2022/12/下向きの矢印のアイコン素材.png\" class=\"icon-small\" alt=\"arrow\" loading=\"lazy\">ボーナス中のエンジェルランプ</td>\n                            <td>☆☆☆☆☆</td>\n                        </tr>\n                    </tbody>\n                </table></div>\n            </div>\n\n            \n        </div>\n\n        <p class=\"js-menu\" style=\"display: none;\">ざっくり設定判別</p>\n        <div class=\"contents\" style=\"display: none;\">\n            <div class=\"left\">\n                <img decoding=\"async\" src=\"https://media.slolaboratory.com/wp-content/uploads/2026/04/24005602/noimage1.jpg\" loading=\"lazy\">\n            </div>\n            \n        </div>\n        \n        <p class=\"js-menu\">ツモった際のやめ時</p>\n        <div class=\"contents\">\n            <div class=\"left\">\n                <h3>大まかな目安</h3>\n                <h4>やめ推奨時間</h4>\n                <p>閉店時間まで</p>\n                <h4>閉店欠損度</h4>\n                <p>★☆☆☆☆</p>\n            </div>\n\n            <div class=\"left\">\n                <h3>解説</h3>\n                <p>純ノーマルタイプのため最後まで打ってOKです。</p