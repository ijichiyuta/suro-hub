>1/200</td>\n                        </tr>\n                        <tr>\n                            <td>設定3</td>\n                            <td>1/190</td>\n                        </tr>\n                        <tr>\n                            <td>設定4</td>\n                            <td>1/180</td>\n                        </tr>\n                        <tr>\n                            <td>設定5</td>\n                            <td>1/170</td>\n                        </tr>\n                        <tr>\n                            <td>設定6</td>\n                            <td>1/160</td>\n                        </tr>\n                    </tbody>\n                </table></div>\n            </div>\n\n            <div class=\"left\">\n                <h3 id=\"destination3\">小役確率</h3>\n                <p>以下の小役に設定差が存在。</p>\n                <p>なお、ベルは押し順ベルと共通ベルの合算値。</p>\n                <div class=\"tbl-scroll\"><table border=\"1\">\n                    <tbody>\n                        <tr>\n                            <th>設定</th>\n                            <th>ベル</th>\n                            <th>チェリー</th>\n                            <th>スイカ</th>\n                            <th>リーチ目役</th>\n                        </tr>\n                        <tr>\n                            <td>設定1</td>\n                            <td>1/9.0</td>\n                            <td>1/64.0</td>\n                            <td>1/102.4</td>\n                            <td>1/1191.6</td>\n                        </tr>\n                        <tr>\n                            <td>設定2</td>\n                            <td>1/9.0</td>\n                            <td>1/62.5</td>\n                            <td>1/101.1</td>\n                            <td>1/1149.8</td>\n                        </tr>\n                        <tr>\n                            <td>設定3</td>\n                            <td>1/9.0</td>\n                            <td>1/61.1</td>\n                            <td>1/99.9</td>\n                            <td>1/1040.3</td>\n                        </tr>\n                        <tr>\n                            <td>設定4</td>\n                            <td>1/8.8</td>\n                            <td>1/59.8</td>\n                            <td>1/98.7</td>\n                            <td>1/1008.2</td>\n                        </tr>\n                        <tr>\n                            <td>設定5</td>\n                            <td>1/8.7</td>\n                            <td>1/58.5</td>\n                            <td>1/97.5</td>\n                            <td>1/873.8</td>\n                        </tr>\n                        <tr>\n                            <td>設定6</td>\n                            <td>1/8.6</td>\n                            <td>1/57.3</td>\n                            <td>1/96.4</td>\n                            <td>1/840.2</td>\n                        </tr>\n                    </tbody>\n                </table></div>\n            </div>\n\n            <div class=\"left\">\n                <h3 id=\"destination4\">チェリー+REG</h3>\n                <p>チェリーからのボーナス当選率には設定差が存在。</p>\n                <p>高設定ほどREGの割合が高くなっています。</p>\n                <div class=\"tbl-scroll\"><table border=\"1\">\n                    <caption>チェリー成立時のボーナス当選率</caption>\n                    <tbody>\n                        <tr>\n                            <th>設定</th>\n                            <th>当選率</th>\n                        </tr>\n                        <tr>\n                            <td>設定1</td>\n                            <td>3.00%</td>\n                        </tr>\n                        <tr>\n                            <td>設定2</td>\n                            <td>3.20%</td>\n                        </tr>\n                        <tr>\n                            <td>設定3</td>\n                            <td>3.40%</td>\n                        </tr>\n                        <tr>\n                            <td>設定4</td>\n                            <td>3.60%</td>\n                        </tr>\n                        <tr>\n                            <td>設定5</td>\n                            <td>3.80%</td>\n                        </tr>\n                        <tr>\n                            <td>設定6</td>\n                            <td>4.00%</td>\n                        </tr>\n                    </tbody>\n                </table></div>\n                <div class=\"tbl-scroll\"><table border=\"1\">\n                    <caption>チェリーから当選時のボーナス比率</caption>\n                    <tbody>\n                        <tr>\n                            <th>設定</th>\n                            <th>BIG</th>\n                            <th>REG</th>\n                        </tr>\n                        <tr>\n                            <td>設定1</td>\n                            <td>50.0%</td>\n                            <td>50.0%</td>\n                        </tr>\n                        <tr>\n                            <td>設定2</td>\n                            <td>47.6%</td>\n                            <td>52.4%</td>\n                        </tr>\n                        <tr>\n                            <td>設定3</td>\n                            <td>43.5%</td>\n                            <td>56.5%</td>\n                        </tr>\n                        <tr>\n                            <td>設定4</td>\n                            <td>41.7%</td>\n                            <td>58.3%</td>\n                        </tr>\n                        <tr>\n                            <td>設定5</td>\n                            <td>40.0%</td>\n                            <td>60.0%</td>\n                        </tr>\n                        <tr>\n                            <td>設定6</td>\n                            <td>37.0%</td>\n                            <td>63.0%</td>\n                        </tr>\n                    </tbody>\n                </table></div>\n            </div>\n\n            <div class=\"left\">\n                <h3 id=\"destination5\">BIG入賞ライン</h3>\n                <p>BIG時は赤7揃い時のに注目。</p>\n                <p>右上がり入賞時は偶数設定ほど出現しやすくなっている模様。</p>\n                <div class=\"tbl-scroll\"><table border=\"1\">\n                    <tbody>\n                        <tr>\n                            <th>入賞ライン</th>\n                            <th>示唆内容</th>\n                        </tr>\n                        <tr>\n                            <td>中段</td>\n                            <td>デフォルト</td>\n                        </tr>\n                        <tr>\n                            <td>右下がり</td>\n                            <td>示唆なし</td>\n                        </tr>\n                        <tr>\n                            <td>右上がり</td>\n                            <td>偶数設定示唆</td>\n                        </tr>\n                    </tbody>\n                </table></div>\n            </div>\n\n            \n        </div>\n        <p class=\"js-menu\" style=\"display: none;\">高設定狙いに必要な演出法則</p>\n        <div class=\"contents\">\n            <div class=\"left\">\n                <img decoding=\"async\" src=\"https://media.slolaboratory.com/wp-content/uploads/2026/04/24005602/noimage1.jpg\" loading=\"lazy\">\n            </div>\n            \n        </div>\n    </div>\n</div>","shukei":""}