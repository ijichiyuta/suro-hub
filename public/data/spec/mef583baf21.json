r>\n                        <tr>\n                            <td>設定1</td>\n                            <td>97.7%</td>\n                        </tr>\n                        <tr>\n                            <td>設定2</td>\n                            <td>99.2%</td>\n                        </tr>\n                        <tr>\n                            <td>設定3</td>\n                            <td>100.8%</td>\n                        </tr>\n                        <tr>\n                            <td>設定4</td>\n                            <td>102.9%</td>\n                        </tr>\n                        <tr>\n                            <td>設定5</td>\n                            <td>105.2%</td>\n                        </tr>\n                        <tr>\n                            <td>設定6</td>\n                            <td>107.5%</td>\n                        </tr>\n                    </tbody>\n                </table></div>\n            </div>\n\n            \n        </div>\n\n        <p class=\"js-menu\">基本情報</p>\n<div class=\"contents\">\n    <div class=\"left\">\n        <h3>天井・打ち方・詳細情報</h3>\n        <div class=\"tbl-scroll\"><table border=\"1\">\n            <tbody>\n                <tr>\n                    <th style=\"width: 50%;\">項目</th>\n                    <th>記載</th>\n                </tr><tr>\n                    <td><img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2022/12/下向きの矢印のアイコン素材.png\" class=\"icon-small\" alt=\"arrow\" loading=\"lazy\">\n                        天井情報\n                    </td>\n                    <td>ボーナス間天井</td>\n                </tr>\n                <tr>\n                    <td><img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2022/12/下向きの矢印のアイコン素材.png\" class=\"icon-small\" alt=\"arrow\" loading=\"lazy\">\n                        打ち方\n                    </td>\n                    <td>準備中</td>\n                </tr>\n                <tr>\n                    <t