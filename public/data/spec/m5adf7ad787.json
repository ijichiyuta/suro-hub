{"nerai":"","spec":"<div id=\"post\">\n    <div class=\"tab\">\n        \n        <h1 class=\"setting\">設定狙い：設定判別</h1>\n       \n        <p class=\"js-menu\" style=\"display: none;\">まずはココを見ろ！</p>\n        <div class=\"contents\">\n            <div class=\"left\">\n                <h5>①</h5>\n                \n            </div>\n\n            \n        </div>\n\n        <p class=\"js-menu\">設定判別項目</p>\n        <div class=\"contents\">\n            <div>\n                \n                \n                <div class=\"tbl-scroll\"><table border=\"1\">\n                    <caption>ボーナス中</caption>\n                    <tbody>\n                        <tr>\n                            <th style=\"width: 73%;\">項目</th>\n                            <th>重要度</th>\n                        </tr>\n                        <tr>\n                            <td><img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2022/12/下向きの矢印のアイコン素材.png\" class=\"icon-small\" alt=\"arrow\" loading=\"lazy\">BIG中のスイカ確率</td>\n                            <td>★★★☆☆</td>\n                        </tr>\n                        <tr>\n                            <td><img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2022/12/下向きの矢印のアイコン素材.png\" class=\"icon-small\" alt=\"arrow\" loading=\"lazy\">REG中の設定示唆</td>\n                            <td>★★☆☆☆</td>\n                        </tr>\n                        <tr>\n                            <td><img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2022/12/下向きの矢印のアイコン素材.png\" class=\"icon-small\" alt=\"arrow\" loading=\"lazy\">ボーナス終了時のフェザーランプ</td>\n                            <td>★★★☆☆</td>\n                        </tr>\n                    </tbody>\n                </table></div>\n            </div>\n\n            \n        </div>\n\n        <p class=\"js-menu\" style=\"display: none;\">ざっくり設定判別</p>\n        <div class=\"contents\" style=\"display: none;\">\n            <div class=\"left\">\n                <img decoding=\"async\" src=\"https://media.slolaboratory.com/wp-content/uploads/2026/04/24005602/noimage1.jpg\" loading=\"lazy\">\n            </div>\n            \n        </div>\n        \n        <p class=\"js-menu\"><img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2023/10/new-7.png\" alt=\"new\" class=\"update-icon\" data-date=\"2024-01-06\" loading=\"lazy\">ツモった際のやめ時</p>\n        <div class=\"contents\">\n            <div class=\"left\">\n                <h3>大まかな目安</h3>\n                \n                <h4>やめ推奨時間</h4>\n                <p>閉店時間まで</p>\n                <h4>閉店欠損度</h4>\n                <p>★☆☆☆☆</p>\n            </div>\n\n            <div class=\"left\">\n                <h3>解説</h3>\n                \n                <p>純ノーマルタイプのため最後まで打ってOKです。</p>\n                <p>閉店の1時間〜1時間半ほど前になったら、ホール全体を一度ざっと見て回り、今よりも時給の高いエナ台が空いていないかを必ずチェックしておきましょう。</p>\n            </div>\n\n            \n        </div>\n\n        <p class=\"js-menu\">スペック</p>\n        <div class=\"contents\">\n            <div class=\"left\">\n                <h3>ボーナス確率</h3>\n                <div class=\"tbl-scroll\"><table border=\"1\">\n                    <tbody>\n                        <tr>\n                            <th>設定</th>\n                            <th style=\"width:25%;\">BIG</th>\n                            <th style=\"width:25%;\">REG</th>\n                            <th style=\"width:25%;\">合算</th>\n                        </tr>\n                        <tr>\n                            <td>設定1</td>\n                            <td>1/256</td>\n                            <td>1/642</td>\n                            <td>1/183</td>\n                        </tr>\n                        <tr>\n                            <td>設定2</td>\n                            <td>1/246</td>\n                            <td>1/585</td>\n                            <td>1/173</td>\n                        </tr>\n                        <tr>\n                            <td>設定3</td>\n                            <td>1/235</td>\n                            <td>1/537</td>\n                            <td>1/163</td>\n                        </tr>\n                        <tr>\n                            <td>設定4</td>\n                            <td>1/224</td>\n                            <td>1/489</td>\n                            <td>1/153</td>\n                        </tr>\n                        <tr>\n                            <td>設定5</td>\n                            <td>1/212</td>\n                            <td>1/442</td>\n                            <td>1/143</td>\n                        </tr>\n                        <tr>\n                            <td>設定6</td>\n                            <td>1/199</td>\n                            <td>1/399</td>\n                            <td>1/133</td>\n                        </tr>\n                    </tbody>\n                </table></div>\n            </div>\n\n            <div class=\"left\">\n                <h3>出玉率</h3>\n                <div class=\"tbl-scroll\"><table border=\"1\">\n                    <tbody>\n                        <tr>\n                            <th style=\"width:25%;\">設定</th>\n                            <th>出玉率</th>\n                        </tr>\n                        <tr>\n                            <td>設定1</td>\n                            <td>97%</td>\n                        </tr>\n                        <tr>\n                            <td>設定2</td>\n                            <td>99%</td>\n                        </tr>\n                        <tr>\n                            <td>設定3</td>\n                            <td>101%</td>\n                        </tr>\n                        <tr>\n                            <td>設定4</td>\n                            <td>104%</td>\n                        </tr>\n                        <tr>\n                            <td>設定5</td>\n                            <td>107%</td>\n                        </tr>\n                        <tr>\n                            <td>設定6</td>\n                            <td>110%</td>\n                        </tr>\n                    </tbody>\n                </table></div>\n            </div>\n            \n            \n        </div>\n\n        <p class=\"js-menu\">基本情報</p>\n        <div class=\"contents\">\n            <div class=\"left\">\n                <h3>天井・打ち方・詳細情報</h3>\n                <div class=\"tbl-scroll\"><table border=\"1\">\n                    <tbody>\n                        <tr>\n                            <th style=\"width: 50%;\">項目</th>\n                            <th>記載</th>\n                        </tr><tr>\n                            <td><img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2022/12/下向きの矢印のアイコン素材.png\" class=\"icon-small\" alt=\"arrow\" loading=\"lazy\">天井情報</td>\n                            <td>非搭載</td>\n                        </tr>\n                        <tr>\n                            <td><img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2022/12/下向きの矢印のアイコン素材.png\" class=\"icon-small\" alt=\"arrow\" loading=\"lazy\">打ち方</td>\n                            <td>通常時の打ち方<br>ボーナス中の打ち方</td>\n                        </tr>\n                        <tr>\n                            <td><img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2022/12/下向きの矢印のアイコン素材.png\" class=\"icon-small\" alt=\"arrow\" loading=\"lazy\">ハイエナ詳細情報</td>\n                            <td>その他のハイエナ情報</td>\n                        </tr>\n                    </tbody>\n                </table></div>\n            </div>\n\n            \n        </div>\n    \n        <p class=\"js-menu\">数値詳細</p>\n        <div class=\"contents\">\n            <div class=\"left\">\n                <h3 id=\"destination1\">BIG中のスイカ確率</h3>\n                <p>BIG中に成立するスイカの確率については、設定によって差が付いているようです。細かい部分は現在調査を進めています。</p>\n                <p>(前作情報の参考数値)</p>\n            </div>\n\n            <div class=\"left\">\n                <h3 id=\"destination2\">REG中の設定示唆</h3>\n                <p>REG中にビタ押しでスイカを揃えると、入賞と同時にサイドランプが光ります。この点灯色が設定を示唆する仕組みです。</p>\n                <p>(REG中の打ち方について)</p>\n                <div class=\"tbl-scroll\"><table border=\"1\">\n                    <tbody>\n                        <tr>\n                            <th>ランプ色</th>\n                            <th style=\"width:50%;\">示唆内容</th>\n                        </tr>\n                        <tr>\n                            <td>青</td>\n                            <td>奇数設定示唆</td>\n                        </tr>\n                        <tr>\n                            <td>黄</td>\n                            <td>偶数設定示唆</td>\n                        </tr>\n                        <tr>\n                            <td>緑</td>\n                            <td>奇数+高設定示唆</td>\n                        </tr>\n                        <tr>\n                            <td>赤</td>\n                            <td>偶数+高設定示唆</td>\n                        </tr>\n                        <tr>\n                            <td>虹</td>\n                            <td>高設定示唆</td>\n                        </tr>\n                    </tbody>\n                </table></div>\n            </div>\n\n            <div class=\"left\">\n                <h3 id=\"destination3\">ボーナス終了時のフェザーランプ</h3>\n                <p>ボーナスが終わると筐体の上部にあるフェザーランプが点灯し、その色によって設定が示唆されます。</p>\n                <p>ただし設定変更後の1回目、そのBIGが終了したタイミングに限っては、設定示唆が行われません。</p>\n\n                <p>(前作情報の参考数値)</p>\n                <div class=\"tbl-scroll\"><table border=\"1\">\n                    <caption>BIG終了時</caption>\n                    <tbody>\n                        <tr>\n                            <th>ランプ色</th>\n                            <th style=\"width:50%;\">高設定期待度</th>\n                        </tr>\n                        <tr>\n                            <td>白</td>\n                            <td>デフォルト</td>\n                        </tr>\n                        <tr>\n                            <td>青</td>\n                            <td>低</td>\n                        </tr>\n                        <tr>\n                            <td>黄</td>\n                            <td>↓</td>\n                        </tr>\n                        <tr>\n                            <td>緑</td>\n                            <td>↓</td>\n                        </tr>\n                        <tr>\n                            <td>赤</td>\n                            <td>↓</td>\n                        </tr>\n                        <tr>\n                            <td>虹</td>\n                            <td>高</td>\n                        </tr>\n                    </tbody>\n                </table></div>\n\n                <div class=\"tbl-scroll\"><table border=\"1\">\n                    <caption>REG終了時</caption>\n                    <tbody>\n                        <tr>\n                            <th>ランプ色</th>\n                            <th style=\"width:50%;\">高設定期待度</th>\n                        </tr>\n                        <tr>\n                            <td>白</td>\n                            <td>デフォルト</td>\n                        </tr>\n                        <tr>\n                            <td>青</td>\n                            <td>設定2以上濃厚</td>\n                        </tr>\n                        <tr>\n                            <td>黄</td>\n                            <td>設定3以上濃厚</td>\n                        </tr>\n                        <tr>\n                            <td>緑</td>\n                            <td>\n                                <font color=\"blue\">設定4以上濃厚</font>\n                            </td>\n                        </tr>\n                        <tr>\n                            <td>赤</td>\n                            <td>\n                                <font color=\"red\">設定5以上濃厚</font>\n                            </td>\n                        </tr>\n                        <tr>\n                            <td>虹</td>\n                            <td>\n                                <font color=\"purple\">設定6濃厚</font>\n                            </td>\n                        </tr>\n                    </tbody>\n                </table></div>\n\n            </div>\n\n            \n        </div>\n\n\n        <p class=\"js-menu\" id=\"destination50\">前作情報</p>\n        <div class=\"contents\">\n            <div class=\"left\">\n                <h3>概要</h3>\n                <p>ここに載せているのは前作キングハナハナの数値です。あくまで参考としてご覧ください。</p>\n                <ul>\n                    <li>BIG中のスイカ確率</li>\n                    <li>REG中のサイドランプ</li>\n                    <li>ボーナス中のBGM</li>\n                    <li>ボーナス終了時のフェザーランプ</li>                    \n            </ul></div>\n\n            <div class=\"left\">\n                <h3 id=\"destination51\">BIG中のスイカ確率</h3>\n                <p>BIG中のスイカ確率には設定差があります。これまでのシリーズと同じ傾向なら、約1/32から約1/47ほどの幅で差が生じます。</p>\n            </div>\n\n            <div class=\"left\">\n                <h3 id=\"destination52\">REG中のサイドランプ</h3>\n                <p>REG中にビタ押しでスイカを揃えると、スイカ入賞のタイミングでサイドランプが点灯します。この色が設定を示唆しています。</p>\n                <div class=\"tbl-scroll\"><table border=\"1\">\n                    <tbody>\n                        <tr>\n                            <th>ランプ色</th>\n                            <th style=\"width:50%;\">示唆内容</th>\n                        </tr>\n                        <tr>\n                            <td>青</td>\n                            <td>奇数設定期待度アップ</td>\n                        </tr>\n                        <tr>\n                            <td>黄</td>\n                            <td>偶数設定期待度アップ</td>\n                        </tr>\n                        <tr>\n                            <td>緑</td>\n                            <td>奇数設定期待度アップ</td>\n                        </tr>\n                        <tr>\n                            <td>赤</td>\n                            <td>偶数設定期待度アップ</td>\n                        </tr>\n                        <tr>\n                            <td>虹</td>\n                            <td>高設定期待度アップ</td>\n                        </tr>\n                    </tbody>\n                </table></div>\n            </div>\n\n            <div class=\"left\">\n                <h3 id=\"destination53\">ボーナス中のBGM</h3>\n                <p>ボーナス後100G以内にBIGが2連以上した場合、レトロサウンド(下パネル消灯)が発生するかどうかの抽選が行われます。</p>\n                <p>このレトロサウンドが発生する確率にも、設定による差が設定されているようです。</p>\n                <div class=\"caution\">\n                    <p> 注意</p>\n                    <p>なおBIG5連以降になると「ロックアレンジVer.」に切り替わるので、サンプルを取る際は対象から外しましょう。</p>\n                </div>\n            </div>\n\n            <div class=\"left\">\n                <h3 id=\"destination54\">ボーナス終了時のフェザーランプ</h3>\n                <p>ボーナス終了後には筐体上部のフェザーランプが光り、その点灯色から設定が示唆されます。</p>\n                <div class=\"tbl-scroll\"><table border=\"1\">\n                    <caption>BIG終了時</caption>\n                    <tbody>\n                        <tr>\n                            <th>ランプ色</th>\n                            <th style=\"width:50%;\">高設定期待度</th>\n                        </tr>\n                        <tr>\n                            <td>白</td>\n                            <td>低</td>\n                        </tr>\n                        <tr>\n                            <td>青</td>\n                            <td>↓</td>\n                        </tr>\n                        <tr>\n                            <td>黄</td>\n                            <td>↓</td>\n                        </tr>\n                        <tr>\n                            <td>緑</td>\n                            <td>↓</td>\n                        </tr>\n                        <tr>\n                            <td>赤</td>\n                            <td>↓</td>\n                        </tr>\n                        <tr>\n                            <td>虹</td>\n                            <td>高</td>\n                        </tr>\n                    </tbody>\n                </table></div>\n\n                <div class=\"tbl-scroll\"><table border=\"1\">\n                    <caption>REG終了時</caption>\n                    <tbody>\n                        <tr>\n                            <th>ランプ色</th>\n                            <th style=\"width:50%;\">高設定期待度</th>\n                        </tr>\n                        <tr>\n                            <td>白</td>\n                            <td>デフォルト</td>\n                        </tr>\n                        <tr>\n                            <td>青</td>\n                            <td>設定2以上濃厚</td>\n                        </tr>\n                        <tr>\n                            <td>黄</td>\n                            <td>設定3以上濃厚</td>\n                        </tr>\n                        <tr>\n                            <td>緑</td>\n                            <td><font color=\"blue\">設定4以上濃厚</font></td>\n                        </tr>\n                        <tr>\n                            <td>赤</td>\n                            <td><font color=\"red\">設定5以上濃厚</font></td>\n                        </tr>\n                        <tr>\n                            <td>虹</td>\n                            <td><font color=\"purple\">設定6濃厚</font></td>\n                        </tr>\n                    </tbody>\n                </table></div>\n            </div>\n\n            \n        </div>\n\n\n        <p class=\"js-menu\" style=\"display: none;\">高設定狙いに必要な演出法則</p>\n        <div class=\"contents\" style=\"display: none;\">\n            <div class=\"left\">\n                <img decoding=\"async\" src=\"https://media.slolaboratory.com/wp-content/uploads/2026/04/24005602/noimage1.jpg\" loading=\"lazy\">\n            </div>\n           \n            \n        </div>\n        \n    </div>\n</div>","shukei":""}