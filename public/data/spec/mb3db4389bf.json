>10.0%</td>\n                            <td>−</td>\n                            <td>−</td>\n                            <td>−</td>\n                        </tr>\n                        <tr>\n                            <td>設定3</td>\n                            <td>−</td>\n                            <td>−</td>\n                            <td>−</td>\n                        </tr>\n                        <tr>\n                            <td>設定4</td>\n                            <td>80,0%</td>\n                            <td rowspan=\"3\">10.0%</td>\n                            <td>−</td>\n                            <td>−</td>\n                        </tr>\n                        <tr>\n                            <td>設定5</td>\n                            <td>75.0%</td>\n                            <td rowspan=\"2\">5.0%</td>\n                            <td>−</td>\n                        </tr>\n                        <tr>\n                            <td>設定6</td>\n                            <td>70.0%</td>\n                            <td>5.0%</td>\n                        </tr>\n                    </tbody>\n                </table>\n                <table border=\"1\">\n                    <caption>7000ゲーム消化後</caption>\n                    <tbody>\n                        <tr>\n                            <th style=\"width: 10%;\">設定</th>\n                            <th style=\"width: 18%;\">吉宗①</th>\n                            <th style=\"width: 18%;\">姫</th>\n                            <th style=\"width: 18%;\">ﾁﾋﾞ姫</th>\n                            <th style=\"width: 18%;\">3人</th>\n                            <th>全員</th>\n                        </tr>\n                        <tr>\n                            <td>設定1</td>\n                            <td>100%</td>\n                            <td>−</td>\n                            <td>−</td>\n                            <td>−</td>\n                            <td>−</td>\n                        </tr>\n                        <tr>\n                            <td>設定2</td>\n                            <td rowspan=\"2\">97.0%</td>\n                            <td rowspan=\"5\">3.0%</td>\n                            <td>−</td>\n                            <td>−</td>\n                            <td>−</td>\n                        </tr>\n                        <tr>\n                            <td>設定3</td>\n                            <td>−</td>\n                            <td>−</td>\n                            <td>−</td>\n                        </tr>\n                        <tr>\n                            <td>設定4</td>\n                            <td>57.0%</td>\n                            <td>40.0%</td>\n                            <td>−</td>\n                            <td>−</td>\n                        </tr>\n                        <tr>\n                            <td>設定5</td>\n                            <td>54.5%</td>\n                            <td rowspan=\"2\">12.5%</td>\n                            <td>30.0%</td>\n                            <td>−</td>\n                        </tr>\n                        <tr>\n                            <td>設定6</td>\n                            <td>47.0%</td>\n                            <td>12.5%</td>\n                            <td>25.0%</td>\n                        </tr>\n                    </tbody>\n                </table>\n            </div>\n\n\n\n            <div class=\"left\">\n                <h3 id=\"destination2\">エンディング中のボイス</h3>\n                <img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2023/12/yoshimunerising__11.png\" loading=\"lazy\">\n                <p>エンディング中のレア役成立時にPUSHボタンを押すとボイスが発生し、種類によって設定を示唆しています。</p>\n                <table border=\"1\">\n                    <tbody>\n                        <tr>\n                            <th style=\"width:65%;\">ボイス</th>\n                            <th>示唆</th>\n                        </tr>\n                        <tr>\n                            <td>さあさあ！</td>\n                            <td>デフォルト</td>\n                        </tr>\n                        <tr>\n                            <td>てやんでぇぃ！</td>\n                            <td>デフォルト</td>\n                        </tr>\n                        <tr>\n                            <td>さあさあさあさあ！</td>\n                            <td>奇数設定示唆</td>\n                        </tr>\n                        <tr>\n                            <td>宵越しの銭はもたねぇぃ！</td>\n                            <td>偶数設定示唆</td>\n                        </tr>\n                        <tr>\n                            <td>とーんときたねぇぃ！</td>\n                            <td>高設定示唆(弱)</td>\n                        </tr>\n                        <tr>\n                            <td>とーんとおっこちきる<br>ってもんよ！</td>\n                            <td>高設定示唆(強)</td>\n                        </tr>\n                        <tr>\n                            <td>親父の顔色を伺って、<br>誰も俺自身を見てくれない<br>将軍としての存在感が、<br>日に日に薄れていく</td>\n                            <td>設定2以上<br>濃厚</td>\n                        </tr>\n                        <tr>\n                            <td>ため息まじりの、はっけよい<br>寂しい気持ちが、残った残った</td>\n                            <td>\n                                <font color=\"blue\">設定4以上<br>濃厚</font>\n                            </td>\n                        </tr>\n                        <tr>\n                            <td>端正な顔立ち、徳川家の財力<br>僕は全てを持っているのさ</td>\n                            <td>\n                                <font color=\"purple\">設定6濃厚</font>\n                            </td>\n                        </tr>\n                    </tbody>\n                </table>\n            </div>\n\n\n\n            \n            <div class=\"left\">\n                <h3 id=\"destination3\">共通俵</h3>\n                <p>左リール第1停止から揃う13枚払い出しの俵が共通俵となります。</p>\n                <p>高設定ほど、出現しやすいためカウントしましょう。</p>\n                <table border=\"1\">\n                    <tbody>\n                        <tr>\n                            <th>設定</th>\n                            <th style=\"width:50%;\">出現率</th>\n                        </tr>\n                        <tr>\n                            <td>設定1</td>\n                            <td>1/630.2</td>\n                        </tr>\n                        <tr>\n                            <td>設定2</td>\n                            <td>1/585.1</td>\n                        </tr>\n                        <tr>\n                            <td>設定3</td>\n                            <td>1/546.1</td>\n                        </tr>\n                        <tr>\n                            <td>設定4</td>\n                            <td>1/496.5</td>\n                        </tr>\n                        <tr>\n                            <td>設定5</td>\n                            <td>1/455.1</td>\n                        </tr>\n                        <tr>\n                            <td>設定6</td>\n                            <td>1/399.6</td>\n                        </tr>\n                    </tbody>\n                </table>\n            </div>\n\n            <div class=\"left\">\n                <h3 id=\"destination4\">弱レア役からの当選率</h3>\n                <p>同行者がいない場合の弱レア役からの初当り当選率に設定差があり、設定1と設定6で「約2倍」の設定差ある模様です。</p>\n                <p>また、同行者が1人いる場合の対応役からの初当り当選率にも「約1.5倍」の設定差があるようです。</p>\n                <table border=\"1\">\n                    <caption>弱レア役からの当選率</caption>\n                    <tbody>\n                        <tr>\n                            <th style=\"width: 20%;\">設定</th>\n                            <th style=\"width: 40%;\">仲間同行なし</th>\n                            <th>仲間一人同行</th>\n                        </tr>\n                        <tr>\n                            <td>設定1</td>\n                            <td>0.9%</td>\n                            <td>10.7%</td>\n                        </tr>\n                        <tr>\n                            <td>設定2</td>\n                            <td>1.1%</td>\n                            <td>11.3%</td>\n                        </tr>\n                        <tr>\n                            <td>設定3</td>\n                            <td>1.3%</td>\n                            <td>12.3%</td>\n                        </tr>\n                        <tr>\n                            <td>設定4</td>\n                            <td>1.8%</td>\n                            <td>14.4%</td>\n                        </tr>\n                        <tr>\n                            <td>設定5</td>\n                            <td>2.0%</td>\n                            <td>15.0%</td>\n                        </tr>\n                        <tr>\n                            <td>設定6</td>\n                            <td>2.0%</td>\n                            <td>15.2%</td>\n                        </tr>\n                    </tbody>\n                </table>\n                <p>その他設定差のないレア役の当選率はこちら\n                </p>\n            </div>\n\n            <div class=\"left\">\n                <h3 id=\"destination5\"><img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2023/10/new-7.png\" alt=\"new\" class=\"update-icon\" data-date=\"2024-02-01\" loading=\"lazy\">AT謎当たり</h3>\n                <div class=\"update-date\" data-date=\"2024-02-01\">2024/02/01更新</div>\n                <p>通常時は毎ゲームハズレ成立時にAT抽選が行われており、大きな設定差が存在しているため要注目となります。</p>\n                <p>レア役がなく、ゾーン外で前兆が始まれば謎当たりに期待できます。</p>\n                <table border=\"1\">\n                    <tbody>\n                        <tr>\n                            <th style=\"width: 50%;\">設定</th>\n                            <th>出現率</th>\n                        </tr>\n                        <tr>\n                            <td>設定1</td>\n                            <td>1/10508.1</td>\n                        </tr>\n                        <tr>\n                            <td>設定2</td>\n                            <td>1/9015.3</td>\n                        </tr>\n                        <tr>\n                            <td>設定3</td>\n                            <td>1/5528.8</td>\n                        </tr>\n                        <tr>\n                            <td>設定4</td>\n                            <td>1/3123.0</td>\n                        </tr>\n                        <tr>\n                            <td>設定5</td>\n                            <td>1/2155.6</td>\n                        </tr>\n                        <tr>\n                            <td>設定6</td>\n                            <td>1/1594.1</td>\n                        </tr>\n                    </tbody>\n                </table>\n            </div>\n\n\n            \n            <div class=\"left\">\n                <h3 id=\"destination6\"><img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2023/10/new-7.png\" alt=\"new\" class=\"update-icon\" data-date=\"2024-02-01\" loading=\"lazy\">将軍ボーナスからのAT当選</h3>\n                <div class=\"update-date\" data-date=\"2024-02-01\">2024/02/01更新</div>\n                <p>将軍ボーナス終了後の高確率からのAT当選率に設定差があります。</p>\n                <p>下記表はレア役からの当選も含まれた数字となっております。</p>\n\n                <table border=\"1\">\n                    <tbody>\n                        <tr>\n                            <th>設定</th>\n                            <th>当選率</th>\n                        </tr>\n                        <tr>\n                            <td>設定1</td>\n                            <td>10.6%</td>\n                        </tr>\n                        <tr>\n                            <td>設定2</td>\n                            <td>11.8%</td>\n                        </tr>\n                        <tr>\n                            <td>設定3</td>\n                            <td>13.6%</td>\n                        </tr>\n                        <tr>\n                            <td>設定4</td>\n                            <td>16.5%</td>\n                        </tr>\n                        <tr>\n                            <td>設定5</td>\n                            <td>16.8%</td>\n                        </tr>\n                        <tr>\n                            <td>設定6</td>\n                            <td>17.0%</td>\n                        </tr>\n                    </tbody>\n                </table>\n            </div>\n\n\n\n            <button class=\"close\">ー閉じる</button>\n        </div>\n\n        <p class=\"js-menu\" style=\"display: none;\">高設定狙いに必要な演出法則</p>\n        <div class=\"contents\" style=\"display: none;\">\n            <div class=\"left\">\n                <img decoding=\"async\" src=\"https://media.slolaboratory.com/wp-content/uploads/2026/04/24005602/noimage1.jpg\" loading=\"lazy\">\n            </div>\n\n            <button class=\"close\">ー閉じる</button>\n        </div>\n\n        <p class=\"js-menu\">前作情報(吉宗3)</p>\n        <div class=\"contents\">\n            <div class=\"left\">\n                <h3>越後屋悪代官ランプ</h3>\n                <p>設定変更後の遊技中(1-66G)に点灯することがあり、設定示唆法則が存在しています。</p>\n                <p>設定2以上に変更された際の点灯率は約25%となっています。</p>\n                <table border=\"1\">\n                    <caption>越後屋悪代官ランプによる<br>朝イチの設定示唆</caption>\n                    <tbody>\n                        <tr>\n                            <th style=\"width: 50%;\">朝イチ回転数</th>\n                            <th>示唆内容</th>\n                        </tr>\n                        <tr>\n                            <td>66G以内に点灯</td>\n                            <td>設定2以上確定</td>\n                        </tr>\n                        <tr>\n                            <td>44Gに点灯</td>\n                            <td>設定4以上確定</td>\n                        </tr>\n                        <tr>\n                            <td>55Gに点灯</td>\n                            <td>設定5以上確定</td>\n                        </tr>\n                        <tr>\n                            <td>66Gに点灯</td>\n                            <td>設定6確定</td>\n                        </tr>\n                    </tbody>\n                </table>\n                <p>設定示唆は複合する場合があります。</p>\n            </div>\n            <div class=\"left\">\n                <h3>鷹狩り</h3>\n                <p>突入時典でBB濃厚となる激アツの前兆ゾーン。</p>\n                <p>前作吉宗3では高設定ほど出現しやすくなっています。</p>\n                <table border=\"1\">\n                    <caption>鷹狩り出現率</caption>\n                    <tbody>\n                        <tr>\n                            <th style=\"width: 50%;\">設定</th>\n                            <th>出現率</th>\n                        </tr>\n                        <tr>\n                            <td>設定1</td>\n                            <td>1/30167</td>\n                        </tr>\n                        <tr>\n                            <td>設定2</td>\n                            <td>1/19903</td>\n                        </tr>\n                        <tr>\n                            <td>設定3</td>\n                            <td>1/10626</td>\n                        </tr>\n                        <tr>\n                            <td>設定4</td>\n                            <td>1/6448</td>\n                        </tr>\n                        <tr>\n                            <td>設定5</td>\n                            <td>1/7550</td>\n                        </tr>\n                        <tr>\n                            <td>設定6</td>\n                            <td>1/3429</td>\n                        </tr>\n                    </tbody>\n                </table>\n            </div>\n\n\n            <button class=\"close\">ー閉じる</button>\n        </div>\n\n    </div>\n</div>","shukei":""}