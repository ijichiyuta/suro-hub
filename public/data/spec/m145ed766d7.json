    <table border=\"1\">\n                    <tbody>\n                        <tr>\n                            <th>設定</th>\n                            <th style=\"width:72%;\">出玉率</th>\n                        </tr>\n                        <tr>\n                            <td>設定L</td>\n                            <td>－</td>\n                        </tr>\n                        <tr>\n                            <td>設定1</td>\n                            <td>97.4%</td>\n                        </tr>\n                        <tr>\n                            <td>設定2</td>\n                            <td>99.1%</td>\n                        </tr>\n                        <tr>\n                            <td>設定4</td>\n                            <td>101.1%</td>\n                        </tr>\n                        <tr>\n                            <td>設定5</td>\n                            <td>104.1%</td>\n                        </tr>\n                        <tr>\n                            <td>設定6</td>\n                            <td>106.4%</td>\n                        </tr>\n                    </tbody>\n                </table>\n                <div class=\"caution\">\n                    <p> 注意</p>\n                    <p>設定Lは下パネルが常時点滅します。</p>\n                </div>\n            </div>\n            \n            <button class=\"close\">ー閉じる</button>\n        </div>\n\n        <p class=\"js-menu\">基本情報</p>\n        <div class=\"contents\">\n            <div class=\"left\">\n                <h3>天井・打ち方・詳細情報</h3>\n                <table border=\"1\">\n                    <tbody>\n                        <tr>\n                            <th style=\"width: 50%;\">項目</th>\n                            <th>記載</th>\n                        </tr><tr>\n                            <td><img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2022/12/下向きの矢印のアイコン素材.png\" class=\"icon-small\" alt=\"arrow\" loading=\"lazy\">天井情報</td>\n                            <td>調査中</td>\n                        </tr>\n                        <tr>\n                            <td><img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2022/12/下向きの矢印のアイコン素材.png\" class=\"icon-small\" alt=\"arrow\" loading=\"lazy\">打ち方</td>\n                            <td>通常時の打ち方<br>ボーナス中の打ち方</td>\n                        </tr>\n                        <tr>\n                            <td><img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2022/12/下向きの矢印のアイコン素材.png\" class=\"icon-small\" alt=\"arrow\" loading=\"lazy\">ハイエナ詳細情報</td>\n                            <td>その他のハイエナ情報</td>\n                        </tr>\n                    </tbody>\n                </table>\n            </div>\n\n            <button class=\"close\">ー閉じる</button>\n        </div>\n    \n        <p class=\"js-menu\" style=\"display: none;\">数値詳細</p>\n        <div class=\"contents\" style=\"display: none;\">\n            <div class=\"left\">\n                <h3 id=\"destination1\"></h3>\n\n            </div>\n            <div class=\"left\">\n                <h3 id=\"destination2\"></h3>\n\n            </div>\n            <div class=\"left\">\n                <h3 id=\"destination3\"></h3>\n\n            </div>\n            <button class=\"close\">ー閉じる</button>\n        </div>\n\n        <p class=\"js-menu\" style=\"display: none;\">高設定狙いに必要な演出法則</p>\n        <div class=\"contents\" style=\"display: none;\">\n            <div class=\"left\">\n                <img decoding=\"async\" src=\"https://media.slolaboratory.com/wp-content/uploads/2026/04/24005602/noimage1.jpg\" loading=\"lazy\">\n            </div>\n           \n            <button class=\"close\">ー閉じる</button>\n        </div>\n        \n    </div>\n</div>","shukei":""}