{"spec":"<h1 class=\"setting\">機種情報・設定判別</h1>\n\n\n\n\n\n\n\n<div id=\"post\" class=\"all-page\">\n\n    \n\n    <p class=\"js-menu\">基本情報</p>\n    <div class=\"contents\">\n        <p class=\"js-menu2\">概要</p>\n        <div class=\"contents2\">\n            <section>\n                <h3 data-date2=\"\">概要</h3>\n                <table border=\"1\">\n                    <tbody>\n                        <tr>\n                            <th style=\"width: 45%;\">機種名</th>\n                            <td>ウルトラミラクルジャグラー</td>\n                        </tr>\n                        <tr>\n                            <th>メーカー</th>\n                            <td>北電子</td>\n                        </tr>\n                        <tr>\n                            <th>タイプ</th>\n                            <td>ボーナス機</td>\n                        </tr>\n                        <tr>\n                            <th>ボーナス</th>\n                            <td>BIG...約240枚<br>REG...約96枚</td>\n                        </tr>\n                        <tr>\n                            <th>50枚ごとの回転数</th>\n                            <td>約42G</td>\n                        </tr>\n                        <tr>\n                            <th>コイン単価</th>\n                            <td>約2.0円(設定1)</td>\n                        </tr>\n                        <tr>\n                            <th>導入日</th>\n                            <td>2024年12月2日</td>\n                        </tr>\n                    </tbody>\n                </table>\n            </section>\n            \n        </div>\n\n\n        <p class=\"js-menu2\" id=\"destination1\">スペック</p>\n        <div class=\"contents2\">\n            <section>\n                <h3 data-date2=\"\">ボーナス確率</h3>\n                <table border=\"1\">\n                    <tbody>\n                        <tr>\n                            <th style=\"width: 25%;\">設定</th>\n                            <th style=\"width: 25%;\">BIG</th>\n                            <th style=\"width: 25%;\">REG</th>\n                            <th>合算</th>\n                        </tr>\n                        <tr>\n                            <td>設定1</td>\n                            <td>1/267.5</td>\n                            <td>1/425.6</td>\n                            <td>1/164.3</td>\n                        </tr>\n                        <tr>\n                            <td>設定2</td>\n                            <td>1/261.1</td>\n                            <td>1/402.1</td>\n                            <td>1/158.3</td>\n                        </tr>\n                        <tr>\n                            <td>設定3</td>\n                            <td>1/256.0</td>\n                            <td>1/350.5</td>\n                            <td>1/147.9</td>\n                        </tr>\n                        <tr>\n                            <td>設定4</td>\n                            <td>1/242.7</td>\n                            <td>1/322.8</td>\n                            <td>1/138.6</td>\n                        </tr>\n                        <tr>\n                            <td>設定5</td>\n                            <td>1/233.2</td>\n                            <td>1/297.9</td>\n                            <td>1/130.8</td>\n                        </tr>\n                        <tr>\n                            <td>設定6</td>\n                            <td>1/216.3</td>\n                            <td>1/277.7</td>\n                            <td>1/121.6</td>\n                        </tr>\n                    </tbody>\n                </table>\n            </section>\n\n            <section>\n                <h3 data-date2=\"\">出玉率</h3>\n                <table border=\"1\">\n                    <tbody>\n                        <tr>\n                            <th style=\"width: 50%;\">設定</th>\n                            <th>出玉率</th>\n                        </tr>\n                        <tr>\n                            <td>設定1</td>\n                            <td>97.0%</td>\n                        </tr>\n                        <tr>\n                            <td>設定2</td>\n                            <td>98.1%</td>\n                        </tr>\n                        <tr>\n                            <td>設定3</td>\n                            <td>99.8%</td>\n                        </tr>\n                        <tr>\n                            <td>設定4</td>\n                            <td>102.1%</td>\n                        </tr>\n                        <tr>\n                            <td>設定5</td>\n                            <td>104.5%</td>\n                        </tr>\n                        <tr>\n                            <td>設定6</td>\n                            <td>108.1%</td>\n                        </tr>\n                    </tbody>\n                </table>\n            </section>\n            \n        </div>\n\n        <p class=\"js-menu2\">打ち方・リール配列</p>\n        <div class=\"contents2\">\n            <p class=\"js-menu3\">配当表</p>\n            <div class=\"contents3\">\n                <section>\n                    <h3>配当表</h3>\n                    <img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2024/11/umj__2.jpg\" loading=\"lazy\">\n                </section>\n\n                \n            </div>\n\n            <p class=\"js-menu3\">リール配列</p>\n            <div class=\"contents3\">\n                <section>\n                    <h3>リール配列</h3>\n                    <img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2024/11/umj__1.jpg\" loading=\"lazy\">\n                </section>\n\n                \n            </div>\n\n            <p class=\"js-menu3\" id=\"destination3\">通常時の打ち方</p>\n            <div class=\"contents3\">\n                <section>\n                    <h3>通常時の打ち方</h3>                \n                    <img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2024/11/umj__3.jpg\" loading=\"lazy\">\n                    <p>左リールは<b>BAR</b>の位置を基準にしてチェリーを狙い、中リールと右リールはフリー打ちで問題ありません。</p>\n        \n                    <div class=\"memo\">\n                        <p> MEMO</p>\n                        <p>ベルやピエロは取りこぼしてしまうものの、チェリーだけをフォローする打ち方なら効率よく消化できます。</p>\n                    </div>\n\n                    <h4 data-date2=\"\">停止形A</h4>\n                    <img decoding=\"async\" src=\"https://media.slolaboratory.com/wp-content/uploads/2025/08/umj__20.jpg\" loading=\"lazy\">\n                    <table border=\"1\">\n                        <tbody>\n                            <tr>\n                                <th style=\"width: 25%;\">成立役</th>\n                                <td>ハズレ・ブドウ・リプレイ</td>\n                            </tr>\n                        </tbody>\n                    </table>\n                    <p>中・右リールはフリー打ち。</p>\n\n                    <h4 data-date2=\"\">停止形B</h4>\n                    <img decoding=\"async\" src=\"https://media.slolaboratory.com/wp-content/uploads/2025/08/umj__21.jpg\" loading=\"lazy\">\n                    <table border=\"1\">\n                        <tbody>\n                            <tr>\n                                <th style=\"width: 25%;\">成立役</th>\n                                <td>チェリー</td>\n                            </tr>\n                        </tbody>\n                    </table>\n                    <p>中・右リールはフリー打ち。</p>\n\n                    <h4 data-date2=\"\">停止形C</h4>\n                    <img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2024/12/umj__19.jpg\" loading=\"lazy\">\n                    <table border=\"1\">\n                        <tbody>\n                            <tr>\n                                <th style=\"width: 25%;\">成立役</th>\n                                <td>ブドウ・ベル</td>\n                            </tr>\n                        </tbody>\n                    </table>\n                    <p>中リールは⑫の<b>BAR</b>が枠下に来るのを目安にベルを狙い、右リールはボーナス図柄を外しながら消化します。</p>\n\n                    <h4 data-date2=\"\">停止形D</h4>\n                    <img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2024/12/umj__18.jpg\" loading=\"lazy\">\n                    <table border=\"1\">\n                        <tbody>\n                            <tr>\n                                <th style=\"width: 25%;\">成立役</th>\n                                <td>中段チェリー</td>\n                            </tr>\n                        </tbody>\n                    </table>\n                    <p>中・右リールはフリー打ち。</p>\n                </section>\n\n                \n            </div>\n\n\n            <p class=\"js-menu3\" id=\"destination6\">ボーナス入賞手順</p>\n            <div class=\"contents3\">\n                <section>\n                    <h3>ボーナス入賞手順</h3>                \n                    <img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2024/07/mrjuggler__31.jpg\" loading=\"lazy\">\n                    <p>1枚掛けにして全リールに<b class=\"red\">赤7</b>を狙い、ボーナスの入賞を目指しましょう。</p>\n                    <p>本機はボーナス優先制御を採用しているので、小役をフォローしたい場面では以下の中押し手順を実践してください。</p>\n\n                </section>\n\n                <section>\n                    <h3 id=\"destination200\">ボーナス入賞時の中押し手順</h3>\n                    <img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2024/07/mrjuggler__9.jpg\" loading=\"lazy\">\n                    <p>中リール上・中段に<b class=\"red\">7図柄</b>狙い(2コマ目押し)。</p>\n\n                    <div class=\"caution\">\n                        <p> 注意\n                        </p>\n                        <p>本機はボーナス優先制御となっており、たとえ内部的に小役が成立していても、<b class=\"red\">7図柄</b>を引き込める範囲でリールを止めるとそのままボーナスが入賞してしまいます。</p>\n                        <p>ボーナスに当選したタイミングでこの手順を踏めば、内部で成立しているブドウを判別できます。</p>\n                    </div>\n                    \n                    <h4>停止形A</h4>\n                    <img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2024/12/umj__12.jpg\" loading=\"lazy\">\n                    <table border=\"1\">\t\t\t\n                        <tbody>\n                            <tr>\t\n                                <th style=\"width: 25%;\">成立役</th>\n                                <td bgcolor=\"#DDDDDD\">BIG・REG・リプレイ</td>\n                            </tr>\t\n                        </tbody>\t\t\n                    </table>\n                    <p>左・右リールに<b class=\"red\">7図柄</b>を狙い、ボーナスを入賞させましょう。</p>\n                    <figcaption class=\"left\">(※)リプレイが成立する可能性があります。</figcaption>\n                    <h4>停止形B</h4>\n                    <img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2024/03/jgirlsss__21.png\" loading=\"lazy\">\n                    <table border=\"1\">\t\t\t\n                        <tbody>\t\t\n                            <tr>\t\n                                <th style=\"width: 25%;\">成立役</th>\n                                <td bgcolor=\"#DDDDDD\">BIG・REG・ブドウ</td>\n                            </tr>\t\n                        </tbody>\t\t\n                    </table>\n                    <p>左リールと右リールは<b class=\"red\">7図柄</b>を回避しながら消化し、ブドウを入賞させましょう。</p>\n        \n                    <h4>停止形C</h4>\n                    <img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2024/12/umj__13.jpg\" loading=\"lazy\">\n                    <table border=\"1\">\t\t\t\n                        <tbody>\t\t\n                            <tr>\t\n                                <th style=\"width: 25%;\">成立役</th>\n                                <td bgcolor=\"#DDDDDD\">BIG・REG・チェリー・ブドウ</td>\n                            </tr>\t\n                        </tbody>\t\t\n                    </table>\n                    <p>左リールは枠上から上段の範囲に<b class=\"red\">7図柄</b>を狙い、その停止形に応じて右リールの打ち方を変えましょう。</p>\n                    <figcaption class=\"left\">(※)ごく稀にチェリーが成立していることもありますが、確率が低いので無視して差し支えありません。</figcaption>\n                    \n                    <div class=\"subtitle2\">左リール上段に7図柄停止</div>\n                    <img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2024/12/umj__14.jpg\" loading=\"lazy\">\n                    <table>\t\t\t\n                        <tbody>\t\t\n                            <tr>\t\n                                <th style=\"width: 25%;\">成立役</th>\n                                <td bgcolor=\"#DDDDDD\">BIG・REG・ブドウ</td>\n                            </tr>\t\n                        </tbody>\t\t\n                    </table>\n                    <p>右リールに<b class=\"red\">7図柄</b>を避けて消化し、ブドウを入賞させましょう。</p>\n\n                    <div class=\"subtitle2\">左リール中段もしくは下段に7図柄停止</div>\n                    <img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2024/12/umj__15.jpg\" loading=\"lazy\">\n                    <table>\t\t\t\n                        <tbody>\t\t\n                            <tr>\t\n                                <th style=\"width: 25%;\">成立役</th>\n                                <td bgcolor=\"#DDDDDD\">BIG・REG</td>\n                            </tr>\t\n                        </tbody>\t\n                    </table>\n                    <p>右リールに<b class=\"red\">7図柄</b>を狙いボーナスを入賞させましょう。</p>\n        \n                </section>\n\n                \n            </div>\n\n            <p class=\"js-menu3\" id=\"destination7\">ボーナス中の打ち方</p>\n            <div class=\"contents3\">\n                <section>\n                    <h3>ボーナス中の打ち方</h3>\n                    <p>BIG・REGともに全リールフリー打ちで消化しましょう。</p>\n                    \n                </section>\n\n                \n            </div>\n\n            <p class=\"js-menu3\" id=\"destination8\">小役の停止形</p>\n            <div class=\"contents3\">\n                <section>\n                    <h3 id=\"destination5\">小役の停止形</h3>\n                    <table border=\"1\">\t\t\t\n                        <tbody>\t\t\n                            <tr>\t\n                                <th style=\"width: 50%;\">チェリー</th>\n                                <th>ベル</th>\n                            </tr>\t\n                            <tr>\n                                <td class=\"bg-white\"><img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2024/11/umj__4.jpg\" loading=\"lazy\"></td>\n                                <td><img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2024/11/umj__5.jpg\" loading=\"lazy\"></td>\n                            </tr>\n                            \n                            <tr>\t\n                                <th>ピエロ</th>\n                                <th>チャンス目</th>\n                            </tr>\t\n                            <tr>\n                                <td class=\"bg-white\"><img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2024/11/umj__6.jpg\" loading=\"lazy\"></td>\n                                <td><img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2024/11/umj__8.jpg\" loading=\"lazy\"></td>\n                            </tr>\n                            <tr>\t\n                                <th>チャンス目</th>\n                                <th>チャンス目</th>\n                            </tr>\t\n                            <tr>\n                                <td class=\"bg-white\"><img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2024/11/umj__9.jpg\" loading=\"lazy\"></td>\n                                <td><img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2024/11/umj__7.jpg\" loading=\"lazy\"></td>\n                            </tr>   \n                            <tr>\t\n                                <th>チャンス目</th>\n                            </tr>\t\n                            <tr>\n                                <td class=\"bg-white\"><img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2024/11/umj__10.jpg\" loading=\"lazy\"></td>\n                            </tr>     \n                        </tbody>\t\t\n                    </table>\t\t\t        \n                </section>\n\n                \n            </div>\n        </div>\n\n\n        <p class=\"js-menu2\">小役確率</p>\n        <div class=\"contents2\">\n            <section>\n                <h3 data-date2=\"\">小役確率詳細</h3>\n                <p>不明。</p>\n            </section>\n\n            <section>\n                <h3 data-date2=\"\">50枚ごとの回転数</h3>\n                <table border=\"1\">\n                    <tbody>\n                        <tr>\n                            <th>設定</th>\n                            <th style=\"width:50%;\">50枚ごとの回転数</th>\n                        </tr>\n\n                        <tr>\n                            <td>設定1</td>\n                            <td>約42G</td>\n                        </tr>\n                        <tr>\n                            <td>設定2</td>\n                            <td rowspan=\"5\">不明</td>\n                        </tr>\n                        <tr>\n                            <td>設定3</td>\n                        </tr>\n                        <tr>\n                            <td>設定4</td>\n                        </tr>\n                        <tr>\n                            <td>設定5</td>\n                        </tr>\n                        <tr>\n                            <td>設定6</td>\n                        </tr>\n                    </tbody>\n                </table>\n            </section>\n\n            \n        </div>\n\n\n        <p class=\"js-menu2\">天井情報</p>\n        <div class=\"contents2\">\n            <section>\n                <h3>ゲーム数天井</h3>\n                <table border=\"1\">\n                    <tbody>\n                        <tr>\n                            <th style=\"width: 30%;\">天井条件</th>\n                            <td>非搭載</td>\n                        </tr>\n                        <tr>\n                            <th>恩恵</th>\n                            <td>－</td>\n                        </tr>\n                    </tbody>\n                </table>\n            </section>\n\n            \n        </div>\n\n\n        <p class=\"js-menu2\">有利区間切れ条件・恩恵</p>\n        <div class=\"contents2\">\n            <section>\n                <h3 data-date2=\"\">有利区間切れタイミングについて</h3>\n                <p>本機は有利区間非搭載となります。</p>\n            </section>\n\n            \n        </div>\n\n\n        <p class=\"js-menu2\">リセット判別</p>\n        <div class=\"contents2\">\n            <section>\n                <h3 data-date2=\"\" id=\"destination500\">朝イチの挙動</h3>\n                <table border=\"1\">\n                    <tbody>\n                        <tr>\n                            <th>項目</th>\n                            <th style=\"width: 33.3%;\">設定変更</th>\n                            <th style=\"width: 33.3%;\">電源OFF→ON</th>\n                        </tr>\n                        <tr>\n                            <td>天井</td>\n                            <td>－</td>\n                            <td>－</td>\n                        </tr>\n                        <tr>\n                            <td>リールガックン</td>\n                            <td>無効</td>\n                            <td>－</td>\n                        </tr>\n                    </tbody>\n                </table>\n\n                \n\n                \n            </section>\n\n            \n        </div>\n\n\n        \n    </div>\n\n\n\n    <p class=\"js-menu\">設定狙い</p>\n    <div class=\"contents\">\n        \n\n        <p class=\"js-menu2\">設定判別項目</p>\n        <div class=\"contents2\">\n            \n\n            <section>\n                <h3 data-date2=\"\">通常時</h3>\n                <table border=\"1\">\n                    <tbody>\n                        <tr>\n                            <th style=\"width: 73%;\">項目</th>\n                            <th>重要度</th>\n                        </tr>\n                        <tr>\n                            <td><img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2022/12/下向きの矢印のアイコン素材.png\" class=\"icon-small\" alt=\"arrow\" loading=\"lazy\">ボーナス確率</td>\n                            <td>★★★★☆</td>\n                        </tr>\n                    </tbody>\n                </table>\n            </section>\n\n            \n\n            \n        </div>\n\n        \n\n        \n    </div>\n\n\n\n    <p class=\"js-menu\">通常時</p>\n    <div class=\"contents\">\n        <p class=\"js-menu2\">通常時の抽選</p>\n        <div class=\"contents2\">\n            <section>\n                <h3>概要</h3>\n                <img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2024/11/umj__11.jpg\" loading=\"lazy\">\n                <p>通常時は全役でボーナス当選を目指します。</p>\n                <p>GOGO！ランプが点灯すればボーナス当選確定となります。</p>        \n                <p>(ビッグボーナスについて)</p>\n                <p>(レギュラーボーナスについて)</p>\n            </section>\n                \n            \n        </div>\n\n\n        <p class=\"js-menu2\">同時当選について</p>\n        <div class=\"contents2\">\n            <section>\n                <h3>概要</h3>\n                \n                <p>チェリー成立時に単チェリーや中段チェリーが出現した場合は、ボーナスが濃厚です。</p>      \n                <p>(ビッグボーナスについて)</p>\n                <p>(レギュラーボーナスについて)</p>  \n            </section>\n                \n            \n        </div>\n\n\n        <p class=\"js-menu2\">ボーナス告知の発生割合</p>\n        <div class=\"contents2\">\n            <section>\n                <h3>概要</h3>\n                <p>ボーナス当選告知は、先告知と後告知の2種類があります。</p>\n                <table border=\"1\">\n                    <tbody>\n                        <tr>\n                            <th>告知方法</th>\n                            <th style=\"width:33.3%;\">詳細</th>\n                            <th style=\"width:33.3%;\">割合</th>\n                        </tr>\n                        <tr>\n                            <td rowspan=\"3\">先告知</td>\n                            <td>レバーオン時</td>\n                            <td rowspan=\"3\">25%</td>\n                        </tr>\n                        <tr>\n                            <td class=\"bg-white\">リール回転時</td>\n                        </tr>\n                        <tr>\n                            <td class=\"bg-white\">停止ボタン有効時</td>\n                        </tr>\n                        <tr>\n                            <td>後告知</td>\n                            <td>第三停止時</td>\n                            <td>75%</td>\n                        </tr>\n                    </tbody>\n                </table>\n            </section>\n                \n            \n        </div>\n    </div>\n\n\n\n    <p class=\"js-menu\">ボーナス</p>\n    <div class=\"contents\">\n        <p class=\"js-menu2\" id=\"destination11\">ビッグボーナス</p>\n        <div class=\"contents2\">\n            <section>\n                <h3>概要</h3>\n                <table border=\"1\">\n                    <tbody>\n                        <tr>\n                            <th>項目</th>\n                            <th style=\"width:50%;\">内容</th>\n                        </tr>\n                        <tr>\n                            <td>図柄</td>\n                            <td>赤7揃い</td>\n                        </tr>\n                        <tr>\n                            <td>獲得枚数</td>\n                            <td>約240枚</td>\n                        </tr>\n                    </tbody>\n                </table>\n                <p>ボーナス中はフリー打ちで消化しましょう。</p>\n            </section>\n\n            \n        </div>\n\n\n        <p class=\"js-menu2\" id=\"destination12\">レギュラーボーナス</p>\n        <div class=\"contents2\">\n            <section>\n                <h3>概要</h3>\n                <table border=\"1\">\n                    <tbody>\n                        <tr>\n                            <th>項目</th>\n                            <th style=\"width:50%;\">内容</th>\n                        </tr>\n                        <tr>\n                            <td>図柄</td>\n                            <td>赤7・赤7・BAR</td>\n                        </tr>\n                        <tr>\n                            <td>獲得枚数</td>\n                            <td>約96枚</td>\n                        </tr>\n                    </tbody>\n                </table>\n                <p>ボーナス中はフリー打ちで消化しましょう。</p>\n            </section>\n\n            \n        </div>\n    </div>\n\n\n\n    <p class=\"js-menu\">演出関連</p>\n    <div class=\"contents\">\n        <p class=\"js-menu2\" id=\"destination13\">プレミアム演出</p>\n        <div class=\"contents2\">\n            <section>\n                <h3>概要</h3>\n                <p>発生時点でBIGボーナス濃厚となります。</p>\n                <table border=\"1\">\n                    <tbody>\n                        <tr>\n                            <th style=\"width:40%;\">演出パターン</th>\n                            <th>特徴</th>\n                        </tr>\n                        <tr>\n                            <td>リール停止矛盾</td>\n                            <td>停止させたリールとは<br>違うリールが停止</td>\n                        </tr>\n                        <tr>\n                            <td>オーロラ</td>\n                            <td>各リール停止ごとに<br>ほうき星ランプが<br>オーロラのように光る</td>\n                        </tr>\n                        <tr>\n                            <td>ほうき星ランプ点灯</td>\n                            <td>次ゲームのベット時に<br>ほうき星ランプが<br>レインボーに変化</td>\n                        </tr>\n                        <tr>\n                            <td>流れ星</td>\n                            <td>ほうき星ランプから流れ星が<br>流れてGOGO!ランプが点灯</td>\n                        </tr>\n                        <tr>\n                            <td>GOGO!ランプ吸収</td>\n                            <td>GOGO!ランプが<br>ほうき星ランプの光を吸収</td>\n                        </tr>\n                        <tr>\n                            <td>隠しランプ点灯</td>\n                            <td>GOGO!ランプ点灯の次ゲームに<br>リール左上の隠しランプが点灯</td>\n                        </tr>\n                        <tr>\n                            <td>音声フリーズ</td>\n                            <td>フリーズのタイミングにより<br>様々なボイスが発生</td>\n                        </tr>\n                        <tr>\n                            <td>ベコたんフリーズ</td>\n                            <td>壮大な曲と共にリールが逆回転し、ベコたんの鳴き声が発生</td>\n                        </tr>\n                    </tbody>\n                </table>\n            </section>\n\n            \n        </div>\n\n\n        <p class=\"js-menu2\">ミラクル演出</p>\n        <div class=\"contents2\">\n            <section>\n                <h3>概要</h3>                \n                <p>通常時に特定の演出が起こればBIGボーナスが濃厚となり、ボーナス中は対応する演出の楽曲が流れます。</p>\n                <table border=\"1\">\n                    <tbody>\n                        <tr>\n                            <th style=\"width:40%;\">演出パターン</th>\n                            <th>特徴</th>\n                        </tr>\n                        <tr>\n                            <td>木星</td>\n                            <td>リールで奏でる壮大な世界観演出が発生</td>\n                        </tr>\n                        <tr>\n                            <td>ワルキューレの騎行</td>\n                            <td>華やかな光と音の共演演出が発生</td>\n                        </tr>\n                        <tr>\n                            <td>カノン</td>\n                            <td>「7」が踊るリールアクション<br>が発生</td>\n                        </tr>\n                        <tr>\n                            <td>きらきら星変奏曲</td>\n                            <td>流れ星のようなリール演出が発生</td>\n                        </tr>\n                        <tr>\n                            <td>新世界</td>\n                            <td>リール回転開始時や各リール停止ごとにリールが逆回転</td>\n                        </tr>\n                        <tr>\n                            <td>天国と地獄</td>\n                            <td>リール回転開始時や各リール停止ごとにリールが高速回転</td>\n                        </tr>\n                    </tbody>\n                </table>\n            </section>\n\n            \n        </div>\n\n\n        <p class=\"js-menu2\" id=\"destination14\">ボーナス楽曲</p>\n        <div class=\"contents2\">\n            <section>\n                <h3>概要</h3>\n                <p>発生条件を満たすと特定のボーナス楽曲が発生します。</p>\n                <p>軍艦マーチ以外は条件2つ達成で楽曲が変化します。</p>\n                <table border=\"1\">\n                    <tbody>\n                        <tr>\n                            <th style=\"width:45%;\">楽曲</th>\n                            <th>条件</th>\n                        </tr>\n                        <tr>\n                            <td>軍艦マーチ</td>\n                            <td>ボーナス後1G目に<br>BIGボーナスが当選</td>\n                        </tr>\n                        <tr>\n                            <td rowspan=\"2\">木星</td>\n                            <td>ボーナス後5G以内に<br>BIGボーナスが当選</td>\n                        </tr>\n                        <tr>\n                            <td class=\"bg-white\">木星のミラクル演出発生時</td>\n                        </tr>\n                        <tr>\n                            <td rowspan=\"2\">ワルキューレの騎行</td>\n                            <td>ボーナス後5G以内に<br>BIGボーナスが当選</td>\n                        </tr>\n                        <tr>\n                            <td class=\"bg-white\">ワルキューレ騎行の<br>ミラクル演出発生時</td>\n                        </tr>\n                        <tr>\n                            <td rowspan=\"2\">カノン</td>\n                            <td>ボーナス後5G以内に<br>BIGボーナスが当選</td>\n                        </tr>\n                        <tr>\n                            <td class=\"bg-white\">カノンのミラクル演出発生時</td>\n                        </tr>\n                        <tr>\n                            <td rowspan=\"2\">きらきら星変奏曲</td>\n                            <td>ボーナス後5G以内に<br>BIGボーナスが当選</td>\n                        </tr>\n                        <tr>\n                            <td class=\"bg-white\">きらきら星変奏曲の<br>ミラクル演出発生時</td>\n                        </tr>\n                        <tr>\n                            <td rowspan=\"2\">新世界</td>\n                            <td>ボーナス後5G以内に<br>BIGボーナスが当選</td>\n                        </tr>\n                        <tr>\n                            <td class=\"bg-white\">新世界のミラクル演出発生時</td>\n                        </tr>\n                        <tr>\n                            <td rowspan=\"2\">天国と地獄</td>\n                            <td>ボーナス後5G以内に<br>BIGボーナスが当選</td>\n                        </tr>\n                        <tr>\n                            <td class=\"bg-white\">天国と地獄の<br>ミラクル演出発生時</td>\n                        </tr>\n                        \n                    </tbody>\n                </table>\n            </section>\n\n            \n        </div>\n\n        \n    </div>\n</div>","shukei":""}