{"spec":"<h1 class=\"setting\">機種情報・設定判別</h1>\n\n\n\n\n\n\n\n\n<div id=\"post\" class=\"all-page\">\n    \n\n\n    <p class=\"js-menu\">基本情報</p>\n    <div class=\"contents\">\n        <p class=\"js-menu2\">概要</p>\n        <div class=\"contents2\">\n            <section>\n                <h3>概要</h3>\n                <table border=\"1\">\n                    <tbody>\n                        <tr>\n                            <th style=\"width: 50%;\">機種名</th>\n                            <td>ネオアイムジャグラーEX</td>\n                        </tr>\n                        <tr>\n                            <th>メーカー</th>\n                            <td>北電子</td>\n                        </tr>\n                        <tr>\n                            <th>タイプ</th>\n                            <td>ボーナス機</td>\n                        </tr>\n                        <tr>\n                            <th>ボーナス</th>\n                            <td>BIG...約252枚<br>REG...約96枚</td>\n                        </tr>\n                        <tr>\n                            <th>50枚ごとの回転数</th>\n                            <td class=\"copy-moto1\">約40G</td>\n                        </tr>\n                        <tr>\n                            <th>コイン単価</th>\n                            <td>約1.9円(設定1)</td>\n                        </tr>\n                        <tr>\n                            <th>導入日</th>\n                            <td>2025年9月1日</td>\n                        </tr>\n                    </tbody>\n                </table>\n            </section>\n\n            \n        </div>\n\n\n        <p class=\"js-menu2\" id=\"destination1\">スペック</p>\n        <div class=\"contents2\">\n            <section>\n                <h3>ボーナス確率</h3>\n                <table border=\"1\">\n                    <tbody>\n                        <tr>\n                            <th style=\"width: 25.0%;\">設定</th>\n                            <th style=\"width: 25.0%;\">BIG</th>\n                            <th style=\"width: 25.0%;\">REG</th>\n                            <th>合算</th>\n                        </tr>\n                        <tr>\n                            <td>設定1</td>\n                            <td>1/273.1</td>\n                            <td>1/439.8</td>\n                            <td>1/168.5</td>\n                        </tr>\n                        <tr>\n                            <td>設定2</td>\n                            <td>1/269.7</td>\n                            <td>1/399.6</td>\n                            <td>1/161.0</td>\n                        </tr>\n                        <tr>\n                            <td>設定3</td>\n                            <td>1/269.7</td>\n                            <td>1/331.0</td>\n                            <td>1/148.6</td>\n                        </tr>\n                        <tr>\n                            <td>設定4</td>\n                            <td>1/259.0</td>\n                            <td>1/315.1</td>\n                            <td>1/142.2</td>\n                        </tr>\n                        <tr>\n                            <td>設定5</td>\n                            <td>1/259.0</td>\n                            <td>1/255.0</td>\n                            <td>1/128.5</td>\n                        </tr>\n                        <tr>\n                            <td>設定6</td>\n                            <td>1/255.0</td>\n                            <td>1/255.0</td>\n                            <td>1/127.5</td>\n                        </tr>\n                    </tbody>\n                </table>\n            </section>\n\n            <section>\n                <h3>出玉率</h3>\n                <table border=\"1\">\n                    <tbody>\n                        <tr>\n                            <th style=\"width: 25%;\">設定</th>\n                            <th>出玉率</th>\n                        </tr>\n                        <tr>\n                            <td>設定1</td>\n                            <td>97.0%</td>\n                        </tr>\n                        <tr>\n                            <td>設定2</td>\n                            <td>98.0%</td>\n                        </tr>\n                        <tr>\n                            <td>設定3</td>\n                            <td>99.5%</td>\n                        </tr>\n                        <tr>\n                            <td>設定4</td>\n                            <td>101.1%</td>\n                        </tr>\n                        <tr>\n                            <td>設定5</td>\n                            <td>103.3%</td>\n                        </tr>\n                        <tr>\n                            <td>設定6</td>\n                            <td>105.5%</td>\n                        </tr>\n                    </tbody>\n                </table>\n            </section>\n\n            \n        </div>\n\n\n        <p class=\"js-menu2\">打ち方・リール配列</p>\n        <div class=\"contents2\">\n            <p class=\"js-menu3\">配当表</p>\n            <div class=\"contents3\">\n                <section>\n                    <h3>配当表</h3>\n                    <img decoding=\"async\" src=\"https://media.slolaboratory.com/wp-content/uploads/2025/08/neoimj__2.jpg\" loading=\"lazy\">\n                </section>\n\n                \n            </div>\n\n            <p class=\"js-menu3\" id=\"destination201\">リール配列</p>\n            <div class=\"contents3\">\n                <section>\n                    <h3>リール配列</h3>\n                    <img decoding=\"async\" src=\"https://media.slolaboratory.com/wp-content/uploads/2025/08/neoimj__1.jpg\" loading=\"lazy\">\n                </section>\n\n                \n            </div>\n\n            <p class=\"js-menu3\" id=\"destination2\">通常時の打ち方</p>\n            <div class=\"contents3\">\n                <section>\n                    <h3>通常時の打ち方</h3>\n                    <img decoding=\"async\" src=\"https://media.slolaboratory.com/wp-content/uploads/2025/08/neojug_barnerai.jpg\" loading=\"lazy\">\n                    <p>左リール上段に<b>BAR</b>を目安にチェリー狙い。</p>\n                    <div class=\"memo\">\n                        <p> MEMO</p>\n                        <p>ピエロやベルはこぼしてしまうこともありますが、チェリーだけを追えば効率のよい消化が可能です。</p>\n                    </div>\n\n                    <h4>停止形A</h4>\n                    <img decoding=\"async\" src=\"https://media.slolaboratory.com/wp-content/uploads/2025/08/neoimj__4.jpg\" loading=\"lazy\">\n                    <table border=\"1\">\n                        <tbody>\n                            <tr>\n                                <th style=\"width: 25%;\">成立役</th>\n                                <td>ハズレ・リプレイ・ブドウ</td>\n                            </tr>\n                        </tbody>\n                    </table>\n                    <p>中・右リールはフリー打ち。</p>\n\n                    <h4>停止形B</h4>\n                    <img decoding=\"async\" src=\"https://media.slolaboratory.com/wp-content/uploads/2025/08/neoimj__5.jpg\" loading=\"lazy\">\n                    <table border=\"1\">\n                        <tbody>\n                            <tr>\n                                <th style=\"width: 25%;\">成立役</th>\n                                <td>チェリー</td>\n                            </tr>\n                        </tbody>\n                    </table>\n                    <p>中・右リールはフリー打ち。</p>\n\n                    <h4>停止形C</h4>\n                    <img decoding=\"async\" src=\"https://media.slolaboratory.com/wp-content/uploads/2025/08/neoimj__7.jpg\" loading=\"lazy\">\n                    <table border=\"1\">\n                        <tbody>\n                            <tr>\n                                <th style=\"width: 25%;\">成立役</th>\n                                <td>中段チェリー</td>\n                            </tr>\n                        </tbody>\n                    </table>\n                    <p>中・右リールはフリー打ち。</p>\n\n                    <h4>停止形D</h4>\n                    <img decoding=\"async\" src=\"https://media.slolaboratory.com/wp-content/uploads/2025/08/neoimj__6.jpg\" loading=\"lazy\">\n                    <table border=\"1\">\n                        <tbody>\n                            <tr>\n                                <th style=\"width: 25%;\">成立役</th>\n                                <td>ブドウ・ベル</td>\n                            </tr>\n                        </tbody>\n                    </table>\n                    <p>中リールは<b>BAR</b>を枠下の目印としてベルを狙いましょう。ベルがテンパイした場合は、右リールでボーナス図柄を外しながら消化します。</p>\n                    <p>(リール配列について)</p>\n\n                    \n                    <h4>停止形E</h4>\n                    <img decoding=\"async\" src=\"https://media.slolaboratory.com/wp-content/uploads/2025/09/neoimj__33.jpg\" loading=\"lazy\">\n                    <table border=\"1\">\n                        <tbody>\n                            <tr>\n                                <th style=\"width: 25%;\">成立役</th>\n                                <td>ブドウ・ピエロ</td>\n                            </tr>\n                        </tbody>\n                    </table>\n                    <p>中リールは<b class=\"red\">赤7</b>を目印にしてピエロを狙い、ピエロがテンパイしたら右リールはボーナス図柄を避けつつ消化してください。</p>\n                    <p>(リール配列について)</p>\n                    \n                </section>\n\n                \n            </div>\n\n           <p class=\"js-menu3\">通常時の打ち方(攻略手順)</p>\n            <div class=\"contents3\">\n                <section>\n                    <h3 data-date2=\"2025/9/5\">通常時の打ち方(攻略手順)</h3>\n                    <img decoding=\"async\" src=\"https://media.slolaboratory.com/wp-content/uploads/2025/09/neoimj__25.jpg\" loading=\"lazy\">\n                    <p>右リール上段に<b>ボーナス図柄</b>狙い。</p>\n\n                    <h4>停止形A</h4>\n                    <img decoding=\"async\" src=\"https://media.slolaboratory.com/wp-content/uploads/2025/09/neoimj__26.jpg\" loading=\"lazy\">\n                    <table border=\"1\">\n                        <tbody>\n                            <tr>\n                                <th style=\"width: 25%;\">成立役</th>\n                                <td>ハズレ・リプレイ</td>\n                            </tr>\n                        </tbody>\n                    </table>\n                    <p>左リールはBARを目安にチェリーを狙い、中リールはフリー打ちで構いません。</p>\n                    <div class=\"memo\">\n                        <p> MEMO</p>\n                        <p>左リールにチェリー停止時は、ビッグボーナス濃厚となります。</p>\n                    </div>\n\n                    <h4>停止形B</h4>\n                    <img decoding=\"async\" src=\"https://media.slolaboratory.com/wp-content/uploads/2025/09/neoimj__27.jpg\" loading=\"lazy\">\n                    <table border=\"1\">\n                        <tbody>\n                            <tr>\n                                <th style=\"width: 25%;\">成立役</th>\n                                <td>ブドウ・チェリー</td>\n                            </tr>\n                        </tbody>\n                    </table>\n                    <p>チェリー狙いは左リールの<b>BAR</b>を目安に行い、中リールはフリー打ちでOKです。</p>\n                    <div class=\"memo\">\n                        <p> MEMO</p>\n                        <p>ブドウ非成立時はボーナス当選濃厚となります。</p>\n                    </div>\n\n                    <h4>停止形C</h4>\n                    <img decoding=\"async\" src=\"https://media.slolaboratory.com/wp-content/uploads/2025/09/neoimj__28.jpg\" loading=\"lazy\">\n                    <table border=\"1\">\n                        <tbody>\n                            <tr>\n                                <th style=\"width: 25%;\">成立役</th>\n                                <td>リプレイ・ベル・ブドウ</td>\n                            </tr>\n                        </tbody>\n                    </table>\n                    <p>中リールの<b>BAR</b>を目安にベルを狙いましょう。停止した形に応じて、左リールの打ち方を変えてください。</p>\n                    <p>(リール配列について)</p>\n                    <div class=\"subtitle2\">ベルテンパイ時</div>\n                    <img decoding=\"async\" src=\"https://media.slolaboratory.com/wp-content/uploads/2025/09/neoimj__29.jpg\" loading=\"lazy\">\n                    <p>ベルテンパイ時は左リール<b class=\"red\">⑳番の赤7</b>を目安にベル狙い。</p>\n                    <div class=\"subtitle2\">ベル非テンパイ時</div>\n                    <img decoding=\"async\" src=\"https://media.slolaboratory.com/wp-content/uploads/2025/09/neoimj__30.jpg\" loading=\"lazy\">\n                    <p>ベル非テンパイ時は左リール<b>BAR</b>を目安にチェリー狙い。</p>\n                    \n                    <h4>停止形D</h4>\n                    <img decoding=\"async\" src=\"https://media.slolaboratory.com/wp-content/uploads/2025/09/neoimj__31.jpg\" loading=\"lazy\">\n                    <table border=\"1\">\n                        <tbody>\n                            <tr>\n                                <th style=\"width: 25%;\">成立役</th>\n                                <td>ピエロ</td>\n                            </tr>\n                        </tbody>\n                    </table>\n                    <p>中リールは<b class=\"red\">赤7</b>を目安にピエロを狙い、左リールは<b class=\"red\">⑩番の赤7</b>を目安にピエロを狙います。</p>\n                    <p>(リール配列について)</p>\n\n                    <h4>停止形E</h4>\n                    <img decoding=\"async\" src=\"https://media.slolaboratory.com/wp-content/uploads/2025/09/neoimj__32.jpg\" loading=\"lazy\">\n                    <table border=\"1\">\n                        <tbody>\n                            <tr>\n                                <th style=\"width: 25%;\">成立役</th>\n                                <td>ボーナス</td>\n                            </tr>\n                        </tbody>\n                    </table>\n                    <p>左・中リールに<b class=\"red\">赤7</b>狙い。</p>\n\n                </section>\n\n                \n            </div>\n\n            <p class=\"js-menu3\" id=\"destination19\">ボーナス入賞手順</p>\n            <div class=\"contents3\">\n                <section>\n                    <h3>通常のボーナス入賞手順</h3>\n                    <img decoding=\"async\" src=\"https://media.slolaboratory.com/wp-content/uploads/2025/08/neoimj__8.jpg\" loading=\"lazy\">\n                    <p>1枚掛けにして、全リールへ<b class=\"red\">赤7</b>を狙い、ボーナスを入賞させてください。</p>\n                    \n                </section>\n\n                <section>\n                    <h3 id=\"destination200\">ブドウ抜きを考慮したボーナス入賞手順</h3>\n                    <img decoding=\"async\" src=\"https://media.slolaboratory.com/wp-content/uploads/2025/08/neoimj__9.jpg\" loading=\"lazy\">\n                    <p>中リール上・中段に<b class=\"red\">赤7</b>狙い(2コマ目押し)。</p>\n\n                    <div class=\"caution\">\n                        <p> 注意</p>\n                        <p>本機はボーナスを優先して制御するため、内部で小役が成立していても、<b class=\"red\">赤7</b>を引き込める位置でリールを止めるとそのままボーナスが入賞します。</p>\n                        <p>ボーナスに当選したタイミングでこの手順を踏めば、内部で成立しているブドウを獲得できます。</p>\n                    </div>\n\n                    <h4>停止形A</h4>\n                    <img decoding=\"async\" src=\"https://media.slolaboratory.com/wp-content/uploads/2025/08/neoimj__10.jpg\" loading=\"lazy\">\n                    <table border=\"1\">\n                        <tbody>\n                            <tr>\n                                <th style=\"width: 25%;\">成立役</th>\n                                <td bgcolor=\"#DDDDDD\">ボーナス・リプレイ</td>\n                            </tr>\n                        </tbody>\n                    </table>\n                    <p>左・右リールに<b class=\"red\">赤7</b>狙い。</p>\n                    <p>リプレイ成立時は、再度ボーナス入賞時の中押し手順を実行。</p>\n\n                    <h4>停止形B</h4>\n                    <img decoding=\"async\" src=\"https://media.slolaboratory.com/wp-content/uploads/2025/08/neoimj__11.jpg\" loading=\"lazy\">\n                    <table border=\"1\">\n                        <tbody>\n                            <tr>\n                                <th style=\"width: 25%;\">成立役</th>\n                                <td bgcolor=\"#DDDDDD\">ボーナス・ブドウ</td>\n                            </tr>\n                        </tbody>\n                    </table>\n                    <p>左リールと右リールでは<b class=\"red\">赤7</b>を外して消化し、ブドウを入賞させましょう。</p>\n                    <p>次ゲームは再度ボーナス入賞時の中押し手順を実行。</p>\n\n                    <h4>停止形C</h4>\n                    <img decoding=\"async\" src=\"https://media.slolaboratory.com/wp-content/uploads/2025/08/neoimj__12.jpg\" loading=\"lazy\">\n                    <table border=\"1\">\n                        <tbody>\n                            <tr>\n                                <th style=\"width: 25%;\">成立役</th>\n                                <td bgcolor=\"#DDDDDD\">ボーナス・チェリー・ブドウ</td>\n                            </tr>\n                        </tbody>\n                    </table>\n                    <p>左リールの枠上から上段にかけて<b class=\"red\">⑩番の赤7</b>を狙い、その停止形に合わせて右リールを打ち分けてください。</p>\n                    <p>(リール配列について)</p>\n                    <div class=\"memo\">\n                        <p> MEMO</p>\n                        <p>まれにチェリーが成立していることもありますが、確率が低いので無視して差し支えありません。</p>\n                    </div>\n\n                    <div class=\"subtitle2\">左リール上段に赤7停止</div>\n                    <img decoding=\"async\" src=\"https://media.slolaboratory.com/wp-content/uploads/2025/08/neoimj__13.jpg\" loading=\"lazy\">\n                    <table>\n                        <tbody>\n                            <tr>\n                                <th style=\"width: 25%;\">成立役</th>\n                                <td bgcolor=\"#DDDDDD\">ボーナス・ブドウ</td>\n                            </tr>\n                        </tbody>\n                    </table>\n                    <p>右リールに<b class=\"red\">赤7</b>を避けて消化し、ブドウを入賞させましょう。</p>\n                    <p>次ゲームは再度ボーナス入賞時の中押し手順を実行。</p>\n\n                    <div class=\"subtitle2\">左リール中段もしくは下段に赤7停止</div>\n                    <img decoding=\"async\" src=\"https://media.slolaboratory.com/wp-content/uploads/2025/08/neoimj__14.jpg\" loading=\"lazy\">\n                    <table>\n                        <tbody>\n                            <tr>\n                                <th style=\"width: 25%;\">成立役</th>\n                                <td bgcolor=\"#DDDDDD\">ボーナス</td>\n                            </tr>\n                        </tbody>\n                    </table>\n                    <p>右リールに<b class=\"red\">赤7</b>狙い。</p>\n                </section>\n\n                \n            </div>\n\n            <p class=\"js-menu3\" id=\"destination20\">ボーナス中の打ち方</p>\n            <div class=\"contents3\">\n                <section>\n                    <h3>概要</h3>\n                    <img decoding=\"async\" src=\"https://media.slolaboratory.com/wp-content/uploads/2025/08/neojug_free.jpg\" loading=\"lazy\">\n                    <p>ボーナス中は全リールフリー打ちで消化。</p>\n                </section>\n\n                \n            </div>\n\n            <p class=\"js-menu3\">小役の停止形</p>\n            <div class=\"contents3\">\n                <section>\n                    <h3>小役の停止形</h3>\n                    <table border=\"1\">\n                        <tbody>\n                            <tr>\n                                <th style=\"width: 50%;\">チェリー</th>\n                                <th>ベル</th>\n                            </tr>\n                            <tr>\n                                <td class=\"bg-white\"><img decoding=\"async\" src=\"https://media.slolaboratory.com/wp-content/uploads/2025/08/neoimj__15.jpg\" loading=\"lazy\">\n                                </td>\n                                <td><img decoding=\"async\" src=\"https://media.slolaboratory.com/wp-content/uploads/2025/08/neoimj__16.jpg\" loading=\"lazy\">\n                                </td>\n                            </tr>\n                            <tr>\n                                <th>ピエロ</th>\n                                <th>チャンス目</th>\n                            </tr>\n                            <tr>\n                                <td class=\"bg-white\"><img decoding=\"async\" src=\"https://media.slolaboratory.com/wp-content/uploads/2025/08/neoimj__17.jpg\" loading=\"lazy\">\n                                </td>\n                                <td><img decoding=\"async\" src=\"https://media.slolaboratory.com/wp-content/uploads/2025/08/neoimj__18.jpg\" loading=\"lazy\">\n                                </td>\n                            </tr>\n                            <tr>\n                                <th>チャンス目</th>\n                                <th>チャンス目</th>\n                            </tr>\n                            <tr>\n                                <td class=\"bg-white\"><img decoding=\"async\" src=\"https://media.slolaboratory.com/wp-content/uploads/2025/08/neoimj__19.jpg\" loading=\"lazy\">\n                                </td>\n                                <td><img decoding=\"async\" src=\"https://media.slolaboratory.com/wp-content/uploads/2025/08/neoimj__20.jpg\" loading=\"lazy\">\n                                </td>\n                            </tr>\n                            <tr>\n                                <th>チャンス目</th>\n                            </tr>\n                            <tr>\n                                <td class=\"bg-white\"><img decoding=\"async\" src=\"https://media.slolaboratory.com/wp-content/uploads/2025/08/neoimj__21.jpg\" loading=\"lazy\">\n                                </td>\n                            </tr>\n                        </tbody>\n                    </table>\n                </section>\n\n                \n            </div>\n        </div>\n\n\n        <p class=\"js-menu2\" id=\"destination3\">小役確率</p>\n        <div class=\"contents2\">\n            <section>\n                <h3>小役確率詳細</h3>\n                <p>調査中。</p>\n\n                \n\n                \n            </section>\n\n            <section>\n                <h3>50枚ごとの回転数</h3>\n                <table border=\"1\">\n                    <tbody>\n                        <tr>\n                            <th>設定</th>\n                            <th style=\"width:50%;\">50枚ごとの回転数</th>\n                        </tr>\n\n                        <tr>\n                            <td>設定1</td>\n                            <td class=\"copy-saki1\"></td>\n                        </tr>\n                        <tr>\n                            <td>設定2</td>\n                            <td rowspan=\"5\">不明</td>\n                        </tr>\n                        <tr>\n                            <td>設定3</td>\n                        </tr>\n                        <tr>\n                            <td>設定4</td>\n                        </tr>\n                        <tr>\n                            <td>設定5</td>\n                        </tr>\n                        <tr>\n                            <td>設定6</td>\n                        </tr>\n                    </tbody>\n                </table>\n            </section>\n\n            \n        </div>\n\n\n        <p class=\"js-menu2\" id=\"destination4\">天井情報</p>\n        <div class=\"contents2\">\n            <section>\n                <h3 id=\"destination5\">ゲーム数天井</h3>\n                <table border=\"1\">\n                    <tbody>\n                        <tr>\n                            <th style=\"width: 30%;\">天井条件</th>\n                            <td>非搭載</td>\n                        </tr>\n                        <tr>\n                            <th>恩恵</th>\n                            <td>－</td>\n                        </tr>\n                    </tbody>\n                </table>\n            </section>\n\n            \n        </div>\n\n\n        <p class=\"js-menu2\" id=\"destination8\">有利区間切れ条件・恩恵</p>\n        <div class=\"contents2\">\n            <section>\n                <h3>有利区間切れタイミング</h3>\n                <p>本機は有利区間非搭載となります。</p>\n            </section>\n\n            \n        </div>\n\n\n        <p class=\"js-menu2\">リセット判別</p>\n        <div class=\"contents2\">\n            <section>\n                <h3 id=\"destination500\">朝イチの挙動</h3>\n                <table border=\"1\">\n                    <tbody>\n                        <tr>\n                            <th>項目</th>\n                            <th style=\"width: 33.3%;\">設定変更</th>\n                            <th style=\"width: 33.3%;\">電源OFF→ON</th>\n                        </tr>\n                        <tr>\n                            <td>天井</td>\n                            <td>－</td>\n                            <td>－</td>\n                        </tr>\n                        <tr>\n                            <td>リールガックン</td>\n                            <td>無効</td>\n                            <td>－</td>\n                        </tr>\n                    </tbody>\n                </table>\n            </section>\n\n            \n        </div>\n    </div>\n\n\n\n    <p class=\"js-menu\">設定狙い</p>\n    <div class=\"contents\">\n        \n\n        <p class=\"js-menu2\">設定判別項目</p>\n        <div class=\"contents2\">\n            \n\n            <section>\n                <h3>通常時</h3>\n                <table border=\"1\">\n                    <tbody>\n                        <tr>\n                            <th style=\"width: 73%;\">項目</th>\n                            <th>重要度</th>\n                        </tr>\n                        <tr>\n                            <td><img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2022/12/下向きの矢印のアイコン素材.png\" class=\"icon-small\" alt=\"arrow\" loading=\"lazy\">ボーナス確率</td>\n                            <td>★★★★☆</td>\n                        </tr>\n                    </tbody>\n                </table>\n            </section>\n\n            \n\n            \n        </div>\n\n        \n\n        \n    </div>\n\n\n\n    <p class=\"js-menu\">通常時</p>\n    <div class=\"contents\">\n        <p class=\"js-menu2\" id=\"destination6\">通常時の抽選</p>\n        <div class=\"contents2\">\n            <section>\n                <h3>概要</h3>\n                <img decoding=\"async\" src=\"https://media.slolaboratory.com/wp-content/uploads/2025/08/neoimj__22.jpg\" loading=\"lazy\">\n                <p>通常時は、毎ゲーム全役でボーナス抽選が行われます。</p>\n                <p>リール左下にある「GOGO!ランプ」が点灯すれば、ボーナス当選です。</p>\n                <p>(ビッグボーナスについて)</p>\n                <p>(レギュラーボーナスについて)</p>\n            </section>\n\n            \n        </div>\n\n\n        <p class=\"js-menu2\" id=\"destination11\">同時当選について</p>\n        <div class=\"contents2\">\n            <section>\n                <h3>概要</h3>\n                <p>チェリー成立時は、ボーナスに同時当選する場合があります。</p>\n                <p>さらに、単チェリーや中段チェリーが現れた場合もボーナスが濃厚となります。</p>\n                <p>(ビッグボーナスについて)</p>\n                <p>(レギュラーボーナスについて)</p>\n\n                <div class=\"memo\">\n                    <p>\n                        MEMO</p>\n                    <p>チェリーが出たときの第3停止でボタンをネジり、払い出しが起こらなければ!?</p>\n                </div>\n            </section>\n\n            \n        </div>\n\n\n        <p class=\"js-menu2\" id=\"destination12\">ボーナス告知の発生割合</p>\n        <div class=\"contents2\">\n            <section>\n                <h3>概要</h3>\n                <p>ボーナス告知は、先告知と後告知の2種類存在します。</p>\n                <table border=\"1\">\n                    <tbody>\n                        <tr>\n                            <th>告知方法</th>\n                            <th style=\"width:33.3%;\">詳細</th>\n                            <th style=\"width:33.3%;\">割合</th>\n                        </tr>\n                        <tr>\n                            <td rowspan=\"3\">先告知</td>\n                            <td>レバーオン時</td>\n                            <td rowspan=\"3\">25%</td>\n                        </tr>\n                        <tr>\n                            <td class=\"bg-white\">リール回転時</td>\n                        </tr>\n                        <tr>\n                            <td class=\"bg-white\">停止ボタン有効時</td>\n                        </tr>\n                        <tr>\n                            <td>後告知</td>\n                            <td>第3停止ボタンを<br>外した時</td>\n                            <td>75%</td>\n                        </tr>\n                    </tbody>\n                </table>\n                <div class=\"memo\">\n                    <p>\n                        MEMO</p>\n                    <p>後告知時は、1/2で告知音が発生します。</p>\n                </div>\n            </section>\n            \n        </div>\n\n        \n\n        \n    </div>\n\n\n\n    <p class=\"js-menu\" id=\"destination7\">ボーナス</p>\n    <div class=\"contents\">\n        <p class=\"js-menu2\" id=\"destination13\">ビッグボーナス</p>\n        <div class=\"contents2\">\n            <section>\n                <h3>概要</h3>\n                <table border=\"1\">\n                    <tbody>\n                        <tr>\n                            <th>項目</th>\n                            <th style=\"width:50%;\">内容</th>\n                        </tr>\n                        <tr>\n                            <td>図柄</td>\n                            <td><img decoding=\"async\" src=\"https://media.slolaboratory.com/wp-content/uploads/2025/08/neojug_BB.jpg\" loading=\"lazy\">\n                            </td>\n                        </tr>\n                        <tr>\n                            <td>継続ゲーム数</td>\n                            <td>280枚以上の払い出しまで</td>\n                        </tr>\n                        <tr>\n                            <td>獲得枚数</td>\n                            <td>約252枚</td>\n                        </tr>\n                    </tbody>\n                </table>\n                <p>ボーナス中はフリー打ちで消化しましょう。</p>\n            </section>\n\n            \n        </div>\n\n\n        <p class=\"js-menu2\" id=\"destination14\">レギュラーボーナス</p>\n        <div class=\"contents2\">\n            <section>\n                <h3>概要</h3>\n                <table border=\"1\">\n                    <tbody>\n                        <tr>\n                            <th>項目</th>\n                            <th style=\"width:50%;\">内容</th>\n                        </tr>\n                        <tr>\n                            <td>図柄</td>\n                            <td><img decoding=\"async\" src=\"https://media.slolaboratory.com/wp-content/uploads/2025/08/neojug_RB.jpg\" loading=\"lazy\">\n                            </td>\n                        </tr>\n                        <tr>\n                            <td>継続ゲーム数</td>\n                            <td>98枚以上の払い出しまで</td>\n                        </tr>\n                        <tr>\n                            <td>獲得枚数</td>\n                            <td>約96枚</td>\n                        </tr>\n                    </tbody>\n                </table>\n                <p>ボーナス中はフリー打ちで消化しましょう。</p>\n            </section>\n\n            \n        </div>\n    </div>\n\n\n\n    <p class=\"js-menu\">演出関連</p>\n    <div class=\"contents\">\n        \n\n\n        <p class=\"js-menu2\" id=\"destination15\">プレミアム告知</p>\n        <div class=\"contents2\">\n            <section>\n                <h3>概要</h3>\n                <p>発生時点でビッグボーナス濃厚となります。</p>\n                <p>(ビッグボーナスについて)</p>\n\n                <h4>告知キャラプレミアム</h4>\n                <img decoding=\"async\" src=\"https://media.slolaboratory.com/wp-content/uploads/2025/08/neoimj__23.jpg\" loading=\"lazy\">\n                <p>GOGO!ランプを取り囲むキャラ達が点灯し、条件次第で登場するキャラが入れ替わるようです。</p>\n                <table border=\"1\">\n                    <tbody>\n                        <tr>\n                            <th>出現キャラ</th>\n                            <th style=\"width:60%;\">点灯条件</th>\n                        </tr>\n                        <tr>\n                            <td>ベコたん</td>\n                            <td>7図柄テンパイ時の一部</td>\n                        </tr>\n                        <tr>\n                            <td>まろ吉</td>\n                            <td>中段チェリー成立時</td>\n                        </tr>\n                        <tr>\n                            <td>オっぽ&amp;チュー助</td>\n                            <td>BAR揃い時</td>\n                        </tr>\n                        <tr>\n                            <td>ツノっち</td>\n                            <td>不明</td>\n                        </tr>\n                        <tr>\n                            <td>トラっぴ</td>\n                            <td>不明</td>\n                        </tr>\n                        <tr>\n                            <td>コンたろ</td>\n                            <td>不明</td>\n                        </tr>\n                    </tbody>\n                </table>\n\n                <h4>告知ランプ点灯パターン</h4>\n                <img decoding=\"async\" src=\"https://media.slolaboratory.com/wp-content/uploads/2025/08/neoimj__24.jpg\" loading=\"lazy\">\n                <table border=\"1\">\n                    <tbody>\n                        <tr>\n                            <th>点灯パターン</th>\n                            <th style=\"width:60%;\">特徴</th>\n                        </tr>\n                        <tr>\n                            <td>CHANCEレインボー</td>\n                            <td>CHANCE部分がレインボー点灯</td>\n                        </tr>\n                        <tr>\n                            <td>GOGO!のみ点灯</td>\n                            <td>GOGO!部分のみ点灯</td>\n                        </tr>\n                        <tr>\n                            <td>先CHANCE点灯</td>\n                            <td>レバーオン時にCHANCE部分が<br>先に点灯</td>\n                        </tr>\n                        <tr>\n                            <td>GOGO!遅れ</td>\n                            <td>CHANCE部分が点灯後<br>遅れてGOGO!部分が点灯</td>\n                        </tr>\n                        <tr>\n                            <td>CHANCE遅れ</td>\n                            <td>GOGO!部分が点灯後<br>遅れてCHANCE部分が点灯</td>\n                        </tr>\n                    </tbody>\n                </table>\n\n                <h4>その他プレミアム告知パターン</h4>\n                <ul>\n                    <li>レバーオンファンファーレ</li>\n                    <li>テンパイ音矛盾</li>\n                    <li>遅れガコッ！</li>\n                    <li>強ガコッ！</li>\n                    <li>全無音</li>\n                </ul>\n            </section>\n\n            \n        </div>\n\n        <p class=\"js-menu2\" id=\"destination16\">ボーナス音</p>\n        <div class=\"contents2\">\n            <section>\n                <h3>概要</h3>\n                <p>ある発生条件を満たすと、通常とは異なる特別なボーナス音が鳴ります。</p>\n                <p>(ビッグボーナスについて)</p>\n\n                <h4>スペシャルボーナス音</h4>\n                <p>決まったゲーム数でビッグボーナスに当選した場合、ボーナス音が変化します。</p>\n                <table border=\"1\">\n                    <tbody>\n                        <tr>\n                            <th>ボーナス音</th>\n                            <th style=\"width:60%;\">条件</th>\n                        </tr>\n                        <tr>\n                            <td>軍艦マーチ(男性ver.)</td>\n                            <td>ボーナス後1G目に<br>ビッグボーナスが当選</td>\n                        </tr>\n                        <tr>\n                            <td>軍艦マーチ(女性ver.)</td>\n                            <td>不明</td>\n                        </tr>\n                        <tr>\n                            <td>第九</td>\n                            <td>ボーナス後2～5G目に<br>ビッグボーナスが当選</td>\n                        </tr>\n                        <tr>\n                            <td>運命</td>\n                            <td>ボーナス後100G以内のゾロ目<br>ゲーム数でビッグボーナスが当選</td>\n                        </tr>\n                        <tr>\n                            <td>みんなの<br>GOGO!チャンス</td>\n                            <td>ビッグボーナス終了後<br>55G目でビッグボーナスが当選</td>\n                        </tr>\n                    </tbody>\n                </table>\n\n                <h4>プレミアムボーナス音</h4>\n                <p>特定のプレミアム演出発生時は、ボーナス音が変化します。</p>\n                <table border=\"1\">\n                    <tbody>\n                        <tr>\n                            <th>プレミアム演出</th>\n                            <th style=\"width:50%;\">ボーナス音</th>\n                        </tr>\n                        <tr>\n                            <td>オっぽ＆チュー助点灯</td>\n                            <td rowspan=\"2\">トルコ行進曲ガコッ!ver.</td>\n                        </tr>\n                        <tr>\n                            <td>まろ吉点灯</td>\n                        </tr>\n                        <tr>\n                            <td>GOGO!のみ点灯</td>\n                            <td>初代アイムジャグラーEX<br>ボーナス音</td>\n                        </tr>\n                        <tr>\n                            <td rowspan=\"2\">CHANCEレインボー</td>\n                            <td>ラデツキー行進曲ガコッ!ver.</td>\n                        </tr>\n                        <tr>\n                            <td>アイネクライネ<br>ナハトムジーク<br>ガコッ!ver.</td>\n                        </tr>\n                    </tbody>\n                </table>\n            </section>\n\n            \n        </div>\n    </div>\n</div>","shukei":""}