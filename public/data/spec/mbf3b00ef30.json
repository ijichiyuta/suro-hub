{"spec":"<div id=\"post\">\n    <div class=\"tab\">\n        \n        <h1 class=\"setting\">設定狙い：設定判別</h1>\n       \n        <p class=\"js-menu\" style=\"display: none;\">まずはココを見ろ！</p>\n        <div class=\"contents\">\n            <div class=\"left\">\n                <h5>①</h5>\n                \n            </div>\n\n            <button class=\"close\">ー閉じる</button>\n        </div>\n\n\n        <p class=\"js-menu\">設定判別項目</p>\n        <div class=\"contents\">\n            <div>\n                <table border=\"1\">\n                    <caption>確定演出</caption>\n                    <tbody>\n                        <tr>\n                            <th style=\"width: 73%;\">項目</th>\n                            <th>重要度</th>\n                        </tr>\n                        <tr>\n                            <td><img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2022/12/下向きの矢印のアイコン素材.png\" class=\"icon-small\" alt=\"arrow\" loading=\"lazy\">ケロットトロフィー</td>\n                            <td>★★★☆☆</td>\n                        </tr>\n                    </tbody>\n                </table>\n                \n                <table border=\"1\">\n                    <caption>通常時</caption>\n                    <tbody>\n                        <tr>\n                            <th style=\"width: 73%;\">項目</th>\n                            <th>重要度</th>\n                        </tr>\n                        <tr>\n                            <td><img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2022/12/下向きの矢印のアイコン素材.png\" class=\"icon-small\" alt=\"arrow\" loading=\"lazy\">オレンジとリーチ目役の出現率</td>\n                            <td>★★★☆☆</td>\n                        </tr>\n                        <tr>\n                            <td><img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2023/10/new-7.png\" alt=\"new\" class=\"update-icon\" data-date=\"2024-04-26\" loading=\"lazy\">\n                                <img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2022/12/下向きの矢印のアイコン素材.png\" class=\"icon-small\" alt=\"arrow\" loading=\"lazy\">CZレベルごとのCZ出現率</td>\n                            <td>★☆☆☆☆</td>\n                        </tr>\n                        <tr>\n                            <td><img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2023/10/new-7.png\" alt=\"new\" class=\"update-icon\" data-date=\"2024-07-10\" loading=\"lazy\">\n                                <img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2022/12/下向きの矢印のアイコン素材.png\" class=\"icon-small\" alt=\"arrow\" loading=\"lazy\">ボーナス後128G以内の振り分け</td>\n                            <td>★★☆☆☆</td>\n                        </tr>\n                        <tr>\n                            <td><img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2023/10/new-7.png\" alt=\"new\" class=\"update-icon\" data-date=\"2024-07-10\" loading=\"lazy\">\n                                <img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2022/12/下向きの矢印のアイコン素材.png\" class=\"icon-small\" alt=\"arrow\" loading=\"lazy\">特定ゲーム数までのボーナス当選期待度</td>\n                            <td>★★★☆☆</td>\n                        </tr>\n                        <tr>\n                            <td><img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2023/10/new-7.png\" alt=\"new\" class=\"update-icon\" data-date=\"2024-07-10\" loading=\"lazy\">\n                                <img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2022/12/下向きの矢印のアイコン素材.png\" class=\"icon-small\" alt=\"arrow\" loading=\"lazy\">ボーナスループ当選率</td>\n                            <td>★☆☆☆☆</td>\n                        </tr>\n                        <tr>\n                            <td><img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2023/10/new-7.png\" alt=\"new\" class=\"update-icon\" data-date=\"2024-07-10\" loading=\"lazy\">\n                                <img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2022/12/下向きの矢印のアイコン素材.png\" class=\"icon-small\" alt=\"arrow\" loading=\"lazy\">ボーナスループ率振り分け</td>\n                            <td>★★☆☆☆</td>\n                        </tr>\n                    </tbody>\n                </table>\n                \n                <table border=\"1\">\n                    <caption>ボーナス中</caption>\n                    <tbody>\n                        <tr>\n                            <th style=\"width: 73%;\">項目</th>\n                            <th>重要度</th>\n                        </tr>\n                        <tr>\n                            <td><img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2022/12/下向きの矢印のアイコン素材.png\" class=\"icon-small\" alt=\"arrow\" loading=\"lazy\">1枚役契機のCZ当選率</td>\n                            <td>★★★☆☆</td>\n                        </tr>\n                    </tbody>\n                </table>\n                \n            </div>\n\n            <button class=\"close\">ー閉じる</button>\n        </div>\n\n\n        <p class=\"js-menu\" style=\"display: none;\">ざっくり設定判別</p>\n        <div class=\"contents\" style=\"display: none;\">\n            <div class=\"left\">\n                <img decoding=\"async\" src=\"https://media.slolaboratory.com/wp-content/uploads/2026/04/24005602/noimage1.jpg\" loading=\"lazy\">\n            </div>\n            <button class=\"close\">ー閉じる</button>\n        </div>\n        \n\n        <p class=\"js-menu\" style=\"display: none;\">ツモった際のやめ時</p>\n        <div class=\"contents\">\n            <div class=\"left\">\n                <h3>大まかな目安</h3>\n                <h4>やめ推奨時間</h4>\n                <p><img decoding=\"async\" src=\"https://media.slolaboratory.com/wp-content/uploads/2026/04/24005602/noimage1.jpg\" loading=\"lazy\"></p>\n                <h4>閉店欠損度</h4>\n                <p>☆☆☆☆☆</p>\n            </div>\n\n            <div class=\"left\">\n                <h3>解説</h3>\n                <p>現在調査中です。</p>\n            </div>\n\n            <button class=\"close\">ー閉じる</button>\n        </div>\n\n\n        <p class=\"js-menu\">スペック</p>\n        <div class=\"contents\">\n            <div class=\"left\">\n                <h3>CZ・ボーナス確率</h3>\n                <table border=\"1\">\n                    <tbody>\n                        <tr>\n                            <th>設定</th>\n                            <th style=\"width:35%;\">CZ</th>\n                            <th style=\"width:35%;\">ボーナス合算</th>\n                        </tr>\n                        <tr>\n                            <td>設定L</td>\n                            <td>－</td>\n                            <td>－</td>\n                        </tr>\n                        <tr>\n                            <td>設定1</td>\n                            <td>1/410.9</td>\n                            <td>1/154.8</td>\n                        </tr>\n                        <tr>\n                            <td>設定2</td>\n                            <td>1/410.9</td>\n                            <td>1/151.0</td>\n                        </tr>\n                        <tr>\n                            <td>設定4</td>\n                            <td>1/380.4</td>\n                            <td>1/127.4</td>\n                        </tr>\n                        <tr>\n                            <td>設定5</td>\n                            <td>1/357.9</td>\n                            <td>1/116.8</td>\n                        </tr>\n                        <tr>\n                            <td>設定6</td>\n                            <td>1/333.5</td>\n                            <td>1/106.4</td>\n                        </tr>\n                    </tbody>\n                </table>\n\n                <h4>ボーナス確率詳細</h4>\n                <table border=\"1\">\n                    <tbody>\n                        <tr>\n                            <th>設定</th>\n                            <th style=\"width:35%;\">BIG</th>\n                            <th style=\"width:35%;\">REG</th>\n                        </tr>\n                        <tr>\n                            <td>設定L</td>\n                            <td>－</td>\n                            <td>－</td>\n                        </tr>\n                        <tr>\n                            <td>設定1</td>\n                            <td>1/257.6</td>\n                            <td>1/387.8</td>\n                        </tr>\n                        <tr>\n                            <td>設定2</td>\n                            <td>1/251.4</td>\n                            <td>1/378.4</td>\n                        </tr>\n                        <tr>\n                            <td>設定4</td>\n                            <td>1/210.0</td>\n                            <td>1/324.2</td>\n                        </tr>\n                        <tr>\n                            <td>設定5</td>\n                            <td>1/191.8</td>\n                            <td>1/298.8</td>\n                        </tr>\n                        <tr>\n                            <td>設定6</td>\n                            <td>1/173.6</td>\n                            <td>1/274.9</td>\n                        </tr>\n                    </tbody>\n                </table>\n            </div>\n\n            <div class=\"left\">\n                <h3>出玉率</h3>\n                <table>\n                    <tbody>\n                        <tr>\n                            <th style=\"width: 30%;\">設定</th>\n                            <th>出玉率</th>\n                        </tr>\n                        <tr>\n                            <td>設定L</td>\n                            <td>－</td>\n                        </tr>\n                        <tr>\n                            <td>設定1</td>\n                            <td>97.7%</td>\n                        </tr>\n                        <tr>\n                            <td>設定2</td>\n                            <td>98.6%</td>\n                        </tr>\n                        <tr>\n                            <td>設定4</td>\n                            <td>105.5%</td>\n                        </tr>\n                        <tr>\n                            <td>設定5</td>\n                            <td>110.3%</td>\n                        </tr>\n                        <tr>\n                            <td>設定6</td>\n                            <td>114.9%</td>\n                        </tr>\n                    </tbody>\n                </table>\n\n                <div class=\"caution\">\n                    <p> 注意</p>\n                    <p>設定L搭載機、判別方法は調査中です。</p>\n                </div>\n            </div>\n            \n            <button class=\"close\">ー閉じる</button>\n        </div>\n\n\n        <p class=\"js-menu\">基本情報</p>\n        <div class=\"contents\">\n            <div class=\"left\">\n                <h3>天井・打ち方・詳細情報</h3>\n                <table border=\"1\">\n                    <tbody>\n                        <tr>\n                            <th style=\"width: 50%;\">項目</th>\n                            <th>記載</th>\n                        </tr><tr>\n                            <td><img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2022/12/下向きの矢印のアイコン素材.png\" class=\"icon-small\" alt=\"arrow\" loading=\"lazy\">天井情報</td>\n                            <td>ボーナス間天井</td>\n                        </tr>\n                        <tr>\n                            <td><img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2022/12/下向きの矢印のアイコン素材.png\" class=\"icon-small\" alt=\"arrow\" loading=\"lazy\">打ち方</td>\n                            <td>通常時の打ち方<br>ボーナス中の打ち方</td>\n                        </tr>\n                        <tr>\n                            <td><img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2022/12/下向きの矢印のアイコン素材.png\" class=\"icon-small\" alt=\"arrow\" loading=\"lazy\">ハイエナ詳細情報</td>\n                            <td>その他のハイエナ情報</td>\n                        </tr>\n                    </tbody>\n                </table>\n            </div>\n\n            <button class=\"close\">ー閉じる</button>\n        </div>\n    \n\n        <p class=\"js-menu\">数値詳細</p>\n        <div class=\"contents\">\n            <div class=\"left\">\n                <h3 id=\"destination1\">ケロットトロフィー</h3>\n                <p>BIG終了時に出現する可能性があり、ケロットトロフィーが出現すれば設定2以上濃厚となります。</p>\n                <table border=\"1\">\n                    <tbody>\n                        <tr>\n                            <th>種類</th>\n                            <th style=\"width:35%;\">示唆内容</th>\n                        </tr>\n                        <tr>\n                            <td><img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2024/02/kingpulsar__38.png\" loading=\"lazy\"><p>銅トロフィー</p></td>\n                            <td>設定2以上濃厚</td>\n                        </tr>\n                        <tr>\n                            <td><img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2024/02/kingpulsar__39.png\" loading=\"lazy\"><p>金トロフィー</p></td>\n                            <td style=\"color:#0071C1;\">設定4以上濃厚</td>\n                        </tr>\n                        <tr>\n                            <td><img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2024/02/kingpulsar__40.png\" loading=\"lazy\"><p>ケロット柄トロフィー</p></td>\n                            <td style=\"color:#FE0101;\">設定5以上濃厚</td>\n                        </tr>\n                        <tr>\n                            <td><img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2024/02/kingpulsar__41.png\" loading=\"lazy\"><p>虹トロフィー</p></td>\n                            <td style=\"color:#FE67FF;\">設定6濃厚</td>\n                        </tr>\n                    </tbody>\n                </table>\n            </div>\n\n            <div class=\"left\">\n                <h3 id=\"destination2\">オレンジとリーチ目役の出現率</h3>\n                <p>オレンジとリーチ目役の出現率に設定差があります。</p>\n                <p>特にオレンジは設定差があるのでカウントしましょう。</p>\n                <table border=\"1\">\n                    <tbody>\n                        <tr>\n                            <th>設定</th>\n                            <th style=\"width:25%;\">オレンジ</th>\n                            <th style=\"width:25%;\">リーチ目役</th>\n                            <th style=\"width:25%;\">合算</th>\n                        </tr>\n                        <tr>\n                            <td>設定1</td>\n                            <td>1/136.5</td>\n                            <td>1/1724.6</td>\n                            <td>1/96.7</td>\n                        </tr>\n                        <tr>\n                            <td>設定2</td>\n                            <td>1/134.3</td>\n                            <td>1/1724.6</td>\n                            <td>1/95.5</td>\n                        </tr>\n                        <tr>\n                            <td>設定4</td>\n                            <td>1/127.0</td>\n                            <td>1/1560.4</td>\n                            <td>1/91.3</td>\n                        </tr>\n                        <tr>\n                            <td>設定5</td>\n                            <td>1/120.5</td>\n                            <td>1/1560.4</td>\n                            <td>1/87.8</td>\n                        </tr>\n                        <tr>\n                            <td>設定6</td>\n                            <td>1/110.7</td>\n                            <td>1/1424.7</td>\n                            <td>1/82.1</td>\n                        </tr>\n                    </tbody>\n                </table>\n            </div>\n            \n        <div class=\"left\">\n            <h3 id=\"destination4\"><img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2023/10/new-7.png\" alt=\"new\" class=\"update-icon\" data-date=\"2024-04-26\" loading=\"lazy\">\n                CZレベルごとのCZ出現率</h3>\n                <div class=\"update-date\" data-date=\"2024-04-26\">2024/04/26更新</div>\n            <p>通常時のレア役成立時はCZレベルを参照してCZ抽選が行われます。</p><p>当選率には設定差がありませんが、オレンジ出現率に設定差があるため高設定ほど優遇されています。</p><p>(CZ突入率について)</p>\n            <table border=\"1\">\n                <tbody>\n                    <tr>\n                        <th rowspan=\"2\" style=\"width:16.7%;\">設定</th>\n                        <th colspan=\"5\">CZレベル</th>\n                    </tr>\n                    <tr>\n                        <th style=\"width:16.7%;\">Lv.1</th>\n                        <th style=\"width:16.7%;\">Lv.2</th>\n                        <th style=\"width:16.7%;\">Lv.3</th>\n                        <th style=\"width:16.7%;\">Lv.4</th>\n                        <th style=\"width:16.7%;\">Lv.5</th>\n                    </tr>\n                    <tr>\n                        <td>設定1</td>\n                        <td>1/806.6</td>\n                        <td>1/476.6</td>\n                        <td>1/303.1</td>\n                        <td>1/178.0</td>\n                        <td>1/102.4</td>\n                    </tr>\n                    <tr>\n                        <td>設定2</td>\n                        <td>1/798.6</td>\n                        <td>1/472.4</td>\n                        <td>1/300.3</td>\n                        <td>1/176.1</td>\n                        <td>1/101.1</td>\n                    </tr>\n                    <tr>\n                        <td>設定4</td>\n                        <td>1/771.9</td>\n                        <td>1/458.3</td>\n                        <td>1/290.9</td>\n                        <td>1/169.7</td>\n                        <td>1/96.9</td>\n                    </tr>\n                    <tr>\n                        <td>設定5</td>\n                        <td>1/746.8</td>\n                        <td>1/445.1</td>\n                        <td>1/282.2</td>\n                        <td>1/163.8</td>\n                        <td>1/93.1</td>\n                    </tr>\n                    <tr>\n                        <td>設定6</td>\n                        <td>1/707.5</td>\n                        <td>1/424.0</td>\n                        <td>1/268.3</td>\n                        <td>1/154.5</td>\n                        <td>1/87.1</td>\n                    </tr>\n                </tbody>\n            </table>\n        </div>\n\n            <div class=\"left\">\n                <h3 id=\"destination5\"><img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2023/10/new-7.png\" alt=\"new\" class=\"update-icon\" data-date=\"2024-07-10\" loading=\"lazy\">\n                ボーナス後128G以内の振り分け</h3>\n                <div class=\"update-date\" data-date=\"2024-07-10\">2024/07/10更新</div>\n                <p>ボーナス後はボーナスストックの有無でテーブルが異なり、ストック保有時は高設定ほど128G以内に放出されやすくなっています。</p>\n                <table border=\"1\" class=\"figcaption-table\">\n                    <tbody>\n                        <tr>\n                            <th style=\"width:50%;\">設定</th>\n                            <th>振り分け</th>\n                        </tr>\n                        <tr>\n                            <td>設定1</td>\n                            <td>50.0%</td>\n                        </tr>\n                        <tr>\n                            <td>設定2</td>\n                            <td>50.0%</td>\n                        </tr>\n                        <tr>\n                            <td>設定4</td>\n                            <td>55.1%</td>\n                        </tr>\n                        <tr>\n                            <td>設定5</td>\n                            <td>57.4%</td>\n                        </tr>\n                        <tr>\n                            <td>設定6</td>\n                            <td>60.2%</td>\n                        </tr>\n                    </tbody>\n                </table>\n            <figcaption class=\"left\">(※)ボーナスストック保有+ボーナスループ非当選時の数値。</figcaption>\n            </div>\n\n            <div class=\"left\">\n                <h3 id=\"destination6\"><img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2023/10/new-7.png\" alt=\"new\" class=\"update-icon\" data-date=\"2024-07-10\" loading=\"lazy\">\n                特定ゲーム数までのボーナス当選期待度</h3>\n                <div class=\"update-date\" data-date=\"2024-07-10\">2024/07/10更新</div>\n                <p>高設定ほど早いゲーム数で当選しやすいため、ハマりにくくなっています。</p>\n            <table border=\"1\" style=\"font-size: 90%;\" class=\"figcaption-table\">\n                <tbody>\n                    <tr>\n                        <th>設定</th>\n                        <th style=\"width:20%;\">1～32G</th>\n                        <th style=\"width:20%;\">1～128G</th>\n                        <th style=\"width:20%;\">1～256G</th>\n                        <th style=\"width:20%;\">1～384G</th>\n                    </tr>\n                    <tr>\n                        <td>設定1</td>\n                        <td>42.7%</td>\n                        <td>71.1%</td>\n                        <td>79.4%</td>\n                        <td>85.7%</td>\n                    </tr>\n                    <tr>\n                        <td>設定2</td>\n                        <td>43.0%</td>\n                        <td>71.4%</td>\n                        <td>79.8%</td>\n                        <td>86.2%</td>\n                    </tr>\n                    <tr>\n                        <td>設定4</td>\n                        <td>49.3%</td>\n                        <td>76.7%</td>\n                        <td>83.8%</td>\n                        <td>89.3%</td>\n                    </tr>\n                    <tr>\n                        <td>設定5</td>\n                        <td>51.8%</td>\n                        <td>79.3%</td>\n                        <td>85.8%</td>\n                        <td>90.7%</td>\n                    </tr>\n                    <tr>\n                        <td>設定6</td>\n                        <td>54.8%</td>\n                        <td>81.4%</td>\n                        <td>87.5%</td>\n                        <td>92.0%</td>\n                    </tr>\n                    <tr>\n                        <th>設定</th>\n                        <th style=\"width:20%;\">1～512G</th>\n                        <th style=\"width:20%;\">1～640G</th>\n                        <th style=\"width:20%;\">1～768G</th>\n                    </tr>\n                    <tr>\n                        <td>設定1</td>\n                        <td>92.4%</td>\n                        <td>95.3%</td>\n                        <td>97.6%</td>\n                    </tr>\n                    <tr>\n                        <td>設定2</td>\n                        <td>92.9%</td>\n                        <td>95.7%</td>\n                        <td>97.8%</td>\n                    </tr>\n                    <tr>\n                        <td>設定4</td>\n                        <td>94.7%</td>\n                        <td>96.7%</td>\n                        <td>98.4%</td>\n                    </tr>\n                    <tr>\n                        <td>設定5</td>\n                        <td>95.4%</td>\n                        <td>97.2%</td>\n                        <td>98.6%</td>\n                    </tr>\n                    <tr>\n                        <td>設定6</td>\n                        <td>96.1%</td>\n                        <td>97.7%</td>\n                        <td>98.9%</td>\n                    </tr>\n                </tbody>\n            </table>\n            <figcaption class=\"left\">(※)ボーナス当選となる全契機を含んだ数値。</figcaption>\n            </div>\n\n            <div class=\"left\">\n                <h3 id=\"destination7\"><img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2023/10/new-7.png\" alt=\"new\" class=\"up