106.0%</td>\n                        </tr>\n                        <tr>\n                            <td>設定6</td>\n                            <td>110.0%</td>\n                        </tr>\n                    </tbody>\n                </table>\n\n                <div class=\"caution\">\n                    <p> 注意</p>\n                    <p>設定Lは上下パネルが消灯します。</p>\n                </div>\n            </div>\n            \n            \n        </div>\n\n        <p class=\"js-menu\">基本情報</p>\n        <div class=\"contents\">\n            <div class=\"left\">\n                <h3>天井・打ち方・詳細情報</h3>\n                <table border=\"1\">\n                    <tbody>\n                        <tr>\n                            <th style=\"width: 50%;\">項目</th>\n                            <th>記載</th>\n                        </tr><tr>\n                            <td><img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2022/12/下向きの矢印のアイコン素材.png\" class=\"icon-small\" alt=\"arrow\" loading=\"lazy\">天井情報</td>\n                            <td>ボーナス間天井</td>\n                        </tr>\n                        <tr>\n                            <td><img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2022/12/下向きの矢印のアイコン素材.png\" class=\"icon-small\" alt=\"arrow\" loading=\"lazy\">打ち方</td>\n                            <td>通常時の打ち方<br>ボーナス中の打ち方</td>\n                        </tr>\n                        <tr>\n                            <td><img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2022/12/下向きの矢印のアイコン素材.png\" class=\"icon-small\" alt=\"arrow\" loading=\"lazy\">ハイエナ詳細情報</td>\n                            <td>その他のハイエナ情報</td>\n                        </tr>\n                    </tbody>\n                </table>\n            </div>\n\n            \n        </div>\n    \n        <p class=\"js-menu\">数値詳細</p>\n        <div class=\"contents\">\n            <div class=\"left\">\n                <h3 id=\"destination3\">通常モード中レア役でのボーナス当選率</h3>\n            <p>通常A・通常Bに滞在している間、レア役を引いた際の当選率に設定差が設けられています。</p>\n            <p>なお、スイカ契機のボーナスはBIG以上確定です。</p>\n            <div class=\"subtitle2\">レア役成立時のボーナス当選率</div>\n            <table border=\"1\">\n                <tbody>\n                    <tr>\n                        <th>設定</th>\n                        <th style=\"width:35%;\">チェリー</th>\n                        <th style=\"width:35%;\">スイカ</th>\n                    </tr>\n                    <tr>\n                        <td>設定1</td>\n                        <td>2.1%</td>\n                        <td>3.1%</td>\n                    </tr>\n                    <tr>\n                        <td>設定2</td>\n                        <td>2.4%</td>\n                        <td>3.2%</td>\n                    </tr>\n                    <tr>\n                        <td>設定3</td>\n                        <td>3.1%</td>\n                        <td>3.4%</td>\n                    </tr>\n                    <tr>\n                        <td>設定5</td>\n                        <td>3.5%</td>\n                        <td>3.8%</td>\n                    </tr>\n                    <tr>\n                        <td>設定6</td>\n                        <td>4.0%</td>\n                        <td>4.0%</td>\n                    </tr>\n                </tbody>\n            </table>\n\n            <div class=\"subtitle2\">全ての当選契機を含めたモード別のボーナス確率</div>\n            <table border=\"1\">\n                <tbody>\n                    <tr>\n                        <th>設定</th>\n                        <th style=\"width:35%;\">通常A</th>\n                        <th style=\"width:35%;\">通常B</th>\n                    </tr>\n                    <tr>\n                        <td>設定1</td>\n                        <td>1/331.6</td>\n                        <td>1/331.6</td>\n                    </tr>\n                    <tr>\n                        <td>設定2</td>\n                        <td>1/322.1</td>\n                        <td>1/322.1</td>\n                    </tr>\n                    <tr>\n                        <td>設定3</td>\n                        <td>1/298.1</td>\n                        <td>1/298.1</td>\n                    </tr>\n                    <tr>\n                        <td>設定5</td>\n                        <td>1/272.7</td>\n                        <td>1/272.7</td>\n                    </tr>\n                    <tr>\n                        <td>設定6</td>\n                        <td>1/250.7</td>\n                        <td>1/250.7</td>\n                    </tr>\n                </tbody>\n            </table>\n            </div>\n\n            <div class=\"left\">\n                <h3 id=\"destination4\">ボーナス割合</h3>\n                <p>若干ですが高設定ほどBIGの割合が優遇されています。</p>\n            <table border=\"1\">\n                <tbody>\n                    <tr>\n                        <th>設定</th>\n                        <th style=\"width:35%;\">BIG</th>\n                        <th style=\"width:35%;\">REG</th>\n                    </tr>\n                    <tr>\n                        <td>設定1</td>\n                        <td>53.4%</td>\n                        <td>46.6%</td>\n                    </tr>\n                    <tr>\n                        <td>設定2</td>\n                        <td>53.4%</td>\n                        <td>46.6%</td>\n                    </tr>\n                    <tr>\n                        <td>設定3</td>\n                        <td>53.4%</td>\n                        <td>46.6%</td>\n                    </tr>\n                    <tr>\n                        <td>設定5</td>\n                        <td>54.1%</td>\n                        <td>45.9%</td>\n                    </tr>\n                    <tr>\n                        <td>設定6</td>\n                        <td>55.3%</td>\n                        <td>44.7%</td>\n                    </tr>\n                </tbody>\n            </table>\n            <figcaption class=\"left\">(※)全状態の平均値。</figcaption>\n            </div>\n\n            <div class=\"left\">\n                <h3 id=\"destination1\">初代モード移行率</h3>\n                <p>初当りが早く、単発と3連を繰り返していく特殊なモードで、その突入率は設定ごとに変わります。</p>\n                <table border=\"1\">\n                    <tbody>\n                        <tr>\n                            <th>設定</th>\n                            <th style=\"width:35%;\">突入率</th>\n                            <th style=\"width:35%;\">継続率</th>\n                        </tr>\n                        <tr>\n                            <td>設定1</td>\n                            <td>約1/40000</td>\n                            <td rowspan=\"2\">低</td>\n                        </tr>\n                        <tr>\n                            <td>設定2</td>\n                            <td>約1/30000</td>\n                        </tr>\n                        <tr>\n                            <td>設定3</td>\n                            <td>約1/20000</td>\n                            <td>中</td>\n                        </tr>\n                        <tr>\n                            <td>設定5</td>\n                            <td>約1/10000</td>\n                            <td>高</td>\n                        </tr>\n                        <tr>\n                            <td>設定6</td>\n                            <td>約/7000</td>\n                            <td>超高</td>\n                        </tr>\n                    </tbody>\n                </table>\n            </div>\n\n            <div class=\"left\">\n                <h3 id=\"destination2\">ボーナス中の楽曲選択率</h3>\n                <p>ボーナス入賞のタイミングやボーナス消化中に流れる「感じてSunshine!!」ですが、この楽曲が選ばれる確率には設定差が存在します。</p>\n                <table border=\"1\">\n                    <tbody>\n                        <tr>\n                            <th>設定</th>\n                            <th style=\"width:50%;\">選択率</th>\n                        </tr>\n                        <tr>\n                            <td>設定1</td>\n                            <td>2.0%</td>\n                        </tr>\n                        <tr>\n                            <td>設定2</td>\n                            <td>4.0%</td>\n                        </tr>\n                        <tr>\n                            <td>設定3</td>\n                            <td>6.0%</td>\n                        </tr>\n                        <tr>\n                            <td>設定5</td>\n                            <td>8.0%</td>\n                        </tr>\n                        <tr>\n                            <td>設定6</td>\n                            <td>10.0%</td>\n                        </tr>\n                    </tbody>\n                </table>\n                <div class=\"memo\">\n                    <p> MEMO</p>                \n                    <p>「感じてSunshine!!」の歌い出しは、<br>「♪跳ねる飛沫 伝わる熱 舞え Blue sky...」となっています。</p>\n                </div>\n            </div>\n            \n            \n        </div>\n\n        <p class=\"js-menu\" style=\"display: none;\">高設定狙いに必要な演出法則</p>\n        <div class=\"contents\" style=\"display: none;\">\n            <div class=\"left\">\n                <img decoding=\"async\" src=\"https://media.slolaboratory.com/wp-content/uploads/2026/04/24005602/noimage1.jpg\" loading=\"lazy\">\n            </div>\n           \n            \n        </div>\n        \n    </div>\n</div>\n<section data-merge=\"ev\">\n<h2>基本情報</h2>\n<ul>\n<li>メーカー: オリンピアエステート</li>\n<li>機械割: 97.7% 〜 110.0%</li>\n<li>導入開始日: 2024年03月04日（月）</li>\n<li>ゲーム性概要: シリーズおなじみの遊び心地をそのままに、『南国育ち』がスマスロとして生まれ変わりました。通常時はキュイン音が鳴ってパトランプが光れば、その時点でボーナス確定という伝統的な仕様です。ボーナスのチャンスとなるのはレア役の成立時。ボーナスの種類は青BIG（約240枚）・赤BIG（約230枚）・REG（約85枚）の3つで、このうち青BIGならBIGの1G連が約束されます。ボーナス中にレア役を引くと、ここでもBIGの1G連が抽選されます。終盤に訪れるバタフライゾーン（8G）で蝶が舞えば、ボーナス1G連が手に入ります。仮にバタフライゾーンでボーナスを射止められなくても、今作から加わった（超）ときめきゾーン（32G）へと引き継がれるため、ボーナスへの期待は途切れません。ループ率約93%を誇る蝶飛翔モードも新たに用意されています。</li>\n</ul>\n<p><img loading=\"lazy\" alt=\"L南国育ち（パチスロ）のリール配列\" src=\"https://p-town.dmm.com/upload/machines/4512/reel.jpg?t=1779358795\"></p>\n<p><img loading=\"lazy\" alt=\"L南国育ち（パチスロ）のゲームフロー\" src=\"https://p-town.dmm.com/upload/machines/4512/flow.jpg?t=1779358795\"></p>\n<h2>打ち方</h2>\n<h3>打ち方・小役</h3>\n<h4>通常時の打ち方（小役狙い）</h4>\n<p>「最初に狙う絵柄」</p>\n<p><img loading=\"lazy\" alt=\"スマスロ南国育ち打ち方\" src=\"https://cdn.p-town.dmm.com/editor/_01_%E3%83%91%E3%83%81%E3%82%B9%E3%83%AD%E6%A9%9F%E7%A8%AE%E3%83%9A%E3%83%BC%E3%82%B8/S989_%E5%8D%97%E5%9B%BD%E8%82%B2%E3%81%A1/0228/0222-01-01.jpg\"></p>\n<p>まずは左リールの上段あたりにBARをねらいます。左リール上段にスイカが止まったケースを除けば、中リールと右リールはフリー打ちで問題ありません。</p>\n<p>「スイカ停止時」</p>\n<p>成立役…スイカ</p>\n<p><img loading=\"lazy\" alt=\"スマスロ南国育ち打ち方\" src=\"https://cdn.p-town.dmm.com/editor/_01_%E3%83%91%E3%83%81%E3%82%B9%E3%83%AD%E6%A9%9F%E7%A8%AE%E3%83%9A%E3%83%BC%E3%82%B8/S989_%E5%8D%97%E5%9B%BD%E8%82%B2%E3%81%A1/0228/a.jpg\"></p>\n<p>スイカには平行（3枚）と右下がり（リプレイ）という2通りのフラグがあります。このうちリプレイフラグは取りこぼしが起きないため、中リールはフリー打ちで進め、スイカが上段にテンパイした場合のみ右リールで青7を目印にスイカをねらいましょう。</p>\n<p>「レア役の停止形」</p>\n<p><img loading=\"lazy\" alt=\"スマスロ南国育ち打ち方レア役の停止形\" src=\"https://cdn.p-town.dmm.com/editor/_01_%E3%83%91%E3%83%81%E3%82%B9%E3%83%AD%E6%A9%9F%E7%A8%AE%E3%83%9A%E3%83%BC%E3%82%B8/S989_%E5%8D%97%E5%9B%BD%E8%82%B2%E3%81%A1/0228/0222-01-03.jpg\"></p>\n<h4>ボーナス中の打ち方</h4>\n<p>「基本はナビ通りに押せばOK」</p>\n<p><img loading=\"lazy\" alt=\"スマスロ南国育ちボーナス中の打ち方\" src=\"https://cdn.p-town.dmm.com/editor/_01_%E3%83%91%E3%83%81%E3%82%B9%E3%83%AD%E6%A9%9F%E7%A8%AE%E3%83%9A%E3%83%BC%E3%82%B8/S989_%E5%8D%97%E5%9B%BD%E8%82%B2%E3%81%A1/0228/0222-02-01.jpg\"></p>\n<p>ナビなし時は通常時と同様の左リールBAR狙いで消化しよう。</p>\n<h4>変則押しはNG</h4>\n<p>通常時は左リール第1停止での消化を推奨する。</p>\n<h2>解析情報通常時</h2>\n<h3>小役関連</h3>\n<h4>レア役確率</h4>\n<table>\n<thead>\n<tr>\n<th>役</th>\n<th>確率</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>チェリー</td>\n<td>1/50.0</td>\n</tr>\n<tr>\n<td>スイカ</td>\n<td>1/128.0</td>\n</tr>\n<tr>\n<td>レア役合算</td>\n<td>1/36.0</td>\n</tr>\n</tbody>\n</table>\n<h4>引き戻し・チャンス・初代</h4>\n<table>\n<thead>\n<tr>\n<th>設定</th>\n<th>チェリー</th>\n<th>スイカ</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>全設定共通</td>\n<td>6.3%</td>\n<td>12.6%</td>\n</tr>\n</tbody>\n</table>\n<p>スイカ契機のボーナスは赤7BIG以上が確定する。</p>\n<h3>モード</h3>\n<h4>モード概要</h4>\n<p>通常時は、どのモードに滞在しているかによって、ボーナスの当選確率・天井までのゲーム数・ボーナス当選時の移行先がそれぞれ変化します。</p>\n<p>連チャンモードにあたる飛翔モードは3種類用意されており、原則として飛翔Aと飛翔Bをループさせながら連チャンをつないでいきます。</p>\n<h4>通常時のモード概要</h4>\n<table>\n<thead>\n<tr>\n<th>モード</th>\n<th>特徴</th>\n<th>天井</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>通常A</td>\n<td>約50%で通常Bor飛翔モードへ移行</td>\n<td>996G</td>\n</tr>\n<tr>\n<td>通常B</td>\n<td>約50%で飛翔モードへ移行 飛翔モード突入まで転落ナシ</td>\n<td>996G</td>\n</tr>\n<tr>\n<td>引き戻し</td>\n<td>約56%で通常Bor飛翔モードへ移行</td>\n<td>200G</td>\n</tr>\n<tr>\n<td>チャンス</td>\n<td>設定変更後のみ移行 飛翔モードへ移行しなかった場合は通常Bへ</td>\n<td>200G</td>\n</tr>\n<tr>\n<td>必翔</td>\n<td>有利区間再突入時に移行する可能性あり ボーナス当選で飛翔モード移行確定</td>\n<td>32G</td>\n</tr>\n<tr>\n<td>初代</td>\n<td>初当り確率が高く、単発・約3連を繰り返す</td>\n<td>調査中</td>\n</tr>\n<tr>\n<td>初代</td>\n<td>高設定ほど入りやすく抜けにくいのが特徴で 滞在中の設定6の機械割は110.5% （設定1でも機械割は100%を超える）</td>\n<td>調査中</td>\n</tr>\n</tbody>\n</table>\n<h4>飛翔モード（連チャンモード）概要</h4>\n<table>\n<thead>\n<tr>\n<th>モード</th>\n<th>特徴</th>\n<th>天井</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>飛翔A</td>\n<td>約85%で飛翔Bへ移行</td>\n<td>32G</td>\n</tr>\n<tr>\n<td>飛翔B</td>\n<td>約75%で飛翔Aへ移行</td>\n<td>32G</td>\n</tr>\n<tr>\n<td>超飛翔</td>\n<td>約93%で超飛翔をループ</td>\n<td>32G</td>\n</tr>\n<tr>\n<td>超飛翔</td>\n<td>突入確率は約1/35000</td>\n<td>32G</td>\n</tr>\n</tbody>\n</table>\n<p>※1G連ストック・青7BIG・先飛翔赤7BIG・ときめきゾーンでの連チャン、これらのときにも飛翔AとBの移行抽選は実施されます。</p>\n<h4>有利区間移行時・モード振り分け</h4>\n<table>\n<thead>\n<tr>\n<th>モード</th>\n<th>設定変更時</th>\n<th>設定変更時以外</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>通常A</td>\n<td>30.0%</td>\n<td>ー</td>\n</tr>\n<tr>\n<td>通常B</td>\n<td>50.0%</td>\n<td>20.0%</td>\n</tr>\n<tr>\n<td>チャンス</td>\n<td>20.0%</td>\n<td>ー</td>\n</tr>\n<tr>\n<td>必翔</td>\n<td>ー</td>\n<td>80.0%</td>\n</tr>\n</tbody>\n</table>\n<h4>飛翔モード終了時のモード移行先</h4>\n<table>\n<thead>\n<tr>\n<th>滞在モード</th>\n<th>移行先</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>飛翔A終了時</td>\n<td>約75%で通常Bor引き戻しへ</td>\n</tr>\n<tr>\n<td>飛翔B終了時</td>\n<td>約50%で通常Bor引き戻しへ</td>\n</tr>\n<tr>\n<td>超飛翔終了時</td>\n<td>約75%で通常Bor引き戻しへ</td>\n</tr>\n<tr>\n<td>必翔経由の飛翔終了時</td>\n<td>必ず通常Bor引き戻しへ</td>\n</tr>\n</tbody>\n</table>\n<p>※飛翔A終了時はおもに偶数連での終了時、飛翔B終了時はおもに奇数連での終了時にあたります ※必翔経由については、必翔への突入契機が有利区間リセット後となる関係で、基本的に大量出玉を獲得したあとに訪れます。</p>\n<h4>飛翔モード以外からのモード移行率（ボーナス当選時）</h4>\n<table>\n<thead>\n<tr>\n<th>滞在モード</th>\n<th>通常Aへ</th>\n<th>通常Bへ</th>\n<th>飛翔へ</th>\n<th>超飛翔へ</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>通常A</td>\n<td>50.0%</td>\n<td>40.0%</td>\n<td>9.8%</td>\n<td>0.2%</td>\n</tr>\n<tr>\n<td>通常B</td>\n<td>ー</td>\n<td>50.0%</td>\n<td>49.8%</td>\n<td>0.2%</td>\n</tr>\n<tr>\n<td>引き戻し</td>\n<td>44.0%</td>\n<td>40.0%</td>\n<td>15.8%</td>\n<td>0.2%</td>\n</tr>\n<tr>\n<td>チャンス</td>\n<td>ー</td>\n<td>75.0%</td>\n<td>24.8%</td>\n<td>0.2%</td>\n</tr>\n<tr>\n<td>必翔</td>\n<td>ー</td>\n<td>ー</td>\n<td>95.0%</td>\n<td>5.0%</td>\n</tr>\n</tbody>\n</table>\n<h3>演出動画</h3>\n<h4>ロングフリーズ</h4>\n<p>ロングフリーズが起きたときは、青7BIGおよび超飛翔モードへの昇格が確定します。なお擬似遊技において中段チェリーが止まるパターンもあります。</p>\n<h3>フリーズ</h3>\n<h4>ロングフリーズ</h4>\n<p><img loading=\"lazy\" alt=\"スマスロ南国育ちロングフリーズ\" src=\"https://cdn.p-town.dmm.com/editor/_01_%E3%83%91%E3%83%81%E3%82%B9%E3%83%AD%E6%A9%9F%E7%A8%AE%E3%83%9A%E3%83%BC%E3%82%B8/S989_%E5%8D%97%E5%9B%BD%E8%82%B2%E3%81%A1/0303/0303-13-01.jpg\"></p>\n<p>超ときめきゾーン中にボーナスへ当選した場合の一部などで発生し、青7BIGと超飛翔モードへの昇格がいずれも確定します。</p>\n<h4>超飛翔モード移行時・ロングフリーズ発生率</h4>\n<table>\n<thead>\n<tr>\n<th>超飛翔モード移行契機</th>\n<th>発生率</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>必翔モード経由</td>\n<td>10.2%</td>\n</tr>\n<tr>\n<td>上記以外</td>\n<td>90.2%</td>\n</tr>\n</tbody>\n</table>\n<h4>ロングフリーズ発生確率＆期待獲得枚数</h4>\n<table>\n<thead>\n<tr>\n<th>項目</th>\n<th>内容</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>トータル確率</td>\n<td>約1/46000</td>\n</tr>\n<tr>\n<td>期待獲得枚数</td>\n<td>2500枚以上</td>\n</tr>\n</tbody>\n</table>\n<h2>解析情報ボーナス時</h2>\n<h3>ボーナス共通</h3>\n<h4>モードごとのボーナス確率</h4>\n<table>\n<thead>\n<tr>\n<th>設定</th>\n<th>通常A</th>\n<th>通常B</th>\n<th>初代</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>1</td>\n<td>1/331.6</td>\n<td>1/331.6</td>\n<td>1/160.0</td>\n</tr>\n<tr>\n<td>2</td>\n<td>1/322.1</td>\n<td>1/322.1</td>\n<td>1/160.0</td>\n</tr>\n<tr>\n<td>3</td>\n<td>1/298.1</td>\n<td>1/298.1</td>\n<td>1/160.0</td>\n</tr>\n<tr>\n<td>5</td>\n<td>1/272.7</td>\n<td>1/272.7</td>\n<td>1/160.0</td>\n</tr>\n<tr>\n<td>6</td>\n<td>1/250.7</td>\n<td>1/250.7</td>\n<td>1/160.0</td>\n</tr>\n<tr>\n<td>設定</td>\n<td>引き戻し</td>\n<td>チャンス</td>\n<td>合算</td>\n</tr>\n<tr>\n<td>1</td>\n<td>1/131.7</td>\n<td>1/106.1</td>\n<td>1/299.8</td>\n</tr>\n<tr>\n<td>2</td>\n<td>1/131.7</td>\n<td>1/106.1</td>\n<td>1/291.0</td>\n</tr>\n<tr>\n<td>3</td>\n<td>1/131.7</td>\n<td>1/106.1</td>\n<td>1/267.3</td>\n</tr>\n<tr>\n<td>5</td>\n<td>1/131.7</td>\n<td>1/106.1</td>\n<td>1/238.6</td>\n</tr>\n<tr>\n<td>6</td>\n<td>1/131.7</td>\n<td>1/106.1</td>\n<td>1/208.8</td>\n</tr>\n</tbody>\n</table>\n<h4>ボーナス当選時のBIG・REG割合</h4>\n<table>\n<thead>\n<tr>\n<th>設定</th>\n<th>全状態の平均</th>\n<th></th>\n<th>飛翔モード中</th>\n<th></th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>設定</td>\n<td>BIG</td>\n<td>REG</td>\n<td>BIG</td>\n<td>REG</td>\n</tr>\n<tr>\n<td>1</td>\n<td>53.4%</td>\n<td>46.6%</td>\n<td>56.7%</td>\n<td>43.3%</td>\n</tr>\n<tr>\n<td>2</td>\n<td>53.4%</td>\n<td>46.6%</td>\n<td>56.7%</td>\n<td>43.3%</td>\n</tr>\n<tr>\n<td>3</td>\n<td>53.4%</td>\n<td>46.6%</td>\n<td>56.7%</td>\n<td>43.3%</td>\n</tr>\n<tr>\n<td>5</td>\n<td>54.1%</td>\n<td>45.9%</td>\n<td>56.7%</td>\n<td>43.3%</td>\n</tr>\n<tr>\n<td>6</td>\n<td>55.3%</td>\n<td>44.7%</td>\n<td>56.7%</td>\n<td>43.3%</td>\n</tr>\n</tbody>\n</table>\n<h4>1G連ストック当選率</h4>\n<p>ボーナス中はレア役によって1G連ストックが抽選されており、当選した際は次ゲームのレバーONで蝶ランプが光って知らせてくれます。ロングフリーズを経由した青7BIGでは、レア役以外でも1G連ストックの抽選が行われます。ストックを保有している場合（青7BIG当選時などを含む）はバタフライゾーンを経ずに、すぐ次のボーナスへ突入します。</p>\n<h4>ボーナス中・1G連ストック当選率 初当りボーナス中（※）</h4>\n<table>\n<thead>\n<tr>\n<th>役</th>\n<th>当選率</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>レア役以外</td>\n<td>ー</td>\n</tr>\n<tr>\n<td>チェリー</td>\n<td>0.5%</td>\n</tr>\n<tr>\n<td>スイカ</td>\n<td>1.5%</td>\n</tr>\n</tbody>\n</table>\n<h4>連チャン中のボーナス中</h4>\n<table>\n<thead>\n<tr>\n<th>役</th>\n<th>当選率</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>レア役以外</td>\n<td>ー</td>\n</tr>\n<tr>\n<td>チェリー</td>\n<td>1.0%</td>\n</tr>\n<tr>\n<td>スイカ</td>\n<td>3.1%</td>\n</tr>\n</tbody>\n</table>\n<h4>ロングフリーズ経由の青7BIG中</h4>\n<table>\n<thead>\n<tr>\n<th>役</th>\n<th>当選率</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>レア役以外</td>\n<td>1.6%</td>\n</tr>\n<tr>\n<td>チェリー</td>\n<td>50.0%</td>\n</tr>\n<tr>\n<td>スイカ</td>\n<td>50.0%</td>\n</tr>\n</tbody>\n</table>\n<p>※初当りのボーナス中は当選率こそ低いものの、その代わり当選すれば飛翔モードへの移行が確定します。</p>\n<h3>ボーナス（BIG・REG）</h3>\n<h4>ボーナス概要</h4>\n<p><img loading=\"lazy\" alt=\"スマスロ南国育ちボーナス\" src=\"https://cdn.p-town.dmm.com/editor/_01_%E3%83%91%E3%83%81%E3%82%B9%E3%83%AD%E6%A9%9F%E7%A8%AE%E3%83%9A%E3%83%BC%E3%82%B8/S989_%E5%8D%97%E5%9B%BD%E8%82%B2%E3%81%A1/0228/0222-06-01.jpg\"></p>\n<p>消化中はレア役でBIG1G連ストックの抽選が行われ、蝶が舞えば1G連が確定します。あわせて滞在モードに応じた連チャン抽選も進んでおり、末尾8G間のバタフライゾーンで蝶が舞った場合も1G連が確定します。バタフライゾーンを含むボーナス中に告知がなかったとしても、ボーナス当選時の一部については、ボーナス後32G間の（蝶）ときめきゾーンで告知されます。</p>\n<h4>ボーナス性能</h4>\n<table>\n<thead>\n<tr>\n<th>項目</th>\n<th>青BIG</th>\n<th>赤BIG</th>\n<th>REG</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>獲得枚数</td>\n<td>約240枚</td>\n<td>約230枚</td>\n<td>約85枚</td>\n</tr>\n<tr>\n<td>ループ率</td>\n<td>モードごとに変化 最高ループ率は約93%（超飛翔モード）</td>\n<td></td>\n<td></td>\n</tr>\n<tr>\n<td>消化中の抽選</td>\n<td>レア役でBIG1G連ストックを抽選</td>\n<td></td>\n<td></td>\n</tr>\n<tr>\n<td>その他</td>\n<td>BIG1G連濃厚</td>\n<td>ー</td>\n<td>ー</td>\n</tr>\n</tbody>\n</table>\n<p>「SUPER LUCKYランプ」</p>\n<p><img loading=\"lazy\" alt=\"スマスロ南国育ちボーナス\" src=\"https://cdn.p-town.dmm.com/editor/_01_%E3%83%91%E3%83%81%E3%82%B9%E3%83%AD%E6%A9%9F%E7%A8%AE%E3%83%9A%E3%83%BC%E3%82%B8/S989_%E5%8D%97%E5%9B%BD%E8%82%B2%E3%81%A1/0228/0222-06-03.jpg\"></p>\n<p>SUPER LUCKYランプ点灯で、超飛翔モード濃厚！</p>\n<h3>バタフライゾーン</h3>\n<h4>バタフライゾーン概要</h4>\n<p><img loading=\"lazy\" alt=\"スマスロ南国育ちバタフライゾーン\" src=\"https://cdn.p-town.dmm.com/editor/_01_%E3%83%91%E3%83%81%E3%82%B9%E3%83%AD%E6%A9%9F%E7%A8%AE%E3%83%9A%E3%83%BC%E3%82%B8/S989_%E5%8D%97%E5%9B%BD%E8%82%B2%E3%81%A1/0228/0222-07-01.jpg\"></p>\n<p>ボーナス末尾の8Gで移行する連チャン告知の状態で、押し順ナビは出ません。終わるまでに蝶が舞えば1G連が確定します。</p>\n<h4>ボーナス告知タイミング</h4>\n<p>バタフライゾーンで連チャンを告知するケースでは、何ゲーム目に告知するのかも抽選で決まります。飛翔モード中かつバタフライゾーン滞在中の告知ゲーム数を決める際には、次次回までの連チャンが確定する特殊抽選も同時に行われます。</p>\n<h4>バタフライゾーンの連チャン告知タイミング振り分け</h4>\n<table>\n<thead>\n<tr>\n<th>タイミング</th>\n<th>振り分け</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>1G目</td>\n<td>10.0%</td>\n</tr>\n<tr>\n<td>2G目</td>\n<td>10.0%</td>\n</tr>\n<tr>\n<td>3G目</td>\n<td>10.0%</td>\n</tr>\n<tr>\n<td>4G目</td>\n<td>10.0%</td>\n</tr>\n<tr>\n<td>5G目</td>\n<td>10.0%</td>\n</tr>\n<tr>\n<td>6G目</td>\n<td>10.0%</td>\n</tr>\n<tr>\n<td>7G目</td>\n<td>10.0%</td>\n</tr>\n<tr>\n<td>8G目</td>\n<td>20.0%</td>\n</tr>\n<tr>\n<td>逆転</td>\n<td>10.0%</td>\n</tr>\n</tbody>\n</table>\n<h4>連チャン時・特殊抽選当選率</h4>\n<table>\n<thead>\n<tr>\n<th>モード</th>\n<th>当選率</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>飛翔A</td>\n<td>3.1%</td>\n</tr>\n<tr>\n<td>飛翔B</td>\n<td>3.1%</td>\n</tr>\n<tr>\n<td>超飛翔</td>\n<td>3.1%</td>\n</tr>\n</tbody>\n</table>\n<p>※特殊抽選当選で次次回までの連チャンが確定</p>\n<p>この特殊抽選に当選していると、蝶が赤く光るといった確定演出が発生することがあります。</p>\n<h3>（超）ときめきゾーン</h3>\n<h4>ときめきゾーン概要</h4>\n<p><img loading=\"lazy\" alt=\"スマスロ南国育ちときめきゾーン概要\" src=\"https://cdn.p-town.dmm.com/editor/_01_%E3%83%91%E3%83%81%E3%82%B9%E3%83%AD%E6%A9%9F%E7%A8%AE%E3%83%9A%E3%83%BC%E3%82%B8/S989_%E5%8D%97%E5%9B%BD%E8%82%B2%E3%81%A1/0228/0222-08-01.jpg\"></p>\n<p>バタフライゾーンが終わったあとの32G間がときめきゾーンです。連チャン時は基本的にボーナス中かバタフライゾーンで告知されますが、その一部はときめきゾーンまで持ち越されます。筐体の右側にある紫織ランプが赤く点灯すれば、32G以内の連チャンが濃厚で、なおかつ超飛翔モードへの移行も期待できる超ときめきゾーンとなります。</p>\n<p>「超ときめきゾーン（紫織ランプ赤点灯）」</p>\n<p><img loading=\"lazy\" alt=\"スマスロ南国育ち超ときめきゾーン\" src=\"https://cdn.p-town.dmm.com/editor/_01_%E3%83%91%E3%83%81%E3%82%B9%E3%83%AD%E6%A9%9F%E7%A8%AE%E3%83%9A%E3%83%BC%E3%82%B8/S989_%E5%8D%97%E5%9B%BD%E8%82%B2%E3%81%A1/0228/0222-08-02.jpg\"></p>\n<h4>（超）ときめきゾーン中・ボーナス当選率 （ときめきゾーンは内部的に飛翔モード以上の場合の数値）</h4>\n<table>\n<thead>\n<tr>\n<th>役</th>\n<th>ときめきゾーン</th>\n<th>超ときめきゾーン</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>チェリー</td>\n<td>6.3%</td>\n<td>12.6%</td>\n</tr>\n<tr>\n<td>スイカ</td>\n<td>12.6%</td>\n<td>25.0%</td>\n</tr>\n</tbody>\n</table>\n<h4>超飛翔モード昇格率</h4>\n<p>超ときめきゾーン中にボーナスへ当選すると、超飛翔モードへの昇格が抽選されます。レア役で当選したときは1/2で昇格するため見逃せません。加えて、当選時の一部ではロングフリーズが発生します。ロングフリーズに当選した場合、その50.0%で中段チェリー（擬似遊技）が停止します。</p>\n<h4>超ときめきゾーン中のボーナス当選時 超飛翔モード昇格率</h4>\n<table>\n<thead>\n<tr>\n<th>役</th>\n<th>昇格率</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>レア役以外</td>\n<td>25.0%</td>\n</tr>\n<tr>\n<td>レア役</td>\n<td>50.0%</td>\n</tr>\n</tbody>\n</table>\n<h4>超飛翔モード昇格時・ロングフリーズ発生率</h4>\n<table>\n<thead>\n<tr>\n<th>ロングフリーズ</th>\n<th>発生率</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>発生</td>\n<td>90.2%</td>\n</tr>\n</tbody>\n</table>\n<h4>超ときめきゾーン移行率</h4>\n<p>ボーナス開始時のモードをもとに、ボーナス終了時点で超ときめきゾーンへ移行するかどうかを抽選します（飛翔モードが継続、つまり連チャン確定のケースで抽選されます）。</p>\n<h4>ボーナス開始時・超ときめきゾーン移行率</h4>\n<table>\n<thead>\n<tr>\n<th>モード</th>\n<th>移行率</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>飛翔A→飛翔Bへの継続時</td>\n<td>1.0%</td>\n</tr>\n<tr>\n<td>飛翔B→飛翔Aへの継続時</td>\n<td>5.0%</td>\n</tr>\n</tbody>\n</table>\n<h3>ボーナス共通</h3>\n<h4>連チャン告知タイミング</h4>\n<p>飛翔モードによる連チャンをバタフライゾーンで告知するか、それとも続くときめきゾーンで告知するかは、ボーナス開始時に抽選されており、約80%はバタフライゾーンでの告知となります。</p>\n<p>飛翔モードへ入ったあとは、少なくとも1回は蝶ランプ点灯による1G連が発生するまで飛翔モードが続く仕様です。そのため、32G以内にボーナスへ当選してすぐ終わったとしても、蝶ランプ点灯による1G連の告知がなかったのであれば、そもそも飛翔モードへは移行していなかったということになります。</p>\n<h4>連チャン告知タイミング振り分け</h4>\n<table>\n<thead>\n<tr>\n<th>タイミング</th>\n<th>振り分け</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>バタフライゾーン</td>\n<td>80.1%</td>\n</tr>\n<tr>\n<td>ときめきゾーン</td>\n<td>19.9%</td>\n</tr>\n</tbody>\n</table>\n<h2>演出情報</h2>\n<h3>通常時</h3>\n<h4>違和感演出のパターン（一部）</h4>\n\n<p>停止音の変化や、各ランプが一瞬だけ点いて消えるといった違和感を覚える系の演出が出れば、ボーナスは濃厚です。</p>\n<p>［シークレット蝶ランプ］</p>\n<p><img loading=\"lazy\" alt=\"スマスロ南国育ちシークレット蝶ランプ\" src=\"https://cdn.p-town.dmm.com/editor/_01_%E3%83%91%E3%83%81%E3%82%B9%E3%83%AD%E6%A9%9F%E7%A8%AE%E3%83%9A%E3%83%BC%E3%82%B8/S989_%E5%8D%97%E5%9B%BD%E8%82%B2%E3%81%A1/0228/0222-04-02.jpg\"></p>\n<p>蝶ランプの下にいる蝶がひっそりと点灯！</p>\n<p>［パト部屋］</p>\n<p><img loading=\"lazy\" alt=\"スマスロ南国育ちパト部屋\" src=\"https://cdn.p-town.dmm.com/editor/_01_%E3%83%91%E3%83%81%E3%82%B9%E3%83%AD%E6%A9%9F%E7%A8%AE%E3%83%9A%E3%83%BC%E3%82%B8/S989_%E5%8D%97%E5%9B%BD%E8%82%B2%E3%81%A1/0228/0222-04-03.jpg\"></p>\n<p>パトランプの背景部分が虹色に光れば!?</p>\n<h4>プリリプ</h4>\n<p><img loading=\"lazy\" alt=\"スマスロ南国育ちプリリプ\" src=\"https://cdn.p-town.dmm.com/editor/_01_%E3%83%91%E3%83%81%E3%82%B9%E3%83%AD%E6%A9%9F%E7%A8%AE%E3%83%9A%E3%83%BC%E3%82%B8/S989_%E5%8D%97%E5%9B%BD%E8%82%B2%E3%81%A1/0228/0222-05-01.jpg\"></p>\n<p>プリリプ（予告音とリプレイ停止時の停止音変化）が出た場合、ボーナス期待度は約50%です。第3停止ボタンを長押しすると、ボーナス当選時の一部でCHANCEランプが点灯します。長押しの際にVボタンが開いたりバイブが起きたりすれば、さらなる恩恵に期待できるかもしれません。</p>\n<h4>通常時・ときめきゾーン共通の演出法則1</h4>\n<table>\n<thead>\n<tr>\n<th>演出</th>\n<th></th>\n<th>法則</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>特殊 テンパイ音</td>\n<td>ドゥルリ</td>\n<td>BIG確定</td>\n</tr>\n<tr>\n<td>特殊 テンパイ音</td>\n<td>BIG入賞ジングルの一部</td>\n<td>BIG＋飛翔確定</td>\n</tr>\n<tr>\n<td>特殊 テンパイ音</td>\n<td>超ラッキー</td>\n<td>BIG＋飛翔＋飛翔SP確定</td>\n</tr>\n<tr>\n<td>予告音発生でリプレイ・レア役を否定</td>\n<td></td>\n<td>ボーナス確定</td>\n</tr>\n<tr>\n<td>クイックキュイン</td>\n<td></td>\n<td>BIG確定</td>\n</tr>\n<tr>\n<td>リバーブキュイン</td>\n<td></td>\n<td>BIG確定</td>\n</tr>\n<tr>\n<td>やまびこキュイン</td>\n<td></td>\n<td>BIG確定</td>\n</tr>\n<tr>\n<td>線香花火キュイン</td>\n<td></td>\n<td>BIG確定</td>\n</tr>\n<tr>\n<td>流れ星キュイン</td>\n<td></td>\n<td>BIG確定</td>\n</tr>\n<tr>\n<td>逆回転キュイン</td>\n<td></td>\n<td>BIG確定</td>\n</tr>\n<tr>\n<td>チャンスランプ消灯キュイン</td>\n<td></td>\n<td>BIG確定</td>\n</tr>\n<tr>\n<td>パトランプロング回転キュイン</td>\n<td></td>\n<td>BIG確定</td>\n</tr>\n<tr>\n<td>第1停止キュイン（※）</td>\n<td></td>\n<td>BIG確定</td>\n</tr>\n<tr>\n<td>予告音＋第1停止キュイン（※）</td>\n<td></td>\n<td>BIG確定</td>\n</tr>\n<tr>\n<td>SPウェイトキュイン</td>\n<td></td>\n<td>BIG＋飛翔確定</td>\n</tr>\n<tr>\n<td>超SPウェイトキュイン</td>\n<td></td>\n<td>青BIG＋飛翔確定</td>\n</tr>\n<tr>\n<td>337拍子キュイン</td>\n<td></td>\n<td>BIG＋飛翔確定</td>\n</tr>\n<tr>\n<td>上下パネル消灯キュイン</td>\n<td></td>\n<td>BIG＋飛翔確定</td>\n</tr>\n<tr>\n<td>Vボタンバイブキュイン</td>\n<td></td>\n<td>BIG＋飛翔確定</td>\n</tr>\n<tr>\n<td>ハルルナキュイン</td>\n<td></td>\