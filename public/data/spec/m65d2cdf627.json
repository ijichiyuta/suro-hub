       <tr>\n                            <th style=\"width:50%;\">成立役</th>\n                            <th>出現率(設定1)</th>\n                        </tr>\n                        <tr>\n                            <td>リプレイ</td>\n                            <td>約1/7.3</td>\n                        </tr>\n                        <tr>\n                            <td>ベル</td>\n                            <td>約1/7.7</td>\n                        </tr>\n                        <tr>\n                            <td>スイカ</td>\n                            <td>約1/25.4</td>\n                        </tr>\n                        <tr>\n                            <td>チェリー</td>\n                            <td>約1/40.0</td>\n                        </tr>\n                        <tr>\n                            <td>チャンス目</td>\n                            <td>約1/1638</td>\n                        </tr>\n                    </tbody>\n                </table>\n\n                \n            </section>\n\n            <section>\n                <h3>50枚ごとの回転数</h3>\n                <table border=\"1\">\n                    <tbody>\n                        <tr>\n                            <th>設定</th>\n                            <th style=\"width:50%;\">50枚ごとの回転数</th>\n                        </tr>\n                        <tr>\n                            <td>設定1</td>\n                            <td class=\"copy-saki1\"></td>\n                        </tr>\n                        <tr>\n                            <td>設定2</td>\n                            <td rowspan=\"3\">不明</td>\n                        </tr>\n                        <tr>\n                            <td>設定5</td>\n                        </tr>\n                        <tr>\n                            <td>設定6</td>\n                        </tr>\n                    </tbody>\n                </table>\n            </section>\n\n            \n        </div>\n\n\n        <p class=\"js-menu2\" id=\"destination4\">天井情報</p>\n        <div class=\"contents2\">\n            <section>\n                <h3 id=\"destination5\">ゲーム数天井</h3>\n                <table border=\"1\">\n                    <tbody>\n                        <tr>\n                            <th style=\"width: 30%;\">天井条件</th>\n                            <td>非搭載</td>\n                        </tr>\n                        <tr>\n                            <th>恩恵</th>\n                            <td>－</td>\n                        </tr>\n                    </tbody>\n                </table>\n            </section>\n\n\n            \n        </div>\n\n\n        <p class=\"js-menu2\" id=\"destination8\">有利区間切れ条件・恩恵</p>\n        <div class=\"contents2\">\n            <section>\n                <h3>有利区間切れタイミング</h3>\n                <p>本機は有利区間非搭載となります。</p>\n            </section>\n\n            \n        </div>\n\n\n        <p class=\"js-menu2\">リセット判別</p>\n        <div class=\"contents2\">\n            <section>\n                <h3 id=\"destination500\">朝イチの挙動</h3>\n                <table border=\"1\">\n                    <tbody>\n                        <tr>\n                            <th>項目</th>\n                            <th style=\"width: 33.3%;\">設定変更</th>\n                            <th style=\"width: 33.3%;\">電源OFF→ON</th>\n                        </tr>\n                        <tr>\n                            <td>天井</td>\n                            <td>－</td>\n                            <td>－</td>\n                        </tr>\n                        <tr>\n                            <td>リールガックン</td>\n                            <td>無効</td>\n                            <td>－</td>\n                        </tr>\n                    </tbody>\n                </table>\n            </section>\n\n            \n        </div>\n\n\n        \n    </div>\n\n\n\n    <p class=\"js-menu\">設定狙い</p>\n    <div class=\"contents\">\n        \n\n\n        <p class=\"js-menu2\">設定判別項目</p>\n        <div class=\"contents2\">\n            \n\n            <section>\n                <h3>通常時</h3>\n                <table border=\"1\">\n                    <tbody>\n                        <tr>\n                            <th style=\"width: 73%;\">項目</th>\n                            <th>重要度</th>\n                        </tr>\n                        <tr>\n                            <td><img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2022/12/下向きの矢印のアイコン素材.png\" class=\"icon-small\" alt=\"arrow\" loading=\"lazy\">ボーナス確率</td>\n                            <td>★★★☆☆</td>\n                        </tr>\n                    </tbody>\n                </table>\n            </section>\n\n            \n            <section>\n                <h3>ボーナス中</h3>\n                <table border=\"1\">\n                    <tbody>\n                        <tr>\n                            <th style=\"width: 73%;\">項目</th>\n                            <th>重要度</th>\n                        </tr>\n                        <tr>\n                            <td><img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2022/12/下向きの矢印のアイコン素材.png\" class=\"icon-small\" alt=\"arrow\" loading=\"lazy\">REG終了時のリールバックランプ消灯</td>\n                            <td>★★☆☆☆</td>\n                        </tr>\n                    </tbody>\n                </table>\n            </section>\n            \n\n            \n        </div>\n\n        \n\n        \n    </div>\n\n\n\n    <p class=\"js-menu\">通常時</p>\n    <div class=\"contents\">\n        <p class=\"js-menu2\">通常時の抽選</p>\n        <div class=\"contents2\">\n            <section>\n                <h3>概要</h3>\n                <img decoding=\"async\" src=\"https://media.slolaboratory.com/wp-content/uploads/2025/05/jackpot__14.jpg\" loading=\"lazy\">\n                <p>通常時は毎ゲーム全役でボーナス当選を目指します。</p>\n                <p>リール上部のセグが可動すれば、ボーナス当選となります。</p>\n                <p>ビッグボーナスに当選した場合は、終了後に「ボーナストリガー」が発動します。</p>\n                <p>ボーナストリガー中は、レギュラーボーナス当選までボーナスが当選し続けます。</p>\n                \n                <p>(ボーナス当選契機について)</p>\n                <p>(ビッグボーナスについて)</p>\n                <p>(レギュラーボーナスについて)</p>\n                <p>(ボーナストリガーについて)</p>\n            </section>\n\n            \n        </div>\n\n\n        \n\n        <p class=\"js-menu2\" id=\"destination12\">ボーナス当選契機</p>\n        <div class=\"contents2\">\n            <section>\n                <h3>概要</h3>\n                <p>ボーナスは毎ゲーム全役で当選する可能性があり、単独ボーナスの当選割合が一番高くなっています。</p>\n                <p>また、リプレイテンパイハズレやチャンス目出現時はボーナス当選濃厚となります。</p>\n                <p>(ビッグボーナスについて)</p>\n                <p>(レギュラーボーナスについて)</p>\n            </section>\n\n            \n        </div>\n\n\n        \n    </div>\n\n\n\n    <p class=\"js-menu\" id=\"destination14\">ボーナス</p>\n    <div class=\"contents\">\n        <p class=\"js-menu2\" id=\"destination15\">ビッグボーナス</p>\n        <div class=\"contents2\">\n            <section>\n                <h3>概要</h3>\n                <table border=\"1\">\n                    <tbody>\n                        <tr>\n                            <th style=\"width: 50%;\">項目</th>\n                            <th>内容</th>\n                        </tr>\n                        <tr>\n                            <td>図柄</td>\n                            <td><img decoding=\"async\" src=\"https://media.slolaboratory.com/wp-content/uploads/2025/05/jackpot_bonus1.jpg\" loading=\"lazy\">\n                            </td>\n                        </tr>\n                        <tr>\n                            <td rowspan=\"2\">突入契機</td>\n                            <td>通常時の抽選</td>\n                        </tr>\n                        <tr>\n                            <td>ボーナストリガー中の抽選</td>\n                        </tr>\n                        <tr>\n                            <td>継続ゲーム数</td>\n                            <td>104枚払い出しまで</td>\n                        </tr>\n                        <tr>\n                            <td>獲得枚数</td>\n                            <td>最大89枚</td>\n                        </tr>\n                        <tr>\n                            <td>移行先</td>\n                            <td>ボーナストリガー</td>\n                        </tr>\n                    </tbody>\n                </table>\n                <p>ボーナス消化中は一度だけ逆押しを行うことで、最大枚数を獲得することできます。</p>\n                <p>ボーナス終了後は2枚掛け遊技となり、ボーナストリガーが発動します。</p>\n                <p>(ボーナス中の打ち方について)</p>\n                <p>(ボーナストリガーについて)</p>\n            </section>\n\n            \n        </div>\n\n\n        <p class=\"js-menu2\" id=\"destination17\">レギュラーボーナス</p>\n        <div class=\"contents2\">\n            <section>\n                <h3>概要</h3>\n                <table border=\"1\">\n                    <tbody>\n                        <tr>\n                            <th style=\"width: 50%;\">項目</th>\n                            <th>内容</th>\n                        </tr>\n                        <tr>\n                            <td>図柄</td>\n                            <td><img decoding=\"async\" src=\"https://media.slolaboratory.com/wp-content/uploads/2025/05/jackpot_bonus2.jpg\" loading=\"lazy\">\n                            </td>\n                        </tr>\n                        <tr>\n                            <td rowspan=\"2\">当選契機</td>\n                            <td>通常時の抽選</td>\n                        </tr>\n                        <tr>\n                            <td>ボーナストリガー中の抽選</td>\n                        </tr>\n\n                        <tr>\n                            <td>継続ゲーム数</td>\n                            <td>104枚払い出しまで</td>\n                        </tr>\n                        <tr>\n                            <td>獲得枚数</td>\n                            <td>最大89枚</td>\n                        </tr>\n                        <tr>\n                            <td>移行先</td>\n                            <td>通常時</td>\n                        </tr>\n                    </tbody>\n                </table>\n                <p>ボーナス消化中は一度だけ逆押しを行うことで、最大枚数を獲得することができます。</p>\n                <p>ボーナス終了後は通常時へ移行します。</p>\n                <p>(ボーナス中の打ち方について)</p>\n                <p>(REG終了時のリールバックランプ消灯について)</p>\n            </section>\n\n            \n        </div>\n    </div>\n\n\n\n    <p class=\"js-menu\">ボーナストリガー</p>\n    <div class=\"contents\">\n        <p class=\"js-menu2\" id=\"destination16\">ボーナストリガー概要</p>\n        <div class=\"contents2\">\n            <section>\n                <h3>概要</h3>\n                <img decoding=\"async\" src=\"https://media.slolaboratory.com/wp-content/uploads/2025/05/jackpot__15.jpg\" loading=\"lazy\">\n                <table border=\"1\">\n                    <tbody>\n                        <tr>\n                            <th style=\"width: 50%;\">項目</th>\n                            <th>内容</th>\n                        </tr>\n                        <tr>\n                            <td>詳細</td>\n                            <td>ボーナストリガー</td>\n                        </tr>\n                        <tr>\n                            <td>ボーナス確率</td>\n                            <td>高確率</td>\n                        </tr>\n                        <tr>\n                            <td>継続期待度</td>\n                            <td>約67%(設定1)</td>\n                        </tr>\n                    </tbody>\n                </table>\n                <p>ボーナストリガー中は基本的に即ボーナスに当選します。</p>\n                <p>ビッグボーナスに当選し続ける限りボーナストリガー継続となります。</p>\n                <p>(ビッグボーナスについて)</p>\n                <p>(レギュラーボーナスについて)</p>\n\n                <h4>終了条件</h4>\n                <p>レギュラーボーナス当選でボーナストリガー終了となり、通常時へ移行します。</p>\n            </section>\n\n            \n        </div>\n    </div>\n\n\n\n\n    <p class=\"js-menu\">設定示唆演出</p>\n    <div class=\"contents\">\n        <p class=\"js-menu2\" id=\"destination18\">REG終了時のリールバックランプ消灯</p>\n        <div class=\"contents2\">\n            <section>\n                <h3>概要</h3>\n                <table>\n                    <tbody>\n                        <tr>\n                            <th>設定</th>\n                            <th>消灯発生率</th>\n                        </tr>\n                        <tr>\n                            <td>設定1</td>\n                            <td>約10%</td>\n                        </tr>\n                        <tr>\n                            <td>設定2</td>\n                            <td>約13%</td>\n                        </tr>\n                        <tr>\n                            <td>設定5</td>\n                            <td>約17%</td>\n                        </tr>\n                        <tr>\n                            <td>設定6</td>\n                            <td>約20%</td>\n                        </tr>\n                    </tbody>\n                </table>\n                <p>REG終了時はリールバックランプが消灯する可能性があり、設定を示唆しています。</p>\n            </section>\n\n            \n        </div>\n    </div>\n\n\n\n\n    <p class=\"js-menu\">その他の演出</p>\n    <div class=\"contents\">\n        <p class=\"js-menu2\">カスタム</p>\n        <div class=\"contents2\">\n            <section>\n                <h3>概要</h3>\n                <p>通常時やビッグボーナス終了時にPUSHボタンを押すことで、演出モードを切り替えることができます。</p>\n                <table border=\"1\">\n                    <tbody>\n                        <tr>\n                            <th style=\"width:50%;\">演出モード</th>\n                            <th>特徴</th>\n                        </tr>\n                        <tr>\n                            <td>ノーマルモード<br>(ドキドキモード)</td>\n                            <td>主に第3停止後に<br>ボーナスを告知</td>\n                        </tr>\n                        <tr>\n                            <td>沖スロモード<br>(バレバレモード)</td>\n                            <td>主にレバーオン時に<br>ボーナスを告知</td>\n                        </tr>\n                    </tbody>\n                </table>\n            </section>\n\n            \n        </div>\n\n\n        <p class=\"js-menu2\">通常時の演出</p>\n        <div class=\"contents2\">\n            <section>\n                <h3>演出一覧</h3>\n                <h4>セグ演出</h4>\n                <img decoding=\"async\" src=\"https://media.slolaboratory.com/wp-content/uploads/2025/05/jackpot__15.jpg\" loading=\"lazy\">\n                <p>第3停止後にリール上部のセグが可動すると、ボーナス濃厚となります。</p>\n                <p>さらに、停止時に表示されるセグの数字によって、ボーナスの種類が示唆されます。</p>\n                <table border=\"1\">\n                    <tbody>\n                        <tr>\n                            <th style=\"width:50%;\">セグ種類</th>\n                            <th>示唆内容</th>\n                        </tr>\n                        <tr>\n                            <td>3</td>\n                            <td>ボーナス濃厚</td>\n                        </tr>\n                        <tr>\n                            <td>7</td>\n                            <td>BIG濃厚</td>\n                        </tr>\n                    </tbody>\n                </table>\n\n                <h4>リムーブ演出</h4>\n                <p>小役揃い後にリールが動くリムーブ演出が搭載されています。発生時はボーナス濃厚となります。</p>\n                <table border=\"1\">\n                    <tbody>\n                        <tr>\n                            <th style=\"width:25%;\">演出</th>\n                            <th style=\"width:50%;\">変化内容</th>\n                            <th style=\"width:25%;\">恩恵</th>\n                        </tr>\n                        <tr>\n                            <td>リプレイ<br>リムーブ</td>\n                            <td>リプレイ揃い<br>⇒リプレイテンパイハズレ</td>\n                            <td>ボーナス濃厚</td>\n                        </tr>\n                        <tr>\n                            <td>チェリー<br>リムーブ</td>\n                            <td>角チェリー<br>⇒中段チェリー</td>\n                            <td>BIG濃厚</td>\n                        </tr>\n                    </tbody>\n                </table>\n\n                <h4>プレミアム演出</h4>\n                <table border=\"1\">\n                    <tbody>\n                        <tr>\n                            <th style=\"width:50%;\">演出</th>\n                            <th style=\"width:50%;\">示唆内容</th>\n                        </tr>\n                        <tr>\n                            <td>遅れ</td>\n                            <td>ボーナス濃厚</td>\n                        </tr>\n                        <tr>\n                            <td>バウンドストップ</td>\n                            <td>ボーナス濃厚</td>\n                        </tr>\n                        <tr>\n                            <td>リプレイ音変化</td>\n                            <td>ボーナス濃厚</td>\n                        </tr>\n                        <tr>\n                            <td>Vフラッシュ</td>\n                            <td>BIG濃厚</td>\n                        </tr>\n                        <tr>\n                            <td>消灯</td>\n                            <td>BIG濃厚</td>\n                        </tr>\n                        <tr>\n                            <td>無音</td>\n                            <td>BIG濃厚</td>\n                        </tr>\n                    </tbody>\n                </table>\n            </section>\n            \n        </div>\n\n\n        \n    </div>\n</div>","shukei":""}