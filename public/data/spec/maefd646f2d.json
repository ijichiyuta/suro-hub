table>\n                <table border=\"1\">\n                    <caption>5001～6000G消化時の<br>トロフィー出現期待度</caption>\n                    <tbody>\n                        <tr>\n                            <th>設定</th>\n                            <th>銅</th>\n                            <th>銀</th>\n                            <th>金</th>\n                            <th>キリン</th>\n                            <th>虹</th>\n                        </tr>\n                        <tr>\n                            <td>設定1</td>\n                            <td>ー</td>\n                            <td rowspan=\"2\">ー</td>\n                            <td rowspan=\"3\">ー</td>\n                            <td rowspan=\"4\">ー</td>\n                            <td rowspan=\"5\">ー</td>\n                        </tr>\n                        <tr>\n                            <td>設定2</td>\n                            <td>4.80％</td>\n                        </tr>\n                        <tr>\n                            <td>設定3</td>\n                            <td>4.20％</td>\n                            <td rowspan=\"4\">1.20％</td>\n                        </tr>\n                        <tr>\n                            <td>設定4</td>\n                            <td rowspan=\"3\">3.90％</td>\n                            <td rowspan=\"3\">1.80％</td>\n                        </tr>\n                        <tr>\n                            <td>設定5</td>\n                            <td rowspan=\"2\">1.20％</td>\n                        </tr>\n                        <tr>\n                            <td>設定6</td>\n                            <td>0.60％</td>\n                        </tr>\n                    </tbody>\n                </table>\n                <table border=\"1\">\n                    <caption>6001～7000G消化時の<br>トロフィー出現期待度</caption>\n                    <tbody>\n                        <tr>\n                            <th>設定</th>\n                            <th>銅</th>\n           