td>2.9%</td>\n\t\t\t<td>95.7%</td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td>400~600</td>\n\t\t\t<td>1/359.2</td>\n\t\t\t<td>527.5枚</td>\n\t\t\t<td></td>\n\t\t\t<td>717</td>\n\t\t\t<td>3.1%</td>\n\t\t\t<td>98.4%</td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td>600~800</td>\n\t\t\t<td>1/372.4</td>\n\t\t\t<td>484.1枚</td>\n\t\t\t<td></td>\n\t\t\t<td>543</td>\n\t\t\t<td>3.3%</td>\n\t\t\t<td>94.6%</td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td>800~1000</td>\n\t\t\t<td>1/364.0</td>\n\t\t\t<td>526.8枚</td>\n\t\t\t<td></td>\n\t\t\t<td>404</td>\n\t\t\t<td>4.0%</td>\n\t\t\t<td>97.9%</td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td>1000~1200</td>\n\t\t\t<td>1/346.4</td>\n\t\t\t<td>546.6枚</td>\n\t\t\t<td></td>\n\t\t\t<td>374</td>\n\t\t\t<td>6.7%</td>\n\t\t\t<td>100.7%</td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td>1200~1400</td>\n\t\t\t<td>1/356.3</td>\n\t\t\t<td>565.2枚</td>\n\t\t\t<td></td>\n\t\t\t<td>248</td>\n\t\t\t<td>9.3%</td>\n\t\t\t<td>100.9%</td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td>1400~1600</td>\n\t\t\t<td>1/367.3</td>\n\t\t\t<td>485.7枚</td>\n\t\t\t<td></td>\n\t\t\t<td>201</td>\n\t\t\t<td>10.0%</td>\n\t\t\t<td>95.1%</td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td>1600~1800</td>\n\t\t\t<td>1/331.5</td>\n\t\t\t<td>657.9枚</td>\n\t\t\t<td></td>\n\t\t\t<td>149</td>\n\t\t\t<td>15.4%</td>\n\t\t\t<td>108.9%</td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td>1800~2000</td>\n\t\t\t<td>1/336.1</td>\n\t\t\t<td>983.9枚</td>\n\t\t\t<td></td>\n\t\t\t<td>97</td>\n\t\t\t<td>30.9%</td>\n\t\t\t<td>124.8%</td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td>&gt;2000</td>\n\t\t\t<td>1/364.4</td>\n\t\t\t<td>846.3枚</td>\n\t\t\t<td></td>\n\t\t\t<td>95</td>\n\t\t\t<td>25.3%</td>\n\t\t\t<td>115.4%</td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td>総計</td>\n\t\t\t<td>1/348.9</td>\n\t\t\t<td>507.1枚</td>\n\t\t\t<td></td>\n\t\t\t<td>12414</td>\n\t\t\t<td>3.2%</td>\n\t\t\t<td>98.1%</td>\n\t\t</tr>\n\t</tbody>\n</table></div>\n\n\n\n\n\n\n\n<p>前回ST終了時点の有利区間差枚が1600枚を超えている場合、<strong>上位CZ突入率が大きく跳ね上がる</strong>傾向が見られ、<br>有利区間切れを狙える可能性があります。</p>\n\n\n\n<p>ただし、ハマるにつれて差枚が目減りし有利切れも遠ざかるため、<br>現時点のサンプルでは450Gゾーンまでを狙い目の上限としています。</p>\n\n\n\n<p class=\"is-style-bottom-margin-1em has-bottom-margin\"><strong>駆け抜け後はST当選まで続行するのが得策</strong>と考えられます。</p>\n\n\n\n<p class=\"is-style-bottom-margin-2em has-bottom-margin\">サンプルが増え次第、また検証します。</p>\n\n\n\n<p class=\"is-style-bottom-margin-3em has-bottom-margin\">なお、有利区間は上位CZ（女神降臨）突入のたびに切れている様子です。</p>\n\n\n\n<p id=\"7a870cc9-6ba6-495e-b458-8b55f1a86b3d\">今回は以上です。</p>\n\n\n\n<p id=\"ab1d7416-12dd-4d14-a1c4-f6572c9e6898\">ありがとうございました。</p>\n\n\n\n\n\n\n\n<p class=\"has-text-align-right\"><br><span class=\"bold-green\"><span class=\"fz-24px\"><span class=\"fz-24px\"><span class=\"bold-red\"><span class=\"marker-under\">らばー</span></span></span></span></span></p>\n\n\n\n\n\n\n\n<div class=\"thank-you-overlay\" id=\"thankYouMessage\">\n    <div class=\"thank-you-message\">\n        <p class=\"thank-you-title\">回答ありがとうございました</p>\n        <p>貴重なご意見をお寄せいただき、誠にありがとうございます。<br>\n        いただいたフィードバックは今後のコラム改善に活かしてまいります。<br>\n        これからもどうぞよろしくお願いいたします。</p>\n        <button type=\"button\" class=\"ok-button\" id=\"okButton\">OK</button>\n    </div>\n</div>\n\n\n<div id=\"surveyContainer\">\n    <form id=\"columnSurveyForm\" action=\"javascript:void(0);\" method=\"POST\">\n        <p class=\"form-title\">コラムに関するアンケート</p>\n        <div class=\"survey-preview\" id=\"surveyContent\">\n            <div class=\"survey-gradient\" id=\"surveyGradient\">\n                <div class=\"survey-gradient-text\">アンケートに回答する</div>\n            </div>\n            <p>コンテンツ改善のため、ご意見をお聞かせください。<br>\n            <span style=\"font-size: 14px; color: #666;\">※このアンケートは送信専用です。対応が必要なお問い合わせに関しましてはお問い合わせからご送信ください。</span></p>\n            \n            \n            <input type=\"hidden\" name=\"entry.1733601021\" value=\"\" id=\"userId\">\n            \n            \n            <input type=\"hidden\" name=\"entry.1012224330\" value=\"\" id=\"deviceName\">\n            \n            \n            <input type=\"hidden\" name=\"entry.965993628\" value=\"\" id=\"articleName\">\n            \n            \n            <p style=\"background-color: #915EA3; color: white; padding: 8px; margin-top: 15px; margin-bottom: 8px; border-radius: 4px; font-size: 16px; font-weight: normal;\">各見出しについて、理解度を教えてください</p>\n            \n            \n            \n            \n            \n            <p style=\"background-color: #915EA3; color: white; padding: 8px; margin-top: 15px; margin-bottom: 8px; border-radius: 4px; font-size: 16px; font-weight: normal;\">コラム全体に関してその他ご意見がある場合はお知らせください</p>\n            \n            \n            \n            \n            <button type=\"submit\">送信</button>\n        </div>\n    </form>\n    <button class=\"teaser-close\" id=\"closeButton\" style=\"display: none;\">ー閉じる</button>\n</div>","neraiNav":[{"label":"狙い目に影響するポイント","id":"nsec0"},{"label":"ST間天井狙い","id":"nsec1"},{"label":"CZポイント天井狙い","id":"nsec2"},{"label":"有利区間差枚狙い","id":"nsec3"},{"label":"女神の舞ステージ狙い","id":"nsec4"},{"label":"示唆演出狙い","id":"nsec5"},{"label":"規定ゲーム数狙い","id":"nsec6"},{"label":"女神ポイント狙い","id":"nsec7"},{"label":"CZポイントの即前兆","id":"nsec8"},{"label":"CZ当選時","id":"nsec9"}]}