g=\"lazy\">\n            </div>\n            \n        </div>\n\n        <p class=\"js-menu\" style=\"display: none;\">ツモった際のやめ時</p>\n        <div class=\"contents\" style=\"display: none;\">\n            <div class=\"left\">\n                <h3>大まかな目安</h3>\n                <h4>やめ推奨時間</h4>\n                <p><img decoding=\"async\" src=\"https://media.slolaboratory.com/wp-content/uploads/2026/04/24005602/noimage1.jpg\" loading=\"lazy\"></p>\n                <h4>閉店欠損度</h4>\n                <p>☆☆☆☆☆</p>\n            </div>\n\n            <div class=\"left\">\n                <h3>解説</h3>\n                <p>現在調査中です。</p>\n            </div>\n\n            \n        </div>\n\n\n\n        <p class=\"js-menu\"><img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2023/10/new-7.png\" alt=\"new\" class=\"update-icon\" data-date=\"2024-06-30\" loading=\"lazy\">ツモった際のやめ時</p>\n    <div class=\"contents\">\n        <div class=\"left\">\n            <h3>大まかな目安</h3>\n            \n            <h4>やめ推奨時間</h4>\n            <p>閉店1時間半前</p>\n            <h4>閉店欠損度</h4>\n            <p>★★☆☆☆</p>\n        </div>\n\n        <div class=\"left\">\n            <h3>解説</h3>\n            <p>上位AT以外は一撃性能は大きくないため、閉店取り切れずは発生しにくい機種です。</p>\n            <p>ただしボーナス後の高確で数珠連を目指す仕様なので、ギリギリまで打つのは非推奨。</p>\n            <p>示唆演出に気を配り、状態が通常まで落ちたことを確認して閉店1時間半前以降を目安にやめましょう。</p>\n        </div>\n\n        \n    </div>\n\n\n\n\n\n        <p class=\"js-menu\">スペック</p>\n        <div class=\"contents\">\n            <div class=\"left\">\n                <h3 id=\"destination2\">ボーナス(AT)確率</h3>\n                <div class=\"tbl-scroll\"><table>\n                    <tbody>\n                        <tr>\n                            <th style=\"width:25%;\">設定</th>\n                            <th style=\"width:25%;\">バトル<br>ボーナス</th>\n                            <th style=\"width:25%;\">樽ボーナス</th>\n                            <th style=\"width:25%;\">合算</th>\n                        </tr>\n                        <tr>\n                            <td>設定1</td>\n                            <td>1/296.9</td>\n                            <td>1/363.2</td>\n                            <td>1/163.3</td>\n                        </tr>\n                        <tr>\n                            <td>設定2</td>\n                            <td>1/291.8</td>\n                            <td>1/361.1</td>\n                            <td>1/161.4</td>\n                        </tr>\n                        <tr>\n                            <td>設定3</td>\n                            <td>1/280.8</td>\n                            <td>1/353.8</td>\n                            <td>1/156.6</td>\n                        </tr>\n                        <tr>\n                            <td>設定4</td>\n                            <td>1/268.3</td>\n                            <td>1/347.8</td>\n                            <td>1/151.5</td>\n                        </tr>\n                        <tr>\n                            <td>設定5</td>\n                            <td>1/254.3</td>\n                            <td>1/338.6</td>\n                            <td>1/145.2</td>\n                        </tr>\n                        <tr>\n                            <td>設定6</td>\n                            <td>1/234.5</td>\n                            <td>1/323.1</td>\n                            <td>1/135.9</td>\n                        </tr>\n                    </tbody>\n                </table></div>\n            </div>\n\n            <div class=\"left\">\n                <h3>出玉率</h3>\n                <div class=\"tbl-scroll\"><table>\n                    <tbody>\n                        <tr>\n                            <th style=\"width:25%;\">設定</th>\n                            <th style=\"width:37.5%;\">市場予測値</th>\n                            <th>技術介入<br>(フル攻略)</th>\n                        </tr>\n                        <tr>\n                            <td>設定1</td>\n                            <td>97.7%</td>\n                            <td>103.4%</td>\n                        </tr>\n                        <tr>\n                            <td>設定2</td>\n                            <td>98.3%</td>\n                            <td>104.0%</td>\n                        </tr>\n                        <tr>\n                            <td>設定3</td>\n                            <td>102.6%</td>\n                            <td>105.2%</td>\n                        </tr>\n                        <tr>\n                            <td>設定4</td>\n                            <td>104.0%</td>\n                            <td>106.6%</td>\n                        </tr>\n                        <tr>\n                            <td>設定5</td>\n                            <td>105.7%</td>\n                            <td>108.1%</td>\n                        </tr>\n                        <tr>\n                            <td>設定6</td>\n                            <td>108.2%</td>\n                            <td>110.6%</td>\n                        </tr>\n                    </tbody>\n                </table></div>\n\n                \n            </div>\n\n            \n        </div>\n\n        <p class=\"js-menu\">基本情報</p>\n        <div class=\"contents\">\n            <div class=\"left\">\n                <h3>天井・打ち方・詳細情報</h3>\n                <div class=\"tbl-scroll\"><table border=\"1\">\n                    <tbody>\n                        <tr>\n                            <th style=\"width: 50%;\">項目</th>\n                            <th>記載</th>\n                        </tr><tr>\n                            <td><img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2022/12/下向きの矢印のアイコン素材.png\" class=\"icon-small\" alt=\"arrow\" loading=\"lazy\">天井情報\n                            </td>\n                            <td>非搭載</td>\n                        </tr>\n                        <tr>\n                            <td><img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2022/12/下向きの矢印のアイコン素材.png\" class=\"icon-small\" alt=\"arrow\" loading=\"lazy\">打ち方\n                            </td>\n                            <td>通常時の打ち方<br>ボーナス中の打ち方</td>\n                        </tr>\n                        <tr>\n                            <td><img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2022/12/下向きの矢印のアイコン素材.png\" class=\"icon-small\" alt=\"arrow\" loading=\"lazy\">ハイエナ詳細情報\n                            </td>\n                            <td>その他のハイエナ情報</td>\n                        </tr>\n                    </tbody>\n                </table></div>\n            </div>\n\n            \n        </div>\n\n        <p class=\"js-menu\">数値詳細</p>\n        <div class=\"contents\">\n            <div class=\"left\">\n                <h3 id=\"destination1\">エンタトロフィー</h3>\n                <img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2024/05/st5__68.jpg\" loading=\"lazy\">\n                <p>バトルボーナス終了画面でエンタトロフィーが出現すると特定設定以上濃厚となります。</p>\n                <div class=\"tbl-scroll\"><table border=\"1\">\n                    <tbody>\n                        <tr>\n                            <th style=\"width: 50%;\">トロフィー</th>\n                            <th>示唆内容</th>\n                        </tr>\n                        <tr>\n                            <td>銅</td>\n                            <td>設定2以上濃厚</td>\n                        </tr>\n                        <tr>\n                            <td>銀</td>\n                            <td>設定3以上濃厚</td>\n                        </tr>\n                        <tr>\n                            <td>金</td>\n                            <td style=\"color:#0071C1;\">設定4以上濃厚</td>\n                        </tr>\n                        <tr>\n                            <td>紅葉柄</td>\n                            <td style=\"color:#FE0101;\">設定5以上濃厚</td>\n                        </tr>\n                        <tr>\n                            <td>虹</td>\n                            <td style=\"color:#FE67FF;\">設定6濃厚</td>\n                        </tr>\n                    </tbody>\n                </table></div>\n            </div>\n\n            <div class=\"left\">\n                <h3 id=\"destination3\"><img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2023/10/new-7.png\" alt=\"new\" class=\"update-icon\" data-date=\"2024-06-17\" loading=\"lazy\">ボーナス直撃</h3>\n                \n                <p>スイカからのボーナス直撃は高設定ほど優遇されている模様です。</p>\n                <p>ボーナス直撃当選時はCZ「ミッション」を経由せずにボーナスが告知されます。</p>\n                <div class=\"tbl-scroll\"><table border=\"1\">\n                    <tbody>\n                        <tr>\n                            <th style=\"width: 50%;\">設定</th>\n                            <th>スイカ成立時の<br> 直撃当選率</th>\n                        </tr>\n                        <tr>\n                            <td>設定1</td>\n                            <td>0.4%</td>\n                        </tr>\n                        <tr>\n                            <td>設定2</td>\n                            <td>0.8%</td>\n                        </tr>\n                        <tr>\n                            <td>設定3</td>\n                            <td>1.2%</td>\n                        </tr>\n                        <tr>\n                            <td>設定4</td>\n                            <td>2.0%</td>\n                        </tr>\n                        <tr>\n                            <td>設定5</td>\n                            <td>2.7%</td>\n                        </tr>\n                        <tr>\n                            <td>設定6</td>\n                            <td>3.9%</td>\n                        </tr>\n                    </tbody>\n                </table></div>\n                <div class=\"memo\">\n                    <p>MEMO</p>\n                    <img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2024/05/st5__69.jpg\" loading=\"lazy\">\n                    <p>メニュー画面の遊技データから様々なデータを確認できます。</p>\n                    <p>ボーナス直撃回数も載っているので、空き台はチェックしてみましょう。</p>\n                </div>\n            </div>\n\n            <div class=\"left\">\n                <h3 id=\"destination4\"><img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2023/10/new-7.png\" alt=\"new\" class=\"update-icon\" data-date=\"2024-06-17\" loading=\"lazy\">バトルボーナス終了時の(超)高確移行率</h3>\n                \n                <p>バトルボーナス終了時には(超)高確移行抽選が行われています。</p>\n                <p>当選時は10ゲームから50ゲームの高確ゲーム数を獲得できます。</p>\n                <p>抽選順は超高確移行から行われ、当該抽選に漏れた場合に高確移行抽選が行われます。</p>\n\n                <h4>超高確移行抽選</h4>\n                <div class=\"tbl-scroll\"><table border=\"1\">\n                    <tbody>\n                        <tr>\n                            <th style=\"width: 20%;\">設定</th>\n\n                            <th style=\"width: 20%;\">10G</th>\n                            <th style=\"width: 20%;\">20G</th>\n                            <th style=\"width: 20%;\">30G</th>\n                            <th>50G</th>\n\n                        </tr>\n                        <tr>\n                            <td>設定1</td>\n                            <td>0.8%</td>\n                            <td>0.4%</td>\n                            <td>0.4%</td>\n<td rowspan=\"6\">-</td>\n                        </tr>\n                        <tr>\n                            <td>設定2</td>\n                            <td>1.2%</td>\n                            <td>0.4%</td>\n                            <td>0.4%</td>\n\n                        </tr>\n                        <tr>\n                            <td>設定3</td>\n                            <td>2.0%</td>\n                            <td>1.2%</td>\n                            <td>1.2%</td>\n\n                        </tr>\n                        <tr>\n                            <td>設定4</td>\n                            <td>2.7%</td>\n                            <td>1.6%</td>\n                            <td>1.2%</td>\n\n                        </tr>\n                        <tr>\n                            <td>設定5</td>\n                            <td>3.9%</td>\n                            <td>2.3%</td>\n                            <td>1.6%</td>\n\n                        </tr>\n                        <tr>\n                            <td>設定6</td>\n                            <td>6.6%</td>\n                            <td>3.9%</td>\n                            <td>2.7%</td>\n\n                        </tr>\n                    </tbody>\n                </table></div>\n                <h4>高確移行抽選</h4>\n                <div class=\"tbl-scroll\"><table border=\"1\">\n                    <tbody>\n                        <tr>\n                            <th style=\"width: 20%;\">設定</th>\n                           \n                            <th style=\"width: 20%;\">10G</th>\n                            <th style=\"width: 20%;\">20G</th>\n                            <th style=\"width: 20%;\">30G</th>\n                            <th>50G</th>\n                        </tr>\n                        <tr>\n                            <td>設定1</td>\n                            <td rowspan=\"6\">18.8%</td>\n                            <td>4.7%</td>\n                            <td>1.6%</td>\n                            <td>0.4%</td>\n                        </tr>\n                        <tr>\n                            <td>設定2</td>\n                            <td>6.3%</td>\n                            <td>2.0%</td>\n                            <td>0.4%</td>\n                        </tr>\n                        <tr>\n                            <td>設定3</td>\n                            <td>7.8%</td>\n                            <td>2.7%</td>\n                            <td>0.8%</td>\n                        </tr>\n                        <tr>\n                            <td>設定4</td>\n           