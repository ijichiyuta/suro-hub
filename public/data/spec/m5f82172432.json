{"nerai":"","spec":"<h1 class=\"setting\">機種情報・設定判別</h1>\n\n\n\n\n\n\n\n\n<div id=\"post\" class=\"all-page\">\n\n    \n\n    <p class=\"js-menu\">基本情報</p>\n    <div class=\"contents\">\n        <p class=\"js-menu2\">概要</p>\n        <div class=\"contents2\">\n            <section>\n                <h3 data-date2=\"\">概要</h3>\n                <table border=\"1\">\n                    <tbody>\n                        <tr>\n                            <th style=\"width: 50%;\">機種名</th>\n                            <td>スターハナハナ-30</td>\n                        </tr>\n                        <tr>\n                            <th>メーカー</th>\n                            <td>パイオニア</td>\n                        </tr>\n                        <tr>\n                            <th>タイプ</th>\n                            <td>ボーナス機</td>\n                        </tr>\n                        <tr>\n                            <th>ボーナス</th>\n                            <td>BIG...最大240枚<br>REG...最大96枚</td>\n                        </tr>\n                        <tr>\n                            <th>50枚ごとの回転数</th>\n                            <td>約39.9G</td>\n                        </tr>\n                        \n                        <tr>\n                            <th>導入日</th>\n                            <td>2025年1月6日</td>\n                        </tr>\n                    </tbody>\n                </table>\n            </section>\n\n            \n        </div>\n\n\n        <p class=\"js-menu2\" id=\"destination1\">スペック</p>\n        <div class=\"contents2\">\n            <section>\n                <h3 data-date2=\"\">ボーナス確率</h3>\n                <table border=\"1\">\n                    <tbody>\n                        <tr>\n                            <th style=\"width: 25%;\">設定</th>\n                            <th style=\"width: 25%;\">BIG</th>\n                            <th style=\"width: 25%;\">REG</th>\n                            <th>合算</th>\n                        </tr>\n                        <tr>\n                            <td>設定1</td>\n                            <td>1/270</td>\n                            <td>1/387</td>\n                            <td>1/159</td>\n                        </tr>\n                        <tr>\n                            <td>設定2</td>\n                            <td>1/262</td>\n                            <td>1/354</td>\n                            <td>1/150</td>\n                        </tr>\n                        <tr>\n                            <td>設定3</td>\n                            <td>1/252</td>\n                            <td>1/322</td>\n                            <td>1/141</td>\n                        </tr>\n                        <tr>\n                            <td>設定4</td>\n                            <td>1/240</td>\n                            <td>1/293</td>\n                            <td>1/132</td>\n                        </tr>\n                        <tr>\n                            <td>設定5</td>\n                            <td>1/229</td>\n                            <td>1/267</td>\n                            <td>1/123</td>\n                        </tr>\n                        <tr>\n                            <td>設定6</td>\n                            <td>1/218</td>\n                            <td>1/242</td>\n                            <td>1/114</td>\n                        </tr>\n                    </tbody>\n                </table>\n            </section>\n\n            <section>\n                <h3 data-date2=\"\">出玉率</h3>\n                <table border=\"1\">\n                    <tbody>\n                        <tr>\n                            <th style=\"width: 25%;\">設定</th>\n                            <th>出玉率</th>\n                        </tr>\n                        <tr>\n                            <td>設定1</td>\n                            <td>97%</td>\n                        </tr>\n                        <tr>\n                            <td>設定2</td>\n                            <td>99%</td>\n                        </tr>\n                        <tr>\n                            <td>設定3</td>\n                            <td>101%</td>\n                        </tr>\n                        <tr>\n                            <td>設定4</td>\n                            <td>104%</td>\n                        </tr>\n                        <tr>\n                            <td>設定5</td>\n                            <td>107%</td>\n                        </tr>\n                        <tr>\n                            <td>設定6</td>\n                            <td>110%</td>\n                        </tr>\n                    </tbody>\n                </table>\n            </section>\n\n            \n        </div>\n\n\n        <p class=\"js-menu2\">打ち方・リール配列</p>\n        <div class=\"contents2\">\n            <p class=\"js-menu3\">配当表</p>\n            <div class=\"contents3\">\n                <section>\n                    <h3 data-date2=\"\">配当表</h3>\n                    <img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2024/12/starhana__2.jpg\" loading=\"lazy\">\n                </section>\n\n                \n            </div>\n\n            <p class=\"js-menu3\" id=\"destination3\">リール配列</p>\n            <div class=\"contents3\">\n                <section>\n                    <h3>リール配列</h3>\n                    <img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2025/01/starhana__20.jpg\" loading=\"lazy\">\n                </section>\n\n                \n            </div>\n\n            <p class=\"js-menu3\" id=\"destination10\">通常時の打ち方</p>\n            <div class=\"contents3\">\n                <section>\n                    <h3 data-date2=\"\">通常時の打ち方</h3>\n                    <img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2024/12/starhana__3.jpg\" loading=\"lazy\">\n                    <p>左リール上段に<b>BAR</b>狙い。</p>\n\n                    <h4 data-date2=\"\">停止形A</h4>\n                    <img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2024/12/starhana__4.jpg\" loading=\"lazy\">\n                    <table border=\"1\">\n                        <tbody>\n                            <tr>\n                                <th style=\"width: 25%;\">成立役</th>\n                                <td>ハズレ・リプレイ・ベル</td>\n                            </tr>\n                        </tbody>\n                    </table>\n                    <p>中・右リールはフリー打ち。</p>\n\n                    <h4 data-date2=\"\">停止形B</h4>\n                    <img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2024/12/starhana__5.jpg\" loading=\"lazy\">\n                    <table border=\"1\">\n                        <tbody>\n                            <tr>\n                                <th style=\"width: 25%;\">成立役</th>\n                                <td>チェリー</td>\n                            </tr>\n                        </tbody>\n                    </table>\n                    <p>中・右リールはフリー打ち。</p>\n\n                    <h4 data-date2=\"\">停止形C</h4>\n                    <img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2024/12/starhana__6.jpg\" loading=\"lazy\">\n                    <table border=\"1\">\n                        <tbody>\n                            <tr>\n                                <th style=\"width: 25%;\">成立役</th>\n                                <td>スイカ</td>\n                            </tr>\n                        </tbody>\n                    </table>\n                    <p>中リールは<b style=\"color:#FE67FF;\">ピンク7</b>付近を意識してスイカを狙いつつ、右リールはボーナス図柄を回避しながらスイカを狙いましょう。</p>\n                    <p>(リール配列について)</p>\n                </section>\n\n                \n            </div>\n\n            <p class=\"js-menu3\" id=\"destination11\">ボーナス中の打ち方</p>\n            <div class=\"contents3\">\n                <section>\n                    <h3 data-date2=\"\">ボーナス中の打ち方</h3>\n                    <h4>BIG中</h4>\n                    <img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2024/12/starhana__19.jpg\" loading=\"lazy\">\n                    <p>リール左右のサイドランプが赤や緑に光ったときは、通常時と同じ手順でチェリーとスイカを取りこぼさないようにフォローします。</p>\n                    <p>上記以外はフリー打ちで消化することが可能です。</p>\n                    <p>(通常時の打ち方について)</p>\n                    <p>(ビッグボーナスについて)</p>\n\n                    <h4>REG中</h4>\n                    <img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2024/12/starhana__7.jpg\" loading=\"lazy\">\n                    <p>消化中は左リール中段へ<b>白7</b>を1回だけビタ押しし、それ以外のリールは通常時と同様の打ち方でスイカをフォローしてください。</p>\n                    <p>スイカが揃った場合は設定示唆が発生します。</p>\n                    <p>スイカを1度揃えたあとは、左リールへ白7以外を狙って消化していきます。</p>\n                    <p>(通常時の打ち方について)</p>\n                    <p>(レギュラーボーナスについて)</p>\n                    <p>(REG中のサイドランプについて)</p>\n                </section>\n\n                \n            </div>\n\n            <p class=\"js-menu3\">小役の停止形</p>\n            <div class=\"contents3\">\n                <section>\n                    <h3 data-date2=\"\">小役の停止形</h3>\n                    <table border=\"1\">\n                        <tbody>\n                            <tr>\n                                <th style=\"width: 50%;\">チェリー</th>\n                                <th>スイカ</th>\n                            </tr>\n                            <tr>\n                                <td class=\"bg-white\"><img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2024/12/starhana__8.jpg\" loading=\"lazy\"></td>\n                                <td><img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2024/12/starhana__9.jpg\" loading=\"lazy\"></td>\n                            </tr>\n                        </tbody>\n                    </table>\n                </section>\n\n                \n            </div>\n        </div>\n\n\n        <p class=\"js-menu2\">小役確率</p>\n        <div class=\"contents2\">\n            <section>\n                <h3 data-date2=\"\">小役確率詳細</h3>\n                <p>不明。</p>\n                \n            </section>\n\n            <section>\n                <h3 data-date2=\"\">50枚ごとの回転数</h3>\n                <table border=\"1\">\n                    <tbody>\n                        <tr>\n                            <th>設定</th>\n                            <th style=\"width:50%;\">50枚ごとの回転数</th>\n                        </tr>\n\n                        <tr>\n                            <td>設定1</td>\n                            <td>約39.9G</td>\n                        </tr>\n                        <tr>\n                            <td>設定2</td>\n                            <td rowspan=\"5\">不明</td>\n                        </tr>\n                        <tr>\n                            <td>設定3</td>\n\n                        </tr>\n                        <tr>\n                            <td>設定4</td>\n                        </tr>\n                        <tr>\n                            <td>設定5</td>\n\n                        </tr>\n                        <tr>\n                            <td>設定6</td>\n\n                        </tr>\n                    </tbody>\n                </table>\n            </section>\n\n            \n        </div>\n\n\n        <p class=\"js-menu2\">天井情報</p>\n        <div class=\"contents2\">\n            <section>\n                <h3 data-date2=\"\" id=\"destination2\">ゲーム数天井</h3>\n                <table border=\"1\">\n                    <tbody>\n                        <tr>\n                            <th style=\"width: 30%;\">天井条件</th>\n                            <td>非搭載</td>\n                        </tr>\n                        <tr>\n                            <th>恩恵</th>\n                            <td>－</td>\n                        </tr>\n                    </tbody>\n                </table>\n            </section>\n\n            \n        </div>\n\n\n        <p class=\"js-menu2\">有利区間切れ条件・恩恵</p>\n        <div class=\"contents2\">\n            <section>\n                <h3 data-date2=\"\">有利区間切れタイミングについて</h3>\n                <p>本機は有利区間非搭載となります。</p>\n            </section>\n\n            \n        </div>\n\n\n        <p class=\"js-menu2\">リセット判別</p>\n        <div class=\"contents2\">\n            <section>\n                <h3 data-date2=\"\" id=\"destination500\">朝イチの挙動</h3>\n                <table border=\"1\">\n                    <tbody>\n                        <tr>\n                            <th>項目</th>\n                            <th style=\"width: 33.3%;\">設定変更</th>\n                            <th style=\"width: 33.3%;\">電源OFF→ON</th>\n                        </tr>\n                        <tr>\n                            <td>天井</td>\n                            <td>－</td>\n                            <td>－</td>\n                        </tr>\n                        <tr>\n                            <td>リールガックン</td>\n                            <td>無効</td>\n                            <td>－</td>\n                        </tr>\n                    </tbody>\n                </table>\n\n                <h4 data-date2=\"2025/5/21\">設定変更時の挙動</h4>\n                <p>設定変更を行った場合、その日1回目のBIG終了時に50%以上の割合でフェザーランプの色変化が起こります。</p>\n                <p>(ボーナス終了後のフェザーランプについて)</p>\n\n                \n            </section>\n\n            \n        </div>\n\n\n        \n    </div>\n\n\n\n    <p class=\"js-menu\">設定狙い</p>\n    <div class=\"contents\">\n        \n\n        <p class=\"js-menu2\">設定判別項目</p>\n        <div class=\"contents2\">\n            \n\n            <section>\n                <h3 data-date2=\"\">通常時</h3>\n                <table border=\"1\">\n                    <tbody>\n                        <tr>\n                            <th style=\"width: 73%;\">項目</th>\n                            <th>重要度</th>\n                        </tr>\n                        <tr>\n                            <td><img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2022/12/下向きの矢印のアイコン素材.png\" class=\"icon-small\" alt=\"arrow\" loading=\"lazy\">ボーナス確率</td>\n                            <td>★★★★☆</td>\n                        </tr>\n                    </tbody>\n                </table>\n            </section>\n\n            <section>\n                <h3 data-date2=\"\">ボーナス中</h3>\n                <table border=\"1\">\n                    <tbody>\n                        <tr>\n                            <th style=\"width: 73%;\">項目</th>\n                            <th>重要度</th>\n                        </tr>\n                        <tr>\n                            <td><img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2022/12/下向きの矢印のアイコン素材.png\" class=\"icon-small\" alt=\"arrow\" loading=\"lazy\">REG中のサイドランプ</td>\n                            <td>☆☆☆☆☆</td>\n                        </tr>\n                        <tr>\n                            <td><img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2022/12/下向きの矢印のアイコン素材.png\" class=\"icon-small\" alt=\"arrow\" loading=\"lazy\">BIG中のスイカ出現率</td>\n                            <td>☆☆☆☆☆</td>\n                        </tr>\n                        <tr>\n                            <td><img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2022/12/下向きの矢印のアイコン素材.png\" class=\"icon-small\" alt=\"arrow\" loading=\"lazy\">ボーナス終了後のフェザーランプ</td>\n                            <td>☆☆☆☆☆</td>\n                        </tr>\n                    </tbody>\n                </table>\n            </section>\n            \n        </div>\n\n        \n\n        \n    </div>\n\n\n\n    <p class=\"js-menu\">通常時</p>\n    <div class=\"contents\">\n        <p class=\"js-menu2\" id=\"destination5\">通常時の抽選</p>\n        <div class=\"contents2\">\n            <section>\n                <h3 data-date2=\"\">概要</h3>\n                <img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2024/12/starhana__11.jpg\" loading=\"lazy\">\n                <p>通常時は全役でボーナス当選を目指します。</p>\n                <p>ハイビスカスランプが点灯すればボーナス当選濃厚となります。</p>\n                <p>(ビッグボーナスについて)</p>\n                <p>(レギュラーボーナスについて)</p>\n                \n                <h4>ボーナス告知の発生割合</h4>\n                <p>本作では消化したゲーム数に応じて、告知タイミングの割合が変わってきます。</p>\n                <table border=\"1\">\n                    <tbody>\n                        <tr>\n                            <th style=\"width:50%;\">告知</th>\n                            <th style=\"width:25%;\">1～100G</th>\n                            <th>101G～</th>\n                        </tr>\n                        <tr>\n                            <td>当選ゲームの<br>レバーオン時</td>\n                            <td>約85%</td>\n                            <td>約75%</td>\n                        </tr>\n                        <tr>\n                            <td>単独当選時の<br>次ゲームレバーオン</td>\n                            <td>約10%</td>\n                            <td>約20%</td>\n                        </tr>\n                        <tr>\n                            <td>チェリー同時当選時の<br>次ゲームレバーオン</td>\n                            <td>約5%</td>\n                            <td>約5%</td>\n                        </tr>\n                    </tbody>\n                </table>\n                <div class=\"memo\">\n                    <p> MEMO</p>\n                    <p>101G以降はハナハナ目の出現率が約2倍にアップします。</p>\n                </div>\n            </section>\n\n            \n        </div>\n\n        \n        <p class=\"js-menu2\">ロングフリーズ</p>\n        <div class=\"contents2\">\n            <section>\n                <h3 data-date2=\"\">ライブフリーズ</h3>\n                <img decoding=\"async\" src=\"\">\n                <table border=\"1\">\n                    <tbody>\n                        <tr>\n                            <th style=\"width: 50%;\">項目</th>\n                            <th>内容</th>\n                        </tr>\n                        <tr>\n                            <td rowspan=\"2\">発生契機</td>\n                            <td>1G連ビッグの約7/8</td>\n                        </tr>\n                        <tr>\n                            <td>BIG当選時の1/256</td>\n                        </tr>\n                        <tr>\n                            <td>恩恵</td>\n                            <td>ビッグボーナス</td>\n                        </tr>\n                    </tbody>\n                </table>\n                <p>ライブフリーズが発生するとビッグボーナス当選となります。</p>\n                <p>フリーズには「ピンク7ver.」「白7ver.」の2種類が用意されています。</p>\n                <p>(ビッグボーナスについて)</p>\n            </section>\n\n            \n        </div>\n    </div>\n\n\n\n    <p class=\"js-menu\">ボーナス</p>\n    <div class=\"contents\">\n        <p class=\"js-menu2\" id=\"destination6\">ビッグボーナス</p>\n        <div class=\"contents2\">\n            <section>\n                <h3 data-date2=\"\">概要</h3>\n                <table border=\"1\">\n                    <tbody>\n                        <tr>\n                            <th style=\"width: 50%;\">項目</th>\n                            <th>内容</th>\n                        </tr>\n                        <tr>\n                            <td>図柄</td>\n                            <td>ピンク7揃い<br>白7揃い</td>\n                        </tr>\n                        <tr>\n                            <td>獲得枚数</td>\n                            <td>最大240枚</td>\n                        </tr>\n                    </tbody>\n                </table>\n                <p>ボーナス中は基本的にフリー打ちで消化することができます。</p>\n                <p>リール左右のランプが赤や緑に点灯した際は、通常時と同じ打ち方でチェリーとスイカをフォローしましょう。</p>\n                <p>(ボーナス中の打ち方について)</p>\n\n                <h4 id=\"destination12\">スイカ出現率</h4>\n                <p>ビッグボーナス中にスイカが多く出るほど、高設定への期待が高まる模様です。</p>\n                \n                <h4>ボーナス終了時</h4>\n                <p>ボーナスが終わると筐体上部のフェザーランプが光り、その色で設定を示唆してくれます。</p>\n                <p>(ボーナス終了後のフェザーランプについて)</p>\n            </section>\n\n            \n        </div>\n\n\n        <p class=\"js-menu2\" id=\"destination7\">レギュラーボーナス</p>\n        <div class=\"contents2\">\n            <section>\n                <h3 data-date2=\"\">概要</h3>\n                <table border=\"1\">\n                    <tbody>\n                        <tr>\n                            <th style=\"width: 50%;\">項目</th>\n                            <th>内容</th>\n                        </tr>\n                        <tr>\n                            <td>図柄</td>\n                            <td>ピンク7・ピンク7・BAR<br>白7・白7・BAR</td>\n                        </tr>\n                        <tr>\n                            <td>獲得枚数</td>\n                            <td>最大96枚</td>\n                        </tr>\n                    </tbody>\n                </table>\n                <p>消化中は左リール中段に白7を一度だけビタ押しして、スイカをフォローしていきましょう。</p>\n                <p>(ボーナス中の打ち方について)</p>\n\n                <h4>スイカ入賞時のサイドランプ</h4>\n                <p>スイカ入賞のタイミングでリール左右のランプが光り、色によって設定を示唆します。</p>\n                <p>(REG中のサイドランプについて)</p>\n\n                <h4>ボーナス終了時</h4>\n                <p>ボーナス終了時には筐体上部のフェザーランプが点灯し、色で設定を示唆します。</p>\n                <p>(ボーナス終了後のフェザーランプについて)</p>\n            </section>\n\n            \n        </div>\n    </div>\n\n\n\n    <p class=\"js-menu\">設定示唆演出</p>\n    <div class=\"contents\">\n        <p class=\"js-menu2\" id=\"destination8\">REG中のサイドランプ</p>\n        <div class=\"contents2\">\n            <section>\n                <h3 id=\"\">概要</h3>\n                <img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2024/12/starhana__12.jpg\" loading=\"lazy\">\n                <p>REG中にスイカが揃うと、リール左右のランプが点灯します。</p>\n                <p>点灯色によって設定を示唆しています。</p>\n                <table border=\"1\">\n                    <tbody>\n                        <tr>\n                            <th style=\"width:50%;\">ランプ色</th>\n                            <th>示唆内容</th>\n                        </tr>\n                        <tr>\n                            <td>青</td>\n                            <td>奇数設定示唆</td>\n                        </tr>\n                        <tr>\n                            <td>黄</td>\n                            <td>偶数設定示唆</td>\n                        </tr>\n                        <tr>\n                            <td>緑</td>\n                            <td>奇数設定示唆</td>\n                        </tr>\n                        <tr>\n                            <td>赤</td>\n                            <td>偶数設定示唆</td>\n                        </tr>\n                        <tr>\n                            <td>虹</td>\n                            <td>高設定示唆</td>\n                        </tr>\n                    </tbody>\n                </table>\n            </section>\n\n            \n        </div>\n\n\n        <p class=\"js-menu2\" id=\"destination9\">ボーナス終了後のフェザーランプ</p>\n        <div class=\"contents2\">\n            <section>\n                <h3 id=\"\">概要</h3>\n                <p>ボーナスが終わったあとは筐体上部のフェザーランプが灯り、ランプの色で設定を示唆してくれます。</p>\n                <p>設定変更後の1回目のBIG終了後に限っては、設定示唆が行われません。</p>\n\n                <table border=\"1\">\n                    <caption>ビッグボーナス中</caption>\n                    <tbody>\n                        <tr>\n                            <th style=\"width:50%;\">ランプ色</th>\n                            <th>高設定期待度</th>\n                        </tr>\n                        <tr>\n                            <td><img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2024/12/starhana__13.jpg\" loading=\"lazy\">\n                            <p>白</p>\n                            </td>\n                            <td>デフォルト</td>\n                        </tr>\n                        <tr>\n                            <td><img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2024/12/starhana__14.jpg\" loading=\"lazy\">\n                            <p>青</p>\n                            </td>\n                            <td>低</td>\n                        </tr>\n                        <tr>\n                            <td><img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2024/12/starhana__15.jpg\" loading=\"lazy\">\n                            <p>黄</p>\n                            </td>\n                            <td>↓</td>\n                        </tr>\n                        <tr>\n                            <td><img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2024/12/starhana__16.jpg\" loading=\"lazy\">\n                            <p>緑</p>\n                            </td>\n                            <td>↓</td>\n                        </tr>\n                        <tr>\n                            <td><img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2024/12/starhana__17.jpg\" loading=\"lazy\">\n                            <p>赤</p>\n                            </td>\n                            <td>↓</td>\n                        </tr>\n                        <tr>\n                            <td><img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2024/12/starhana__18.jpg\" loading=\"lazy\">\n                            <p>虹</p>\n                            </td>\n                            <td>高</td>\n                        </tr>\n                    </tbody>\n                </table>\n\n                <table border=\"1\">\n                    <caption>レギュラーボーナス中</caption>\n                    <tbody>\n                        <tr>\n                            <th style=\"width:50%;\">ランプ色</th>\n                            <th>設定示唆内容</th>\n                        </tr>\n                        <tr>\n                            <td><img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2024/12/starhana__13.jpg\" loading=\"lazy\">\n                            <p>白</p>\n                            </td>\n                            <td>デフォルト</td>\n                        </tr>\n                        <tr>\n                            <td><img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2024/12/starhana__14.jpg\" loading=\"lazy\">\n                            <p>青</p>\n                            </td>\n                            <td>設定2以上濃厚！？</td>\n                        </tr>\n                        <tr>\n                            <td><img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2024/12/starhana__15.jpg\" loading=\"lazy\">\n                            <p>黄</p>\n                            </td>\n                            <td>設定3以上濃厚！？</td>\n                        </tr>\n                        <tr>\n                            <td><img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2024/12/starhana__16.jpg\" loading=\"lazy\">\n                            <p>緑</p>\n                            </td>\n                            <td>設定4以上濃厚！？</td>\n                        </tr>\n                        <tr>\n                            <td><img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2024/12/starhana__17.jpg\" loading=\"lazy\">\n                            <p>赤</p>\n                            </td>\n                            <td>設定5以上濃厚！？</td>\n                        </tr>\n                        <tr>\n                            <td><img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2024/12/starhana__18.jpg\" loading=\"lazy\">\n                            <p>虹</p>\n                            </td>\n                            <td>設定6濃厚！？</td>\n                        </tr>\n                    </tbody>\n                </table>\n\n            </section>\n\n            \n        </div>\n    </div>\n\n\n    \n\n\n    <p class=\"js-menu\">その他の演出</p>\n    <div class=\"contents\">\n        <p class=\"js-menu2\">プレミアム演出</p>\n        <div class=\"contents2\">\n            <section>\n                <h3 data-date2=\"\">概要</h3>\n                <p>次に挙げるプレミアム演出が起きると、ビッグボーナス当選が濃厚になります。</p>\n                <table border=\"1\">\n                    <tbody>\n                        <tr>\n                            <th style=\"width:40%;\">パターン</th>\n                            <th>特徴</th>\n                        </tr>\n                        <tr>\n                            <td>プレミアム点滅</td>\n                            <td>デフォルト以外のハイビスカス<br>点滅パターンが出現</td>\n                        </tr>\n                        <tr>\n                            <td>アメイジング<br>チャンス</td>\n                            <td>BETボタンが緑色に変化</td>\n                        </tr>\n                        <tr>\n                            <td>サウンド系</td>\n                            <td>普段と異なるサウンドが発生</td>\n                        </tr>\n                        <tr>\n                            <td>ランプ系</td>\n                            <td>カラー照明や<br>バックライトフラッシュが発生</td>\n                        </tr>\n                        <tr>\n                            <td>真プレミアム<br>バイブレーション</td>\n                            <td>レバーオン時に筐体が激振動</td>\n                        </tr>\n                        <tr>\n                            <td>ライブフリーズ</td>\n                            <td>至極のステージが展開</td>\n                        </tr>\n                    </tbody>\n                </table>\n\n                <h4>プレミアム点滅詳細(一例)</h4>\n                <table border=\"1\">\n                    <tbody>\n                        <tr>\n                            <th colspan=\"2\">ハイビスカス点滅パターン</th>\n                        </tr>\n                        <tr>\n                            <td style=\"width:50%;\" class=\"bg-white\">高速点滅</td>\n                            <td>三三四拍子</td>\n                        </tr>\n                        <tr>\n                            <td class=\"bg-white\">メラメラ点滅</td>\n                            <td>三三七拍子</td>\n                        </tr>\n                        <tr>\n                            <td class=\"bg-white\">フワフワ点滅</td>\n                            <td>点灯</td>\n                        </tr>\n                        <tr>\n                            <td class=\"bg-white\">葉っぱだけ点滅</td>\n                            <td>点灯回転</td>\n                        </tr>\n                        <tr>\n                            <td class=\"bg-white\">花びらのみ点滅</td>\n                            <td>ステップアップ</td>\n                        </tr>\n                        <tr>\n                            <td class=\"bg-white\">めしべ点滅</td>\n                            <td>ねずみ花火点滅</td>\n                        </tr>\n                        <tr>\n                            <td class=\"bg-white\">カラフル点滅</td>\n                            <td>キャッチボール点滅</td>\n                        </tr>\n                        <tr>\n                            <td class=\"bg-white\">ゆっくり点滅</td>\n                            <td>UFO点滅</td>\n                        </tr>\n                        <tr>\n                            <td class=\"bg-white\">青点滅</td>\n                            <td>十字点滅</td>\n                        </tr>\n                    </tbody>\n                </table>\n            </section>\n\n            \n        </div>\n\n\n        <p class=\"js-menu2\">ボーナス中の演出</p>\n        <div class=\"contents2\">\n            <section>\n                <h3>ボーナス中の搭載楽曲</h3>\n                <ul>\n                    <li>ノーマルサウンド4曲<br>⇒新曲あり</li>\n                    <li>ボーナス連続時のサウンド4曲<br>⇒初代＆スーハナのボーナスサウンドあり</li>\n                    <li>ボーナス大連続時のサウンド4曲<br>⇒初代＆スーハナの新アレンジver.が発生</li>\n                    <li>フリーズ時サウンド4曲</li>\n                    <li>レトロサウンド4曲<br>⇒初代＆スーハナFM音源レトロver.が発生</li>\n                </ul>\n            </section>\n\n            \n        </div>\n    </div>\n</div>","shukei":""}