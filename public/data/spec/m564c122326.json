{"spec":"<div id=\"post\">\n    <div class=\"tab\">\n        \n        <h1 class=\"setting\">設定狙い：設定判別</h1>\n       \n        <p class=\"js-menu\" style=\"display: none;\">まずはココを見ろ！</p>\n        <div class=\"contents\">\n            <div class=\"left\">\n                <h5>①</h5>\n                \n            </div>\n\n            <button class=\"close\">ー閉じる</button>\n        </div>\n\n        <p class=\"js-menu\">設定判別項目</p>\n        <div class=\"contents\">\n            <div>\n                <table border=\"1\">\n                    <caption>確定演出</caption>\n                    <tbody>\n                        <tr>\n                            <th style=\"width: 73%;\">項目</th>\n                            <th>重要度</th>\n                        </tr>\n                        <tr>\n                            <td><img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2022/12/下向きの矢印のアイコン素材.png\" class=\"icon-small\" alt=\"arrow\" loading=\"lazy\">休憩室ステージのエリア座標</td>\n                            <td>★★☆☆☆</td>\n                        </tr>\n                        <tr>\n                            <td><img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2022/12/下向きの矢印のアイコン素材.png\" class=\"icon-small\" alt=\"arrow\" loading=\"lazy\">AT終了画面</td>\n                            <td>★★★☆☆</td>\n                        </tr>\n                        <tr>\n                            <td><img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2022/12/下向きの矢印のアイコン素材.png\" class=\"icon-small\" alt=\"arrow\" loading=\"lazy\">玉ちゃんトロフィー</td>\n                            <td>★★★☆☆</td>\n                        </tr>\n                    </tbody>\n                </table>\n                \n                <table border=\"1\">\n                    <caption>通常時</caption>\n                    <tbody>\n                        <tr>\n                            <th style=\"width: 73%;\">項目</th>\n                            <th>重要度</th>\n                        </tr>\n                        <tr>\n                            <td><img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2023/10/new-7.png\" alt=\"new\" class=\"update-icon\" data-date=\"2024-01-10\" loading=\"lazy\">\n                                <img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2022/12/下向きの矢印のアイコン素材.png\" class=\"icon-small\" alt=\"arrow\" loading=\"lazy\">共通ベル確率</td>\n                            <td>☆☆☆☆☆</td>\n                        </tr>\n                        <tr>\n                            <td><img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2023/10/new-7.png\" alt=\"new\" class=\"update-icon\" data-date=\"2024-01-22\" loading=\"lazy\">\n                                <img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2022/12/下向きの矢印のアイコン素材.png\" class=\"icon-small\" alt=\"arrow\" loading=\"lazy\">ゆいたいむ当選確率</td>\n                            <td>★☆☆☆☆</td>\n                        </tr>\n                        <tr>\n                            <td><img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2022/12/下向きの矢印のアイコン素材.png\" class=\"icon-small\" alt=\"arrow\" loading=\"lazy\">周期ごとのAT当選期待度</td>\n                            <td>☆☆☆☆☆</td>\n                        </tr>\n                    </tbody>\n                </table>\n                \n        \n            </div>\n\n            <button class=\"close\">ー閉じる</button>\n        </div>\n\n        <p class=\"js-menu\" style=\"display: none;\">ざっくり設定判別</p>\n        <div class=\"contents\" style=\"display: none;\">\n            <div class=\"left\">\n                <img decoding=\"async\" src=\"https://media.slolaboratory.com/wp-content/uploads/2026/04/24005602/noimage1.jpg\" loading=\"lazy\">\n            </div>\n            <button class=\"close\">ー閉じる</button>\n        </div>\n        \n        <p class=\"js-menu\" style=\"display: none;\">ツモった際のやめ時</p>\n        <div class=\"contents\">\n            <div class=\"left\">\n                <h3>大まかな目安</h3>\n                <h4>やめ推奨時間</h4>\n                <p><img decoding=\"async\" src=\"https://media.slolaboratory.com/wp-content/uploads/2026/04/24005602/noimage1.jpg\" loading=\"lazy\"></p>\n                <h4>閉店欠損度</h4>\n                <p>☆☆☆☆☆</p>\n            </div>\n\n            <div class=\"left\">\n                <h3>解説</h3>\n                <p>現在調査中です。</p>\n            </div>\n\n            <button class=\"close\">ー閉じる</button>\n        </div>\n\n        <p class=\"js-menu\">スペック</p>\n        <div class=\"contents\">\n            <div class=\"left\">\n                <h3>AT確率</h3>\n                <table border=\"1\">\n                    <tbody>\n                        <tr>\n                            <th style=\"width:40%;\">設定</th>\n                            <th>AT確率</th>\n                        </tr>\n                        <tr>\n                            <td>設定0</td>\n                            <td>－</td>\n                        </tr>\n                        <tr>\n                            <td>設定1</td>\n                            <td>1/297.7</td>\n                        </tr>\n                        <tr>\n                            <td>設定2</td>\n                            <td>1/291.4</td>\n                        </tr>\n                        <tr>\n                            <td>設定4</td>\n                            <td>1/253.2</td>\n                        </tr>\n                        <tr>\n                            <td>設定5</td>\n                            <td>1/233.6</td>\n                        </tr>\n                        <tr>\n                            <td>設定6</td>\n                            <td>1/225.2</td>\n                        </tr>\n                    </tbody>\n                </table>\n            </div>\n\n            <div class=\"left\">\n                <h3>出玉率</h3>\n               