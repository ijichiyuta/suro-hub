td>\n                            <td>高設定示唆</td>\n                        </tr>\n                        <tr>\n                            <td>マリ</td>\n                            <td>設定2・4否定</td>\n                        </tr>\n                        <tr>\n                            <td>ボイス非発生</td>\n                            <td>設定2以上濃厚</td>\n                        </tr>\n                        <tr>\n                            <td>加持</td>\n                            <td style=\"color:#0071C1;\">設定4以上濃厚</td>\n                        </tr>\n                        <tr>\n                            <td>カヲル</td>\n                            <td style=\"color:#FE67FF;\">設定6濃厚</td>\n                        </tr>\n                    </tbody>\n                </table>\n\n                <table border=\"1\">\n                    <caption>セリフ内容</caption>\n                    <tbody>\n                        <tr>\n                            <th style=\"width:20%;\">キャラ</th>\n                            <th>内容</th>\n                        </tr>\n                            <tr>\n                                <td>シンジ</td>\n                                <td>僕は、エヴァンゲリオン初号機パイロット、碇シンジです</td>\n                            </tr>\n                            <tr>\n                                <td>ミサト</td>\n                                <td>奇跡を待つより捨て身の努力よ</td>\n                            </tr>\n                            <tr>\n                                <td>レイ</td>\n                                <td>私が死んでも変わりはいるもの</td>\n                            </tr>\n                            <tr>\n                                <td>アスカ</td>\n                                <td>そっか。私、笑えるんだ</td>\n                            </tr>\n                            <tr>\n                                <td>マリ</td>\n                                <td>自分の目的に大人を巻き込むのは気後れするな</td>\n                            </tr>\n                            <tr>\n                               