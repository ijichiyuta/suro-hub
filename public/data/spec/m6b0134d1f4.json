azy\">\n                                <img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2022/12/下向きの矢印のアイコン素材.png\" class=\"icon-small\" alt=\"arrow\" loading=\"lazy\">ブルーセブンモード移行率</td>\n                            <td>★☆☆☆☆</td>\n                        </tr>\n                        <tr>\n                            <td><img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2023/10/new-7.png\" alt=\"new\" class=\"update-icon\" data-date=\"2024-07-30\" loading=\"lazy\">\n                                <img decoding=\"async\" src=\"https://slolaboratory.com/wp-content/uploads/2022/12/下向きの矢印のアイコン素材.png\" class=\"icon-small\" alt=\"arrow\" loading=\"lazy\">宿命BREAKストック抽選</td>\n                            <td>★★☆☆☆</td>\n                        </tr>\n                    </tbody>\n                </table>\n                \n            </div>\n\n            <button class=\"close\">ー閉じる</button>\n        </div>\n\n\n        <p class=\"js-menu\" style=\"display: none;\">ざっくり設定判別</p>\n        <div class=\"contents\" style=\"display: none;\">\n            <div class=\"left\">\n                <img decoding=\"async\" src=\"https://media.slolaboratory.com/wp-content/uploads/2026/04/24005602/noimage1.jpg\" loading=\"lazy\">\n            </div>\n            <button class=\"close\">ー閉じる</button>\n        </div>\n\n\n        <p class=\"js-menu\" style=\"display: none;\">ツモった際のやめ時</p>\n        <div class=\"contents\" style=\"display: none;\">\n            <div class=\"left\">\n                <h3>大まかな目安</h3>\n                <h4>やめ推奨時間</h4>\n                <p><img decoding=\"async\" src=\"https://media.slolaboratory.com/wp-content/uploads/2026/04/24005602/noimage1.jpg\" loading=\"lazy\"></p>\n                <h4>閉店欠損度</h4>\n                <p>☆☆☆☆☆</p>\n            </div>\n\n            <div class=\"left\">\n                <h3>解説</h3>\n                <p>現在調査中です。</p>\n            </div>\n\n            <button class=\"close\">ー閉じる</